          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(poweradmin_zones{job=~\"$job\", instance=~\"$instance\"}) - sum(poweradmin_zones_dnssec_signed{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "unsigned",
