parameters:
	ignoreErrors:
		-
			message: '#^Offset ''Administrators''\|''Editors''\|''Guests''\|''Viewers''\|''Zone Managers'' on array\{Administrators\: string\|false, ''Zone Managers''\: string\|false, Editors\: string\|false, Viewers\: string\|false, Guests\: string\|false\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 2
			path: install/helpers/DatabaseHelper.php

		-
			message: '#^Negated boolean expression is always true\.$#'
			identifier: booleanNot.alwaysTrue
			count: 1
			path: lib/Application/Controller/AddRecordController.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: lib/Application/Controller/Api/V2/GroupsController.php

		-
			message: '#^Offset ''kind'' on array\{kind\: string, content\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: lib/Application/Controller/Api/V2/ZoneMetadataController.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: lib/Application/Controller/Api/V2/ZoneMetadataController.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: lib/Application/Controller/DnssecDeleteKeyController.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 2
			path: lib/Application/Controller/SaveZoneAsTemplateController.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: lib/Application/Controller/ZoneOwnershipController.php

		-
			message: '#^Strict comparison using \!\=\= between string and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: lib/Application/Controller/ZoneOwnershipController.php

		-
			message: '#^Offset ''timestamp'' on array\{message\: string, context\: non\-empty\-array, timestamp\: int\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: lib/Application/Service/ZoneSyncService.php

		-
			message: '#^Right side of && is always false\.$#'
			identifier: booleanAnd.rightAlwaysFalse
			count: 1
			path: lib/Application/Service/ZoneSyncService.php

		-
			message: '#^Call to function is_int\(\) with int\<min, \-1\>\|int\<1, max\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: lib/Domain/Service/BatchReverseRecordCreator.php

		-
			message: '#^Ternary operator condition is always false\.$#'
			identifier: ternary.alwaysFalse
			count: 1
			path: lib/Domain/Service/DatabaseConsistencyService.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 2
			path: lib/Domain/Service/DnsValidation/APLRecordValidator.php

		-
			message: '#^Strict comparison using \!\=\= between non\-falsy\-string and '''' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: lib/Domain/Service/DnsValidation/CAARecordValidator.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 1
			path: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 1
			path: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php

		-
			message: '#^Offset int\<0, 3\> on array\{''refresh'', ''retry'', ''expire'', ''minimum''\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: lib/Domain/Service/DnsValidation/SOARecordValidator.php

		-
			message: '#^Result of \|\| is always true\.$#'
			identifier: booleanOr.alwaysTrue
			count: 1
			path: lib/Domain/Service/DnsValidation/SRVRecordValidator.php

		-
			message: '#^Strict comparison using \!\=\= between int\<1, 65535\> and 0 will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: lib/Domain/Service/DnsValidation/SRVRecordValidator.php

		-
			message: '#^Strict comparison using \=\=\= between ''gss\-tsig\.''\|''hmac\-sha1\.''\|''hmac\-sha224\.''\|''hmac\-sha256\.''\|''hmac\-sha384\.''\|''hmac\-sha512\.'' and ''hmac\-md5\.'' will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php

		-
			message: '#^Left side of \|\| is always false\.$#'
			identifier: booleanOr.leftAlwaysFalse
			count: 2
			path: lib/Domain/Service/DynamicDnsUpdateService.php

		-
			message: '#^Call to function method_exists\(\) with Poweradmin\\Application\\Service\\MailService and ''isMailConfiguration…'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: lib/Domain/Service/MfaService.php

		-
			message: '#^Comparison operation "\<" between int\<1, max\> and 1 is always false\.$#'
			identifier: smaller.alwaysFalse
			count: 1
			path: lib/Domain/Utility/IpHelper.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: lib/Infrastructure/Configuration/ConfigValidator.php

		-
			message: '#^Call to function is_array\(\) with array\{kind\?\: string, content\?\: string\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: lib/Infrastructure/Logger/RecordChangeLogger.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: lib/Infrastructure/Logger/RecordChangeLogger.php

		-
			message: '#^Strict comparison using \!\=\= between numeric\-string and '''' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: lib/Infrastructure/Network/ProxyContext.php

		-
			message: '#^Call to function is_int\(\) with int will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: lib/Infrastructure/Repository/DbZoneRepository.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: lib/Infrastructure/Repository/DbZoneRepository.php

		-
			message: '#^Strict comparison using \=\=\= between mixed and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: lib/Infrastructure/Service/ApiDnsBackendProvider.php

		-
			message: '#^Right side of && is always false\.$#'
			identifier: booleanAnd.rightAlwaysFalse
			count: 1
			path: lib/Infrastructure/Service/SqlDnsBackendProvider.php

		-
			message: '#^Offset 0 on non\-empty\-list\<string\> in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 2
			path: lib/Infrastructure/Utility/ReverseDomainHierarchySorting.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: lib/Module/DnsWizard/Controller/DnsWizardFormController.php

		-
			message: '#^Instanceof between Poweradmin\\Module\\ModuleInterface and Poweradmin\\Module\\ModuleInterface will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: lib/Module/ModuleRegistry.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: tests/integration/NaturalSortingIntegrationTest.php
