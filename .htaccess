# Poweradmin URL Rewriting Rules

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Subfolder Deployment Support
    # For root folder deployment (default): Leave commented or set to /
    # For subfolder deployment: Uncomment and set to your subfolder path
    # Example: RewriteBase /poweradmin
    # RewriteBase /

    # Ensure HTTP Authorization header is forwarded
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Any dot segment (.git/, .env) except .well-known/ for ACME challenges: the existing-file
    # rule below would serve a cloned repository
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Deny sensitive directories first: the existing-file rule below would otherwise
    # serve real files such as config/settings.php.bak. Bootstrap assets stay allowed;
    # the path is matched relative to this directory so subfolder installs work too.
    RewriteRule ^vendor/twbs/(bootstrap/dist|bootstrap-icons/font)/ - [L]
    RewriteRule ^(config|lib|tests|vendor|bin|var)/ - [F,L]

    # Disable rewriting for existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # CORS preflight for the API is answered here; the web UI keeps its own OPTIONS handling
    RewriteCond %{REQUEST_METHOD} =OPTIONS
    RewriteRule ^api(/|$) - [R=204,L]

    # dyndns2 path used by stock dynamic DNS clients
    RewriteRule ^nic/update$ dynamic_update.php [QSA,L]

    # Single catch-all rule - let Symfony Router handle all routing
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Protect the .htaccess file
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# Prevent directory listing
Options -Indexes

# Set default character set
AddDefaultCharset UTF-8

# Security: Allow access to Bootstrap CSS/JS and Bootstrap Icons
<Files ~ "^vendor/twbs/(bootstrap/dist|bootstrap-icons/font)/.*\.(css|js|woff|woff2|ttf|eot|svg)$">
    Order Allow,Deny
    Allow from all
</Files>

# Security: Deny access to hidden files and directories
<Files ~ "^\..*">
    Order Allow,Deny
    Deny from all
</Files>

# Security: Deny access to sensitive file types
<Files ~ "\.(sql|sqlite|sqlite3|db|md|log|yaml|yml|lock|json|dist|xml|neon)$|\.(sqlite|sqlite3|db)-(wal|shm)$">
    Order Allow,Deny
    Deny from all
</Files>

# Enable CORS for API endpoints; "always" so the 204 preflight carries the headers too
<IfModule mod_headers.c>
    SetEnvIf Request_URI "/api(/|$)" CORS=true
    Header always set Access-Control-Allow-Origin "*" env=CORS
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" env=CORS
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key" env=CORS
    Header always set Access-Control-Max-Age "3600" env=CORS
    # The internal rewrite to index.php renames the variable
    Header always set Access-Control-Allow-Origin "*" env=REDIRECT_CORS
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" env=REDIRECT_CORS
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key" env=REDIRECT_CORS
    Header always set Access-Control-Max-Age "3600" env=REDIRECT_CORS
</IfModule>
