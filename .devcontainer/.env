DB_USER=pdns
DB_PASSWORD=poweradmin
DB_NAME=pdns
DB_ROOT_PASSWORD=uberuser

MYSQL_IMAGE=mariadb
#MYSQL_IMAGE=mysql
#MYSQL_IMAGE=percona/percona-server

# MySQL
#MYSQL_VERSION=9.1
#MYSQL_VERSION=8.4
#MYSQL_VERSION=8.0

# MariaDB
MYSQL_VERSION=10.11
#MYSQL_VERSION=11.4

# Percona Server
#MYSQL_VERSION=5.7
#MYSQL_VERSION=8.0

# PostgreSQL
PGSQL_IMAGE=postgres
#PGSQL_VERSION=13
#PGSQL_VERSION=14
#PGSQL_VERSION=15
PGSQL_VERSION=16.11
#PGSQL_VERSION=17

# One PHP version per database family, so a single E2E sweep covers the whole 8.2-8.5 matrix.
# MySQL stays on the floor (the devcontainer service and the main E2E target), PostgreSQL
# matches the production image, the German-only instance runs the newest release.
PHP_VERSION_MYSQL=8.2
PHP_VERSION_SQLITE=8.3
PHP_VERSION_PGSQL=8.4
PHP_VERSION_DE=8.5

#DEBIAN_VERSION=bookworm
DEBIAN_VERSION=bookworm
#DEBIAN_VERSION=buster

#PDNS_BRANCH=45
#PDNS_VERSION=4.5.5

#PDNS_BRANCH=46
#PDNS_VERSION=4.6.4

#PDNS_BRANCH=47
#PDNS_VERSION=4.7.5

#PDNS_BRANCH=48
#PDNS_VERSION=4.8.5

#PDNS_BRANCH=49
#PDNS_VERSION=4.9.12

#PDNS_BRANCH=50
#PDNS_VERSION=5.0.7

# Views and network mappings need 5.0+; HHIT/BRID record types need 5.1.
PDNS_BRANCH=51
PDNS_VERSION=5.1.4

#PDNS_BRANCH=master
#PDNS_VERSION=latest
