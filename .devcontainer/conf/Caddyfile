:80 {
    # Set the root directory
    root * /app

    # Enable access logs
    log {
        output stdout
        format console
        level INFO
    }

    # Security: Deny access to sensitive directories
    @denied path /config* /lib* /tests* /vendor*
    @bootstrap path /vendor/twbs/bootstrap/dist/* /vendor/twbs/bootstrap-icons/font/*

    # Allow Bootstrap files (override general vendor blocking); versioned by the vendor path
    handle @bootstrap {
        header Cache-Control "public, max-age=604800"
        file_server
    }

    # Block sensitive directories (excluding bootstrap)
    handle @denied {
        respond "Forbidden" 403
    }

    # Security: Deny access to hidden files and sensitive file types
    @hidden path /.* */.* *.sh *.sql *.sqlite *.sqlite3 *.db *.md *.log *.yaml *.yml *.po *.pot *.dat *.example
    handle @hidden {
        respond "Forbidden" 403
    }

    # Scripts and styles carry a content fingerprint in their URL, fonts never change;
    # icons and images are not versioned, so they get a day
    @versioned path *.js *.css *.woff *.woff2 *.ttf *.eot
    handle @versioned {
        header Cache-Control "public, max-age=31536000"
        file_server
    }
    @images path *.png *.jpg *.jpeg *.gif *.ico *.svg
    handle @images {
        header Cache-Control "public, max-age=86400"
        file_server
    }

    # API endpoints with CORS; preflight is answered here only, never for the web UI
    @api path /api*
    handle @api {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key"
        header Access-Control-Max-Age "3600"

        @options method OPTIONS
        handle @options {
            respond "" 204
        }

        # Forward all API requests to index.php with proper query handling
        rewrite * /index.php{uri}
        php_fastcgi app-sqlite:9000 {
            read_timeout 180s
            env HTTP_AUTHORIZATION {http.request.header.Authorization}
        }
    }

    # Handle all other requests - Clean URL routing
    # Let Symfony Router handle all routing through index.php
    try_files {path} {path}/ /index.php{uri}
    php_fastcgi app-sqlite:9000 {
        read_timeout 180s
        env HTTP_AUTHORIZATION {http.request.header.Authorization}
    }

    # Enable file server for static content
    file_server
}