# Web server authentication (REMOTE_USER) front: nginx asks for a password and hands the
# signed-in user to PHP. Users and passwords are in conf/htpasswd-remote-user.
server {
    listen 80 default_server;
    # Re-resolve the fpm container on each request instead of caching its IP at startup
    resolver 127.0.0.11 valid=10s ipv6=off;
    # Directory redirects (/install -> /install/) must keep the host port the browser used
    absolute_redirect off;
    root /app;
    index index.php index.html;

    auth_basic "Poweradmin";
    auth_basic_user_file /etc/nginx/htpasswd-remote-user;

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires max;
        log_not_found off;
        access_log off;
    }

    # API v2 authenticates with its own keys. Matched on the normalised URI, so
    # /api/v2/../index.php does not escape auth_basic. nginx fills $remote_user from
    # any client's Authorization header, so it is blanked where auth_basic is off.
    location ^~ /api/v2/ {
        auth_basic off;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key" always;
        add_header Access-Control-Max-Age "3600" always;
        if ($request_method = 'OPTIONS') {
            return 204;
        }
        set $fpm ${FPM_UPSTREAM};
        fastcgi_pass $fpm;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param REMOTE_USER "";
        fastcgi_read_timeout 180;
    }

    # Health probes stay open for monitors, as on every other instance
    location ~ ^/(ping|api/health)$ {
        auth_basic off;
        set $fpm ${FPM_UPSTREAM};
        fastcgi_pass $fpm;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param REMOTE_USER "";
        fastcgi_read_timeout 180;
    }

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        set $fpm ${FPM_UPSTREAM};
        fastcgi_pass $fpm;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 180;
        include fastcgi_params;
        fastcgi_param REMOTE_USER $remote_user;
    }

    error_log /var/log/nginx/error.log notice;
    access_log /var/log/nginx/access.log;
}
