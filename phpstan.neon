includes:
  # Grandfathered layering violations (superglobals, the config singleton, Twig in
  # Domain). Regenerate with --generate-baseline after removing one; never add to it.
  - phpstan-baseline.neon
  - vendor/phpstan/phpstan-deprecation-rules/rules.neon
  - vendor/spaze/phpstan-disallowed-calls/extension.neon

parameters:
  # Pinned so CI can persist the result cache between runs; PHPStan
  # invalidates entries itself by file/config/version hash.
  tmpDir: .phpstan-cache
  excludePaths:
    - vendor
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    # Ignore errors in test files related to mocking
    -
      message: '#Call to an undefined method .+::expects\(\).#'
      path: tests/*
    # Ignore constructor unused parameter errors
    - '#Constructor of class .+ has an unused parameter \$_?config.#'
    # php-saml annotates processSLO() as never-returning when $stay is false, but
    # its SAMLResponse branch falls through and returns - which is exactly the path
    # that records the logout errors read on the next line.
    -
      identifier: deadCode.unreachable
      path: lib/Application/Service/SamlService.php
    # LdapAuthenticator writes its cache keys into $_SESSION from a private method
    # the test reaches by reflection, so PHPStan still sees them as unset from the
    # test's own unset() and reports every later read as a missing offset.
    -
      identifier: offsetAccess.notFound
      path: tests/unit/Application/Service/LdapAuthenticatorCacheTest.php
    # PHPStan treats a repeated identical call as pure and reuses the first
    # result's narrowing, so every "did the mutation take effect?" check below
    # looks dead. The state genuinely changed in between and removing any of
    # these would drop a verification or, worse, a rollback. Each is scoped to
    # its file for want of a narrower hook.
    #   EditController      - isZoneSecured() after secureZone()/unsecureZone()
    -
      identifier: if.alwaysFalse
      path: lib/Application/Controller/Zone/EditController.php
    -
      identifier: booleanNot.alwaysFalse
      path: lib/Application/Controller/Zone/EditController.php
    #   DnssecDeleteKeyController - keyExists() after removeZoneKey()
    -
      identifier: booleanAnd.rightAlwaysTrue
      path: lib/Application/Controller/Dnssec/DnssecDeleteKeyController.php
    #   SqlDnsBackendProvider, ZoneSyncService - inTransaction() in the catch,
    #   narrowed from the call made before beginTransaction(). Deleting either
    #   skips the rollback.
    -
      identifier: booleanAnd.rightAlwaysFalse
      path: lib/Infrastructure/Service/SqlDnsBackendProvider.php
    -
      identifier: booleanAnd.rightAlwaysFalse
      path: lib/Infrastructure/Service/ZoneSyncService.php
    # processIPv6() is kept alongside its commented-out call site until IPv6
    # reverse-record creation is finished; see the FIXME above that call.
    -
      identifier: method.unused
      path: lib/Domain/Service/Dns/DomainRecordCreator.php
    # Defensive checks PHPStan can prove redundant today, kept on purpose.
    #   DbZoneRepository - is_int() picks PDO::PARAM_INT vs PARAM_STR in the
    #   bindValue loops. $params happens to be all-int now; hardcoding PARAM_INT
    #   would break the first time a string parameter is added, and MariaDB is
    #   unforgiving about the wrong type on LIMIT/OFFSET.
    -
      identifier: function.alreadyNarrowedType
      path: lib/Infrastructure/Repository/DbZoneRepository.php
    #   ModuleRegistry - instanceof after `new $className()`. The class-string
    #   type is only as good as the registry declaration; this is a real guard.
    -
      identifier: instanceof.alwaysTrue
      path: lib/Application/Module/ModuleRegistry.php
    #   DynamicDnsUpdateService - `$flag = $flag || ...` accumulators, whose left
    #   side is literally false on first use. Rewriting would only obscure it.
    -
      identifier: booleanOr.leftAlwaysFalse
      path: lib/Domain/Service/Dns/DynamicDnsUpdateService.php
    #   RRSIGRecordValidator - DateTime::modify() is typed DateTime by PHPStan but
    #   returns DateTime|false before PHP 8.3, which phan does flag. Dropping the
    #   truthiness check produces a TypeError on the ordering comparison.
    -
      identifier: booleanAnd.leftAlwaysTrue
      path: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php
    # Array shapes asserted by docblock over data that does not have to obey them:
    # session payloads written by an older release, and DB rows. isset()/?? here
    # is protection against the docblock being wrong, which is exactly when it
    # matters. Dropping them turns a skipped row into a deprecation or a warning.
    -
      identifier: isset.offset
      path: lib/Infrastructure/Service/ZoneSyncService.php
    -
      identifier: function.alreadyNarrowedType
      path: lib/Infrastructure/Logger/RecordChangeLogger.php
    -
      identifier: booleanAnd.rightAlwaysTrue
      path: lib/Infrastructure/Logger/RecordChangeLogger.php
    -
      identifier: nullCoalesce.offset
      path: lib/Application/Controller/Api/V2/ZoneMetadataController.php
    # The match arms are deliberately parallel and self-documenting; the second
    # GET arm restates $hasKind that the first arm already excluded.
    -
      identifier: booleanAnd.rightAlwaysTrue
      path: lib/Application/Controller/Api/V2/ZoneMetadataController.php
    # Tests assert types on purpose, so "already narrowed" is expected there.
    -
      identifier: method.alreadyNarrowedType
      path: tests/*
    -
      identifier: function.alreadyNarrowedType
      path: tests/*
  disallowedSuperglobals:
    -
      superglobal: ['$_GET', '$_POST', '$_REQUEST']
      message: 'use Poweradmin\Application\Http\Request instead'
      allowIn:
        # Reading the superglobal is the job of these files.
        - lib/Application/Http/Request.php
        - tests/*
    # Layering. Session state is read by the auth layer and BaseController and
    # handed down; lib/Domain never touches it. Every entry under "not yet
    # migrated" is debt - delete it when the file takes the value as a
    # parameter (docs/ui-business-separation-plan.md, phase 5).
    -
      superglobal: ['$_SESSION']
      message: 'read the session in the auth layer or BaseController and pass the value down (UserContextService for the current user)'
      allowIn:
        # Owning the session is the job of these files.
        - tests/*
        - install/*
        - lib/Infrastructure/*
        - lib/Application/Boot/AppInitializer.php
        - lib/Application/Boot/AppManager.php
        - lib/Application/Controller/BaseController.php
        - lib/Application/Bootstrap.php
        - lib/Application/Service/Auth/*
        - lib/Application/Service/CsrfTokenService.php
        - lib/Application/Service/OidcService.php
        - lib/Application/Service/SamlService.php
        - lib/Application/Service/SqlAuthenticator.php
        - lib/Application/Controller/Auth/LoginController.php
        - lib/Application/Controller/Auth/LogoutController.php
        - lib/Application/Controller/Auth/OidcCallbackController.php
        - lib/Application/Controller/Auth/SamlCallbackController.php
        - lib/Application/Controller/Auth/ForgotPasswordController.php
        - lib/Application/Controller/Auth/ForgotUsernameController.php
        - lib/Application/Controller/Auth/ResetPasswordController.php
    # Controllers pass $_SERVER to IpAddressRetriever; Domain code takes the
    # resolved value instead.
    -
      superglobal: ['$_SERVER', '$_COOKIE']
      message: 'lib/Domain takes request values as parameters; resolve them in the controller'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
  disallowedStaticCalls:
    # Services take ConfigurationInterface; the singleton is for bootstrap.
    -
      method: 'Poweradmin\Infrastructure\Configuration\ConfigurationManager::getInstance()'
      message: 'inject ConfigurationInterface instead of reaching for the singleton'
      allowIn:
        # Bootstrap and entry points.
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Infrastructure/*
        - lib/Application/Boot/AppInitializer.php
        - lib/Application/Boot/AppManager.php
        - lib/Application/Controller/BaseController.php
        - lib/Application/Controller/Api/AbstractApiController.php
        - lib/Application/Controller/Api/HealthController.php
        - lib/Application/Controller/System/PingController.php
  # lib/Domain has no HTTP or template dependency. Same allowIn list for each
  # namespace; the extension takes one namespace per entry.
  disallowedNamespaces:
    -
      namespace: 'Twig\*'
      message: 'lib/Domain must not depend on HTTP or Twig; move the dependency to the caller'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Symfony\Component\HttpFoundation\*'
      message: 'lib/Domain must not depend on HTTP or Twig; move the dependency to the caller'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Web\*'
      message: 'lib/Domain must not depend on HTTP or Twig; move the dependency to the caller'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Application\Http\*'
      message: 'lib/Domain must not depend on HTTP or Twig; move the dependency to the caller'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
  # Layering. lib/Domain reaches Application and Infrastructure only through the
  # interfaces under lib/Domain/Repository and ConfigurationInterface (the concrete
  # manager, validator and theme resolver are listed by name for that reason).
  # Grandfathered files are in phpstan-baseline.neon.
    -
      namespace: 'Poweradmin\Application\*'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Repository\*'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Service\*'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Api\*'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Session\*'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Logger\*'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Database\*'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Utility\*'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Network\*'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Configuration\ConfigurationManager'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Configuration\ConfigValidator'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
    -
      namespace: 'Poweradmin\Infrastructure\Configuration\ThemePathResolver'
      message: 'lib/Domain depends on Application and Infrastructure only through interfaces; inject the dependency or move the code'
      allowIn:
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
  # Driver encodings (0/1 versus 't'/'f') are decoded by the repositories; a
  # controller works with the PHP bools they return.
    -
      namespace: 'Poweradmin\Domain\Database\DbCompat'
      message: 'decode the driver value in the repository and return a PHP bool; controllers do not know the database type'
      allowExceptIn:
        - lib/Application/Controller/*
        - lib/Module/*/Controller/*
  # lib/Domain returns; the caller emits HTTP and owns the session.
  disallowedFunctionCalls:
    -
      function:
        - 'header()'
        - 'http_response_code()'
        - 'setcookie()'
        - 'session_start()'
        - 'session_write_close()'
        - 'session_regenerate_id()'
        - 'session_destroy()'
        - 'exit()'
        - 'die()'
        - 'echo()'
        - 'print()'
      message: 'lib/Domain returns a result; the controller emits output and owns the session'
      allowIn:
        - tests/*
        - addons/*
        - bin/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/*
        - lib/Infrastructure/*
        - lib/Module/*
  # Controllers read and write through repositories and services, never PDO.
  disallowedMethodCalls:
    -
      method:
        - 'PDO::prepare()'
        - 'PDO::query()'
        - 'PDO::exec()'
        - 'PDO::beginTransaction()'
      message: 'controllers go through a repository or service; move the SQL there'
      allowIn:
        # The health probe opens its own connection and pings it.
        - lib/Application/Controller/Api/HealthController.php
        - tests/*
        - addons/*
        - config/*
        - install/*
        - index.php
        - dynamic_update.php
        - lib/Application/Boot/AppInitializer.php
        - lib/Application/Boot/AppManager.php
        - lib/Application/Controller/BaseController.php
        - lib/Application/Boot/LocaleManager.php
        - lib/Pages.php
        - lib/Application/Service/*
        - lib/Application/Helpers/*
        - lib/Application/Http/*
        - lib/Application/Presenter/*
        - lib/Application/Query/*
        - lib/Application/Routing/*
        - lib/Application/Config/*
        - lib/Domain/*
        - lib/Infrastructure/*
        - lib/Module/*
