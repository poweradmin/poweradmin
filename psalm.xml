<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedIssueHandlerSuppression="false"
    findUnusedCode="false"
>
    <projectFiles>
        <file name="index.php" />
        <directory name="install" />
        <directory name="lib" />
        <directory name="tests" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <MethodSignatureMismatch errorLevel="suppress" />
        <UndefinedMethod>
            <errorLevel type="suppress">
                <!-- Suppress UndefinedMethod for PHPUnit mock methods -->
                <referencedMethod name="Poweradmin\Infrastructure\Database\PDOLayer::expects" />
                <referencedMethod name="Poweradmin\Infrastructure\Database\PDOLayer::method" />
                <referencedMethod name="Poweradmin\Infrastructure\Configuration\ConfigurationManager::expects" />
                <referencedMethod name="Poweradmin\Infrastructure\Configuration\ConfigurationManager::method" />
                <referencedMethod name="Poweradmin\Domain\Service\DnsValidation\TTLValidator::expects" />
                <referencedMethod name="PHPUnit\Framework\MockObject\MockObject::expects" />
                <referencedMethod name="PHPUnit\Framework\MockObject\MockObject::method" />
                <referencedMethod name="PHPUnit\Framework\MockObject\MockObject::willReturn" />
                <referencedMethod name="PHPUnit\Framework\MockObject\MockObject::with" />
                <referencedMethod name="PHPUnit\Framework\MockObject\MockObject::returnValue" />
                <referencedMethod name="PHPUnit\Framework\MockObject\MockObject::will" />
            </errorLevel>
        </UndefinedMethod>
        <!-- Suppress other common issues in test files -->
        <InvalidOperand>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </InvalidOperand>
        <InvalidAttribute>
            <errorLevel type="suppress">
                <directory name="lib/Application/Controller/Api" />
                <directory name="tests" />
            </errorLevel>
        </InvalidAttribute>
        <InvalidArrayOffset>
            <errorLevel type="suppress">
                <file name="lib/Domain/Service/DnsValidation/IPAddressValidator.php" />
                <file name="lib/Domain/Service/ReverseRecordCreator.php" />
                <file name="lib/Module/ZoneImportExport/Service/BindZoneFileParser.php" />
            </errorLevel>
        </InvalidArrayOffset>
        <!-- Taint false positives. Psalm taints both halves of a returned
             [clause, params] pair together, so a literal-only WHERE inherits
             taint from the bind list travelling beside it. -->
        <TaintedSql>
            <errorLevel type="suppress">
                <file name="lib/Infrastructure/Logger/RecordChangeLogger.php" />
            </errorLevel>
        </TaintedSql>
        <!-- Error bodies are JSON sent as application/json, never markup. -->
        <TaintedHtml>
            <errorLevel type="suppress">
                <file name="lib/Application/Http/BootstrapErrorResponder.php" />
            </errorLevel>
        </TaintedHtml>
        <TaintedTextWithQuotes>
            <errorLevel type="suppress">
                <file name="lib/Application/Http/BootstrapErrorResponder.php" />
            </errorLevel>
        </TaintedTextWithQuotes>
        <!-- The domain is urlencoded into a fixed base URL and isValidRdapUrl()
             pins the scheme to http/https before the fetch. -->
        <TaintedFile>
            <errorLevel type="suppress">
                <file name="lib/Module/Rdap/Service/RdapService.php" />
            </errorLevel>
        </TaintedFile>
    </issueHandlers>
</psalm>
