msgstr "Teastaíonn na táblaí PowerDNS seo ó Poweradmin le feidhmiú i gceart."

#: install/helpers/InstallStepHandler.php:203
msgid "Updating database... done!"
msgstr "An bunachar sonraí á nuashonrú... déanta!"

