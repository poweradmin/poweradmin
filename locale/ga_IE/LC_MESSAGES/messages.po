#, php-format
msgid ""
"The SQLite database file %s does not exist. Please create the database file "
"before proceeding."
msgstr ""
"Níl an comhad bunachar sonraí SQLite %s ann. Cruthaigh an comhad bunachar "
"sonraí roimh dul ar aghaidh."

