msgid ""
"Note: PostgreSQL and SQLite must use the same database for both PowerDNS and "
"Poweradmin."
msgstr ""
"Nóta: Ní mór do PostgreSQL agus SQLite an bunachar sonraí céanna a úsáid do "
"PowerDNS agus Poweradmin."

#: install/helpers/InstallStepHandler.php:194
msgid "Missing PowerDNS tables:"
msgstr "Táblaí PowerDNS ar iarraidh:"

