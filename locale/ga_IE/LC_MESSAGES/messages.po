msgid "Users vs Groups"
msgstr "Úsáideoirí vs Grúpaí"

#: templates/modern/edit_perm_templ.html:76
msgid ""
"When assigned to <strong>users</strong>: Permissions apply globally across "
"the system."
msgstr ""
"Nuair a shanntar d'<strong>úsáideoirí</strong> é: baineann na ceadanna leis "
"an gcóras ar fad."

#: templates/modern/edit_perm_templ.html:77
msgid ""
"When assigned to <strong>groups</strong>: Permissions apply only to zones "
"owned by that group."
msgstr ""
"Nuair a shanntar do <strong>ghrúpaí</strong> é: ní bhaineann na ceadanna ach "
"le criosanna atá faoi úinéireacht an ghrúpa sin."

