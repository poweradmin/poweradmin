msgstr "Makina adı çizgi ile başlayamaz yada bitemez."

#: lib/Domain/Service/Dns.php:401
msgid "Given hostname or one of the labels is too short or too long."
msgstr ""
"Verilern makina adı yada etiketlerden birisi ya çok kısa yada çok uzun."

#: lib/Domain/Service/Dns.php:438
msgid "Given hostname has too many slashes."
msgstr "Verilen makina adı çok fazla taksime sahip."

#: lib/Domain/Service/Dns.php:447
msgid "You are using an invalid top level domain."
msgstr "Geçersiz bir üst seviye alan adı kullanıyorsunuz."

#: lib/Domain/Service/Dns.php:470
msgid "This is not a valid IPv4 address."
msgstr "Bu geçersiz bir IPv4 adresi."

#: lib/Domain/Service/Dns.php:493
msgid "This is not a valid IPv6 address."
msgstr "Bu geçersiz bir IPv6 adresi."

#: lib/Domain/Service/Dns.php:547
msgid "Invalid characters have been used in this record."
msgstr "Bu kayıtta geçersiz karakterler kullanılmış."

#: lib/Domain/Service/Dns.php:575
msgid "Backslashes must precede all quotes (\") in TXT content"
msgstr ""
"TXT içeriğindeki tüm tırnak işaretlerinin (\") önünde ters eğik çizgi "
"bulunmalıdır"

#: lib/Domain/Service/Dns.php:597
msgid "Add quotes around TXT record content."
msgstr "TXT kayıt içeriğinin etrafına tırnak ekleyin."

#: lib/Domain/Service/Dns.php:627
msgid ""
"This is not a valid CNAME. Did you assign an MX or NS record to the record?"
msgstr "Bu geçersiz bir CNAME. Kayda MX yada NS kaydı atadınız mı?"

#: lib/Domain/Service/Dns.php:656
msgid ""
"This is not a valid record. There is already exists a CNAME with this name."
msgstr "Bu geçersiz bir kayıt. Halihazırda bu isimde bir CNAME bulunmakta."

#: lib/Domain/Service/Dns.php:683
msgid ""
"This is not a valid CNAME. There already exists a record with this name."
msgstr "Bu geçerli bir CNAME değil. Bu isimde zaten bir kayıt var."

#: lib/Domain/Service/Dns.php:703
msgid "Empty CNAME records are not allowed."
msgstr "Boş CNAME kayıtlarına izin verilmez."

#: lib/Domain/Service/Dns.php:729
msgid ""
"You can not point a NS or MX record to a CNAME record. Remove or rename the "
"CNAME record first, or take another name."
msgstr ""
"Bir NS veya MX kaydını bir CNAME kaydına yönlendiremezsiniz. Önce CNAME "
"kaydını kaldırın veya yeniden adlandırın, ya da başka bir isim alın."

#: lib/Domain/Service/Dns.php:755
msgid "Invalid value for content field of HINFO record."
msgstr "HINFO kaydı içerik alanı için geçersiz değer."

#: lib/Domain/Service/Dns.php:842
msgid ""
"Invalid value for name field of SOA record. It should be the name of the "
"zone."
msgstr "SOA kaydı isim alanı için geçersiz değer. Bölge adı olmalıdır."

#: lib/Domain/Service/Dns.php:883
msgid "Invalid service value in name field of SRV record."
msgstr "SRV kaydının ad alanında geçersiz hizmet değeri."

#: lib/Domain/Service/Dns.php:890
msgid "Invalid protocol value in name field of SRV record."
msgstr "SRV kaydının ad alanında geçersiz protokol değeri."

#: lib/Domain/Service/Dns.php:897
msgid "Invalid FQDN value in name field of SRV record."
msgstr "SRV kaydının ad alanında geçersiz FQDN değeri."

#: lib/Domain/Service/Dns.php:917
msgid "Invalid value for the priority field of the SRV record."
msgstr "SRV kaydı prio alanı için geçersiz değer."

#: lib/Domain/Service/Dns.php:924
msgid "Invalid value for the weight field of the SRV record."
msgstr "SRV kaydı etki alanı için geçersiz değer."

#: lib/Domain/Service/Dns.php:931
msgid "Invalid SRV target."
msgstr "Geçersiz SRV hedefi."

#: lib/Domain/Service/Dns.php:955
msgid "Invalid value for TTL field. It should be numeric."
msgstr "TTL alanı için geçersiz değer. Değer rakam olmalıdır."

#: lib/Domain/Service/Dns.php:1034
msgid ""
"Invalid CDNSKEY record format. Expected: FLAGS PROTOCOL ALGORITHM PUBLIC_KEY "
"(e.g., 257 3 5 AwEA...)"
msgstr ""
"Gecersiz CDNSKEY kayit formati. Beklenen: FLAGS PROTOCOL ALGORITHM "
"PUBLIC_KEY (ornek: 257 3 5 AwEA...)"

#: lib/Domain/Service/Dns.php:1049
msgid "CDNSKEY flags must be between 0 and 65535."
msgstr "CDNSKEY flags degeri 0 ile 65535 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1059
msgid "CDNSKEY protocol must be between 0 and 255."
msgstr "CDNSKEY protocol degeri 0 ile 255 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1069
msgid "CDNSKEY algorithm must be between 0 and 255."
msgstr "CDNSKEY algorithm degeri 0 ile 255 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1079
msgid "CDNSKEY public key cannot be empty."
msgstr "CDNSKEY genel anahtar bos olamaz."

#: lib/Domain/Service/Dns.php:1089
msgid "CDNSKEY public key must be valid Base64."
msgstr "CDNSKEY genel anahtar gecerli Base64 olmalidir."

#: lib/Domain/Service/Dns.php:1100
msgid "CDNSKEY public key contains invalid Base64 encoding."
msgstr "CDNSKEY genel anahtar gecersiz Base64 kodlamasi iceriyor."

#: lib/Domain/Service/Dns.php:1154
#, php-format
msgid "Invalid APL element format: %s. Expected: [!]FAMILY:ADDRESS/PREFIX"
msgstr "Gecersiz APL eleman formati: %s. Beklenen: [!]FAMILY:ADDRESS/PREFIX"

#: lib/Domain/Service/Dns.php:1170
#, php-format
msgid "Invalid IPv4 address in APL: %s"
msgstr "APL icinde gecersiz IPv4 adresi: %s"

#: lib/Domain/Service/Dns.php:1178
msgid "IPv4 prefix must be between 0 and 32."
msgstr "IPv4 öneki 0 ile 32 arasında olmalıdır."

#: lib/Domain/Service/Dns.php:1188
#, php-format
msgid "Invalid IPv6 address in APL: %s"
msgstr "APL icinde gecersiz IPv6 adresi: %s"

#: lib/Domain/Service/Dns.php:1196
msgid "IPv6 prefix must be between 0 and 128."
msgstr "IPv6 öneki 0 ile 128 arasında olmalıdır."

#: lib/Domain/Service/Dns.php:1204
#, php-format
msgid "Unknown address family in APL: %d. Must be 1 (IPv4) or 2 (IPv6)."
msgstr ""
"APL icinde bilinmeyen adres ailesi: %d. 1 (IPv4) veya 2 (IPv6) olmalidir."

#: lib/Domain/Service/Dns.php:1237
msgid "ALIAS target hostname cannot be empty."
msgstr "ALIAS hedef ana bilgisayar adi bos olamaz."

#: lib/Domain/Service/Dns.php:1248
msgid "ALIAS target must be a valid hostname."
msgstr "ALIAS hedefi gecerli bir ana bilgisayar adi olmalidir."

#: lib/Domain/Service/Dns.php:1280
msgid ""
"Invalid AFSDB record format. Expected: SUBTYPE HOSTNAME (e.g., 1 afs-"
"server.example.com)"
msgstr ""
"Gecersiz AFSDB kayit formati. Beklenen: SUBTYPE HOSTNAME (ornek: 1 afs-"
"server.example.com)"

#: lib/Domain/Service/Dns.php:1293
msgid "AFSDB subtype must be between 0 and 65535."
msgstr "AFSDB subtype degeri 0 ile 65535 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1303
msgid "AFSDB hostname cannot be empty."
msgstr "AFSDB ana bilgisayar adi bos olamaz."

#: lib/Domain/Service/Dns.php:1336
msgid ""
"Invalid CAA record format. Expected: FLAGS TAG VALUE (e.g., 0 issue "
"\"letsencrypt.org\")"
msgstr ""
"Gecersiz CAA kayit formati. Beklenen: FLAGS TAG VALUE (ornek: 0 issue "
"\"letsencrypt.org\")"

#: lib/Domain/Service/Dns.php:1350
msgid "CAA flags must be between 0 and 255."
msgstr "CAA flags degeri 0 ile 255 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1361
msgid "CAA tag must be alphanumeric."
msgstr "CAA etiketi alfanumerik olmalidir."

#: lib/Domain/Service/Dns.php:1371
msgid ""
"CAA value must be enclosed in quotes (e.g., \"letsencrypt.org\" or \"\")."
msgstr ""
"CAA degeri tirnak isaretleri icinde olmalidir (ornek: \"letsencrypt.org\" "
"veya \"\")."

#: lib/Domain/Service/Dns.php:1385
msgid "Quotes inside CAA value must be escaped with backslash."
msgstr "CAA degeri icindeki tirnak isaretleri ters bolu ile korunmalidir."

#: lib/Domain/Service/Dns.php:1422
msgid ""
"Invalid CDS record format. Expected: KEYTAG ALGORITHM DIGESTTYPE DIGEST "
"(e.g., 20642 8 2 04443ABE...)"
msgstr ""
"Gecersiz CDS kayit formati. Beklenen: KEYTAG ALGORITHM DIGESTTYPE DIGEST "
"(ornek: 20642 8 2 04443ABE...)"

#: lib/Domain/Service/Dns.php:1437
msgid "CDS keytag must be between 0 and 65535."
msgstr "CDS keytag degeri 0 ile 65535 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1447
msgid "CDS algorithm must be between 0 and 255."
msgstr "CDS algorithm degeri 0 ile 255 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1457
msgid "CDS digest type must be between 0 and 255."
msgstr "CDS digest type degeri 0 ile 255 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1467
msgid "CDS digest cannot be empty."
msgstr "CDS digest bos olamaz."

#: lib/Domain/Service/Dns.php:1484
msgid ""
"CDS digest has unexpected length. Expected 40 (SHA-1), 64 (SHA-256), or 96 "
"(SHA-384) hex characters."
msgstr ""
"CDS digest beklenmeyen uzunlukta. Beklenen 40 (SHA-1), 64 (SHA-256) veya 96 "
"(SHA-384) hex karakter."

#: lib/Domain/Service/Dns.php:1530
msgid ""
"Invalid CERT record format. Expected: TYPE KEYTAG ALGORITHM CERTIFICATE "
"(e.g., 1 0 0 MIIB9D...)"
msgstr ""
"Gecersiz CERT kayit formati. Beklenen: TYPE KEYTAG ALGORITHM CERTIFICATE "
"(ornek: 1 0 0 MIIB9D...)"

#: lib/Domain/Service/Dns.php:1545
msgid "CERT type must be between 0 and 65535."
msgstr "CERT type degeri 0 ile 65535 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1555
msgid "CERT keytag must be between 0 and 65535."
msgstr "CERT keytag degeri 0 ile 65535 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1565
msgid "CERT algorithm must be between 0 and 255."
msgstr "CERT algorithm degeri 0 ile 255 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1575
msgid "CERT certificate cannot be empty."
msgstr "CERT sertifikasi bos olamaz."

#: lib/Domain/Service/Dns.php:1585
msgid "CERT certificate must be valid Base64."
msgstr "CERT sertifikasi gecerli Base64 olmalidir."

#: lib/Domain/Service/Dns.php:1596
msgid "CERT certificate contains invalid Base64 encoding."
msgstr "CERT sertifikasi gecersiz Base64 kodlamasi iceriyor."

#: lib/Domain/Service/Dns.php:1633
msgid "DNAME target cannot be empty."
msgstr "DNAME hedefi bos olamaz."

#: lib/Domain/Service/Dns.php:1644
msgid "DNAME target cannot contain spaces."
msgstr "DNAME hedefi bosluk iceremez."

#: lib/Domain/Service/Dns.php:1654
msgid ""
"DNAME target contains invalid characters. Only alphanumeric, dots, hyphens, "
"and underscores are allowed."
msgstr ""
"DNAME hedefi gecersiz karakterler iceriyor. Yalnizca alfanumerik, nokta, "
"tire ve alt cizgi karakterlerine izin verilir."

#: lib/Domain/Service/Dns.php:1689
msgid ""
"Invalid L32 record format. Expected: PREFERENCE LOCATOR32 (e.g., 513 "
"192.0.2.1)"
msgstr ""
"Gecersiz L32 kayit formati. Beklenen: PREFERENCE LOCATOR32 (ornek: 513 "
"192.0.2.1)"

#: lib/Domain/Service/Dns.php:1702
msgid "L32 preference must be between 0 and 65535."
msgstr "L32 preference degeri 0 ile 65535 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1712
msgid "L32 locator32 must be a valid IPv4 address."
msgstr "L32 locator32 gecerli bir IPv4 adresi olmalidir."

#: lib/Domain/Service/Dns.php:1747
msgid ""
"Invalid L64 record format. Expected: PREFERENCE LOCATOR64 (e.g., 255 "
"2001:0DB8:1234:ABCD)"
msgstr ""
"Gecersiz L64 kayit formati. Beklenen: PREFERENCE LOCATOR64 (ornek: 255 "
"2001:0DB8:1234:ABCD)"

#: lib/Domain/Service/Dns.php:1760
msgid "L64 preference must be between 0 and 65535."
msgstr "L64 preference degeri 0 ile 65535 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1771
msgid ""
"L64 locator64 must be in format XXXX:XXXX:XXXX:XXXX (e.g., "
"2001:0DB8:1234:ABCD)."
msgstr ""
"L64 locator64 XXXX:XXXX:XXXX:XXXX formatinda olmalidir (ornek: "
"2001:0DB8:1234:ABCD)."

#: lib/Domain/Service/Dns.php:1809
msgid "LUA record content cannot be empty."
msgstr "LUA kayıt içeriği boş olamaz."

#: lib/Domain/Service/Dns.php:1820
msgid ""
"Invalid LUA record format. Expected: TYPE LUA_CODE (e.g., A \"ifportup(443, "
"{'192.0.2.1'})\")"
msgstr ""
"Gecersiz LUA kayit formati. Beklenen: TYPE LUA_CODE (ornek: A "
"\"ifportup(443, {'192.0.2.1'})\")"

#: lib/Domain/Service/Dns.php:1839
msgid ""
"LUA record type must be a valid DNS record type (e.g., A, AAAA, TXT, MX, "
"etc.)."
msgstr ""
"LUA kayit tipi gecerli bir DNS kayit tipi olmalidir (ornek: A, AAAA, TXT, "
"MX, vb.)."

#: lib/Domain/Service/Dns.php:1849
msgid "LUA code cannot be empty."
msgstr "LUA kodu bos olamaz."

#: lib/Domain/Service/Dns.php:1888
msgid ""
"Invalid LP record format. Expected: PREFERENCE FQDN (e.g., 512 "
"foo.powerdns.org.)"
msgstr ""
"Gecersiz LP kayit formati. Beklenen: PREFERENCE FQDN (ornek: 512 "
"foo.powerdns.org.)"

#: lib/Domain/Service/Dns.php:1901
msgid "LP preference must be between 0 and 65535."
msgstr "LP preference degeri 0 ile 65535 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:1911
msgid "LP FQDN cannot be empty."
msgstr "LP FQDN bos olamaz."

#: lib/Domain/Service/Dns.php:1922
msgid ""
"LP FQDN contains invalid characters. Only alphanumeric, dots, hyphens, and "
"underscores are allowed."
msgstr ""
"LP FQDN gecersiz karakterler iceriyor. Yalnizca alfanumerik, nokta, tire ve "
"alt cizgi karakterlerine izin verilir."

#: lib/Domain/Service/Dns.php:1955
#, php-format
msgid ""
"%s is a meta-query type and cannot be used as a zone record. It is only used "
"in DNS queries."
msgstr ""
"%s bir meta-sorgu tipidir ve bolge kaydi olarak kullanilamaz. Yalnizca DNS "
"sorgularinda kullanilir."

#: lib/Domain/Service/Dns.php:1988
msgid "OPENPGPKEY content cannot be empty."
msgstr "OPENPGPKEY icerigi bos olamaz."

#: lib/Domain/Service/Dns.php:1998
msgid "OPENPGPKEY must be valid Base64-encoded data."
msgstr "OPENPGPKEY gecerli Base64 kodlanmis veri olmalidir."

#: lib/Domain/Service/Dns.php:2009
msgid "OPENPGPKEY contains invalid Base64 encoding."
msgstr "OPENPGPKEY gecersiz Base64 kodlamasi iceriyor."

#: lib/Domain/Service/Dns.php:2055
msgid ""
"Invalid SIG record format. Expected: TYPE_COVERED ALGORITHM LABELS "
"ORIGINAL_TTL SIG_EXPIRATION SIG_INCEPTION KEY_TAG SIGNER_NAME SIGNATURE"
msgstr ""
"Gecersiz SIG kayit formati. Beklenen: TYPE_COVERED ALGORITHM LABELS "
"ORIGINAL_TTL SIG_EXPIRATION SIG_INCEPTION KEY_TAG SIGNER_NAME SIGNATURE"

#: lib/Domain/Service/Dns.php:2075
msgid "SIG type covered must be a valid DNS record type."
msgstr "SIG type covered gecerli bir DNS kayit tipi olmalidir."

#: lib/Domain/Service/Dns.php:2085
msgid "SIG algorithm must be between 0 and 255."
msgstr "SIG algorithm degeri 0 ile 255 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:2095
msgid "SIG labels must be between 0 and 255."
msgstr "SIG labels degeri 0 ile 255 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:2105
msgid "SIG original TTL must be a positive integer."
msgstr "SIG orijinal TTL pozitif bir tamsayi olmalidir."

#: lib/Domain/Service/Dns.php:2115
msgid "SIG key tag must be between 0 and 65535."
msgstr "SIG key tag degeri 0 ile 65535 arasinda olmalidir."

#: lib/Domain/Service/Dns.php:2125
msgid "SIG signer name cannot be empty."
msgstr "SIG imzalayici adi bos olamaz."

#: lib/Domain/Service/Dns.php:2134
msgid "SIG signer name must be a valid domain name."
msgstr "SIG imzalayici adi gecerli bir alan adi olmalidir."

#: lib/Domain/Service/Dns.php:2144
msgid "SIG signature cannot be empty."
msgstr "SIG imzasi bos olamaz."

#: lib/Domain/Service/Dns.php:2153
msgid "SIG signature must be valid Base64."
msgstr "SIG imzasi gecerli Base64 olmalidir."

#: lib/Domain/Service/Dns.php:2163
msgid "SIG signature contains invalid Base64 encoding."
msgstr "SIG imzasi gecersiz Base64 kodlamasi iceriyor."

#: lib/Domain/Service/Dns.php:2193
msgid "DHCID record content is required"
msgstr "DHCID kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:2207
msgid "DHCID record must contain valid Base64-encoded data"
msgstr "DHCID kaydi gecerli Base64 kodlanmis veri icermelidir"

#: lib/Domain/Service/Dns.php:2217
msgid "DHCID record data is too short (minimum 35 bytes required)"
msgstr "DHCID kayit verisi cok kisa (en az 35 bayt gereklidir)"

#: lib/Domain/Service/Dns.php:2249
msgid "SMIMEA record content is required"
msgstr "SMIMEA kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:2260
msgid ""
"SMIMEA record must have at least 4 fields: usage, selector, matching-type, "
"and certificate data"
msgstr ""
"SMIMEA kaydi en az 4 alan icermelidir: usage, selector, matching-type ve "
"sertifika verisi"

#: lib/Domain/Service/Dns.php:2275
msgid "SMIMEA usage must be an integer between 0 and 255"
msgstr "SMIMEA usage degeri 0 ile 255 arasinda bir tamsayi olmalidir"

#: lib/Domain/Service/Dns.php:2285
msgid "SMIMEA selector must be an integer between 0 and 255"
msgstr "SMIMEA selector degeri 0 ile 255 arasinda bir tamsayi olmalidir"

#: lib/Domain/Service/Dns.php:2295
msgid "SMIMEA matching type must be an integer between 0 and 255"
msgstr "SMIMEA matching type degeri 0 ile 255 arasinda bir tamsayi olmalidir"

#: lib/Domain/Service/Dns.php:2305
msgid "SMIMEA certificate data is required"
msgstr "SMIMEA sertifika verisi gereklidir"

#: lib/Domain/Service/Dns.php:2314
msgid "SMIMEA certificate data must be a valid hexadecimal string"
msgstr "SMIMEA sertifika verisi gecerli bir onaltilik dize olmalidir"

#: lib/Domain/Service/Dns.php:2324
msgid ""
"SMIMEA certificate data must be at least 2 hexadecimal characters (1 byte)"
msgstr "SMIMEA sertifika verisi en az 2 onaltilik karakter (1 bayt) olmalidir"

#: lib/Domain/Service/Dns.php:2334
msgid ""
"SMIMEA certificate data must have an even number of hexadecimal characters"
msgstr "SMIMEA sertifika verisi cift sayida onaltilik karakter icermelidir"

#: lib/Domain/Service/Dns.php:2371
msgid "TKEY record content is required"
msgstr "TKEY kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:2384
msgid ""
"TKEY record must have at least 6 fields: algorithm, inception, expiration, "
"mode, error, and keysize"
msgstr ""
"TKEY kaydi en az 6 alan icermelidir: algorithm, inception, expiration, mode, "
"error ve keysize"

#: lib/Domain/Service/Dns.php:2401
msgid "TKEY algorithm must be a valid domain name"
msgstr "TKEY algorithm gecerli bir alan adi olmalidir"

#: lib/Domain/Service/Dns.php:2411
msgid "TKEY inception must be a 32-bit unsigned integer (0-4294967295)"
msgstr "TKEY inception 32-bit isaretiz tamsayi olmalidir (0-4294967295)"

#: lib/Domain/Service/Dns.php:2421
msgid "TKEY expiration must be a 32-bit unsigned integer (0-4294967295)"
msgstr "TKEY expiration 32-bit isaretiz tamsayi olmalidir (0-4294967295)"

#: lib/Domain/Service/Dns.php:2431
msgid "TKEY mode must be a 16-bit unsigned integer (0-65535)"
msgstr "TKEY mode 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:2441
msgid "TKEY error must be a 16-bit unsigned integer (0-65535)"
msgstr "TKEY error 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:2451
msgid "TKEY keysize must be a 16-bit unsigned integer (0-65535)"
msgstr "TKEY keysize 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:2465
msgid "TKEY keydata is required when keysize > 0"
msgstr "keysize > 0 oldugunda TKEY keydata gereklidir"

#: lib/Domain/Service/Dns.php:2477
msgid "TKEY keydata must be valid Base64-encoded data"
msgstr "TKEY keydata gecerli Base64 kodlanmis veri olmalidir"

#: lib/Domain/Service/Dns.php:2490
msgid "TKEY othersize field is required"
msgstr "TKEY othersize alani gereklidir"

#: lib/Domain/Service/Dns.php:2502
msgid "TKEY othersize must be a 16-bit unsigned integer (0-65535)"
msgstr "TKEY othersize 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:2516
msgid "TKEY otherdata is required when othersize > 0"
msgstr "othersize > 0 oldugunda TKEY otherdata gereklidir"

#: lib/Domain/Service/Dns.php:2528
msgid "TKEY otherdata must be valid Base64-encoded data"
msgstr "TKEY otherdata gecerli Base64 kodlanmis veri olmalidir"

#: lib/Domain/Service/Dns.php:2560
msgid "URI record content is required"
msgstr "URI kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:2571
msgid ""
"URI record must have format: <priority> <weight> \"<target>\" (target must "
"be in quotes)"
msgstr ""
"URI kaydi su formatta olmalidir: <priority> <weight> \"<target>\" (hedef "
"tirnak icinde olmalidir)"

#: lib/Domain/Service/Dns.php:2585
msgid "URI priority must be a 16-bit unsigned integer (0-65535)"
msgstr "URI priority 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:2595
msgid "URI weight must be a 16-bit unsigned integer (0-65535)"
msgstr "URI weight 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:2605
msgid "URI target cannot be empty"
msgstr "URI hedefi bos olamaz"

#: lib/Domain/Service/Dns.php:2615
#, php-format
msgid "URI target must be a valid URI with a scheme (e.g., %s, %s, %s)"
msgstr ""
"URI hedefi gecerli bir sema ile URI olmalidir (ornek: %s, %s, %s)mailto:)"

#: lib/Domain/Service/Dns.php:2664
msgid "SSHFP record content is required"
msgstr "SSHFP kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:2675
msgid "SSHFP record must have 3 fields: algorithm, fptype, and fingerprint"
msgstr "SSHFP kaydi 3 alan icermelidir: algorithm, fptype ve fingerprint"

#: lib/Domain/Service/Dns.php:2689
msgid "SSHFP algorithm must be an 8-bit integer (0-255)"
msgstr "SSHFP algorithm 8-bit tamsayi olmalidir (0-255)"

#: lib/Domain/Service/Dns.php:2699
msgid "SSHFP fingerprint type must be an 8-bit integer (0-255)"
msgstr "SSHFP fingerprint type 8-bit tamsayi olmalidir (0-255)"

#: lib/Domain/Service/Dns.php:2709
msgid "SSHFP fingerprint is required"
msgstr "SSHFP fingerprint gereklidir"

#: lib/Domain/Service/Dns.php:2718
msgid "SSHFP fingerprint must be a valid hexadecimal string"
msgstr "SSHFP fingerprint gecerli bir onaltilik dize olmalidir"

#: lib/Domain/Service/Dns.php:2728
msgid "SSHFP fingerprint must have an even number of hexadecimal characters"
msgstr "SSHFP fingerprint cift sayida onaltilik karakter icermelidir"

#: lib/Domain/Service/Dns.php:2754
msgid "NAPTR record content is required"
msgstr "NAPTR kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:2764
msgid ""
"NAPTR record must have format: <order> <preference> \"<flags>\" "
"\"<services>\" \"<regexp>\" <replacement>"
msgstr ""
"NAPTR kaydi su formatta olmalidir: <order> <preference> \"<flags>\" "
"\"<services>\" \"<regexp>\" <replacement>"

#: lib/Domain/Service/Dns.php:2781
msgid "NAPTR order must be a 16-bit unsigned integer (0-65535)"
msgstr "NAPTR order 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:2791
msgid "NAPTR preference must be a 16-bit unsigned integer (0-65535)"
msgstr "NAPTR preference 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:2802
msgid "NAPTR replacement must be a valid domain name or \".\""
msgstr "NAPTR replacement gecerli bir alan adi veya \".\" olmalidir"

#: lib/Domain/Service/Dns.php:2828
msgid "RP record content is required"
msgstr "RP kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:2839
msgid "RP record must have 2 fields: mbox-dname and txt-dname"
msgstr "RP kaydi 2 alan icermelidir: mbox-dname ve txt-dname"

#: lib/Domain/Service/Dns.php:2852
msgid "RP mbox-dname must be a valid domain name"
msgstr "RP mbox-dname gecerli bir alan adi olmalidir"

#: lib/Domain/Service/Dns.php:2862
msgid "RP txt-dname must be a valid domain name"
msgstr "RP txt-dname gecerli bir alan adi olmalidir"

#: lib/Domain/Service/Dns.php:2888
msgid "DNSKEY record content is required"
msgstr "DNSKEY kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:2899
msgid ""
"DNSKEY record must have at least 4 fields: flags, protocol, algorithm, and "
"public key"
msgstr ""
"DNSKEY kaydi en az 4 alan icermelidir: flags, protocol, algorithm ve genel "
"anahtar"

#: lib/Domain/Service/Dns.php:2914
msgid "DNSKEY flags must be a 16-bit unsigned integer (0-65535)"
msgstr "DNSKEY flags 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:2924
msgid "DNSKEY protocol must be 3"
msgstr "DNSKEY protocol 3 olmalidir"

#: lib/Domain/Service/Dns.php:2934
msgid "DNSKEY algorithm must be an 8-bit unsigned integer (0-255)"
msgstr "DNSKEY algorithm 8-bit isaretsiz tamsayi olmalidir (0-255)"

#: lib/Domain/Service/Dns.php:2944
msgid "DNSKEY public key is required"
msgstr "DNSKEY genel anahtar gereklidir"

#: lib/Domain/Service/Dns.php:2953
msgid "DNSKEY public key must be valid Base64-encoded data"
msgstr "DNSKEY genel anahtar gecerli Base64 kodlanmis veri olmalidir"

#: lib/Domain/Service/Dns.php:2979
msgid "NSEC record content is required"
msgstr "NSEC kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:2990
msgid "NSEC record must have at least 2 fields: next domain name and type list"
msgstr "NSEC kaydi en az 2 alan icermelidir: sonraki alan adi ve tip listesi"

#: lib/Domain/Service/Dns.php:3002
msgid "NSEC next domain must be a valid domain name"
msgstr "NSEC sonraki alan adi gecerli bir alan adi olmalidir"

#: lib/Domain/Service/Dns.php:3015
msgid "NSEC type list must contain valid DNS record type names"
msgstr "NSEC tip listesi gecerli DNS kayit tipi adlari icermelidir"

#: lib/Domain/Service/Dns.php:3042
msgid "NSEC3 record content is required"
msgstr "NSEC3 kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:3053
msgid ""
"NSEC3 record must have at least 5 fields: algorithm, flags, iterations, "
"salt, and next hash"
msgstr ""
"NSEC3 kaydi en az 5 alan icermelidir: algorithm, flags, iterations, salt ve "
"sonraki hash"

#: lib/Domain/Service/Dns.php:3069
msgid "NSEC3 algorithm must be an 8-bit unsigned integer (0-255)"
msgstr "NSEC3 algorithm 8-bit isaretsiz tamsayi olmalidir (0-255)"

#: lib/Domain/Service/Dns.php:3079
msgid "NSEC3 flags must be an 8-bit unsigned integer (0-255)"
msgstr "NSEC3 flags 8-bit isaretsiz tamsayi olmalidir (0-255)"

#: lib/Domain/Service/Dns.php:3089
msgid "NSEC3 iterations must be a 16-bit unsigned integer (0-65535)"
msgstr "NSEC3 iterations 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:3099
msgid "NSEC3 salt must be hexadecimal or \"-\" for no salt"
msgstr "NSEC3 salt onaltilik veya \"-\" (tuz yok) olmalidir"

#: lib/Domain/Service/Dns.php:3109
msgid "NSEC3 next hash must be Base32hex-encoded (0-9, A-V)"
msgstr "NSEC3 sonraki hash Base32hex kodlanmis olmalidir (0-9, A-V)"

#: lib/Domain/Service/Dns.php:3122
msgid "NSEC3 type list must contain uppercase type names"
msgstr "NSEC3 tip listesi buyuk harfli tip adlari icermelidir"

#: lib/Domain/Service/Dns.php:3150
msgid "NSEC3PARAM record content is required"
msgstr "NSEC3PARAM kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:3161
msgid ""
"NSEC3PARAM record must have 4 fields: algorithm, flags, iterations, and salt"
msgstr ""
"NSEC3PARAM kaydi 4 alan icermelidir: algorithm, flags, iterations ve salt"

#: lib/Domain/Service/Dns.php:3176
msgid "NSEC3PARAM algorithm must be an 8-bit unsigned integer (0-255)"
msgstr "NSEC3PARAM algorithm 8-bit isaretsiz tamsayi olmalidir (0-255)"

#: lib/Domain/Service/Dns.php:3186
msgid "NSEC3PARAM flags must be an 8-bit unsigned integer (0-255)"
msgstr "NSEC3PARAM flags 8-bit isaretsiz tamsayi olmalidir (0-255)"

#: lib/Domain/Service/Dns.php:3196
msgid "NSEC3PARAM iterations must be a 16-bit unsigned integer (0-65535)"
msgstr "NSEC3PARAM iterations 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:3206
msgid "NSEC3PARAM salt must be hexadecimal or \"-\" for no salt"
msgstr "NSEC3PARAM salt onaltilik veya \"-\" (tuz yok) olmalidir"

#: lib/Domain/Service/Dns.php:3250
msgid "TSIG record content is required"
msgstr "TSIG kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:3262
msgid ""
"TSIG record must have at least 8 fields: algorithm, time-signed, fudge, mac-"
"size, mac, original-id, error, and other-len"
msgstr ""
"TSIG kaydi en az 8 alan icermelidir: algorithm, time-signed, fudge, mac-"
"size, mac, original-id, error ve other-len"

#: lib/Domain/Service/Dns.php:3281
msgid "TSIG algorithm must be a valid domain name"
msgstr "TSIG algorithm gecerli bir alan adi olmalidir"

#: lib/Domain/Service/Dns.php:3291
msgid "TSIG time-signed must be a non-negative integer"
msgstr "TSIG time-signed negatif olmayan bir tamsayi olmalidir"

#: lib/Domain/Service/Dns.php:3301
msgid "TSIG fudge must be a 16-bit unsigned integer (0-65535)"
msgstr "TSIG fudge 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:3311
msgid "TSIG mac-size must be a 16-bit unsigned integer (0-65535)"
msgstr "TSIG mac-size 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:3321
msgid "TSIG MAC must be valid Base64-encoded data"
msgstr "TSIG MAC gecerli Base64 kodlanmis veri olmalidir"

#: lib/Domain/Service/Dns.php:3331
msgid "TSIG original-id must be a 16-bit unsigned integer (0-65535)"
msgstr "TSIG original-id 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:3341
msgid "TSIG error must be a 16-bit unsigned integer (0-65535)"
msgstr "TSIG error 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:3351
msgid "TSIG other-len must be a 16-bit unsigned integer (0-65535)"
msgstr "TSIG other-len 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:3362
msgid "TSIG other-data is required when other-len > 0"
msgstr "other-len > 0 oldugunda TSIG other-data gereklidir"

#: lib/Domain/Service/Dns.php:3372
msgid "TSIG other-data must be valid Base64-encoded data"
msgstr "TSIG other-data gecerli Base64 kodlanmis veri olmalidir"

#: lib/Domain/Service/Dns.php:3398
msgid "EUI48 record content is required"
msgstr "EUI48 kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:3408
msgid "EUI48 must be 6 octets separated by dashes (e.g., 00-11-22-33-44-55)"
msgstr "EUI48 tirelerle ayrilmis 6 oktet olmalidir (ornek: 00-11-22-33-44-55)"

#: lib/Domain/Service/Dns.php:3433
msgid "EUI64 record content is required"
msgstr "EUI64 kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:3443
msgid ""
"EUI64 must be 8 octets separated by dashes (e.g., 00-11-22-33-44-55-66-77)"
msgstr ""
"EUI64 tirelerle ayrilmis 8 oktet olmalidir (ornek: 00-11-22-33-44-55-66-77)"

#: lib/Domain/Service/Dns.php:3468
msgid "NID record content is required"
msgstr "NID kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:3479
msgid "NID record must have 2 fields: preference and node-id"
msgstr "NID kaydi 2 alan icermelidir: preference ve node-id"

#: lib/Domain/Service/Dns.php:3492
msgid "NID preference must be a 16-bit unsigned integer (0-65535)"
msgstr "NID preference 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:3502
msgid ""
"NID node-id must be in format XXXX:XXXX:XXXX:XXXX (64-bit hex with colons)"
msgstr ""
"NID node-id XXXX:XXXX:XXXX:XXXX formatinda olmalidir (iki noktali 64-bit hex)"

#: lib/Domain/Service/Dns.php:3527
msgid "KX record content is required"
msgstr "KX kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:3538
msgid "KX record must have 2 fields: preference and exchanger"
msgstr "KX kaydi 2 alan icermelidir: preference ve exchanger"

#: lib/Domain/Service/Dns.php:3551
msgid "KX preference must be a 16-bit unsigned integer (0-65535)"
msgstr "KX preference 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:3562
msgid "KX exchanger must be a valid domain name"
msgstr "KX exchanger gecerli bir alan adi olmalidir"

#: lib/Domain/Service/Dns.php:3587
msgid "IPSECKEY record content is required"
msgstr "IPSECKEY kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:3598
msgid ""
"IPSECKEY record must have at least 3 fields: precedence, gateway-type, and "
"algorithm"
msgstr ""
"IPSECKEY kaydi en az 3 alan icermelidir: precedence, gateway-type ve "
"algorithm"

#: lib/Domain/Service/Dns.php:3612
msgid "IPSECKEY precedence must be an 8-bit unsigned integer (0-255)"
msgstr "IPSECKEY precedence 8-bit isaretsiz tamsayi olmalidir (0-255)"

#: lib/Domain/Service/Dns.php:3622
msgid "IPSECKEY gateway-type must be 0-3 (0=none, 1=IPv4, 2=IPv6, 3=domain)"
msgstr ""
"IPSECKEY gateway-type 0-3 olmalidir (0=yok, 1=IPv4, 2=IPv6, 3=alan adi)"

#: lib/Domain/Service/Dns.php:3632
msgid "IPSECKEY algorithm must be an 8-bit unsigned integer (0-255)"
msgstr "IPSECKEY algorithm 8-bit isaretsiz tamsayi olmalidir (0-255)"

#: lib/Domain/Service/Dns.php:3711 lib/Domain/Service/Dns.php:3743
msgid "IPSECKEY public key must be Base64-encoded"
msgstr "IPSECKEY genel anahtar Base64 kodlanmis olmalidir"

#: lib/Domain/Service/Dns.php:3660
msgid "IPSECKEY with gateway-type 1 requires an IPv4 address"
msgstr "gateway-type 1 olan IPSECKEY bir IPv4 adresi gerektirir"

#: lib/Domain/Service/Dns.php:3669
msgid "IPSECKEY gateway must be a valid IPv4 address"
msgstr "IPSECKEY gateway gecerli bir IPv4 adresi olmalidir"

#: lib/Domain/Service/Dns.php:3691
msgid "IPSECKEY with gateway-type 2 requires an IPv6 address"
msgstr "gateway-type 2 olan IPSECKEY bir IPv6 adresi gerektirir"

#: lib/Domain/Service/Dns.php:3700
msgid "IPSECKEY gateway must be a valid IPv6 address"
msgstr "IPSECKEY gateway gecerli bir IPv6 adresi olmalidir"

#: lib/Domain/Service/Dns.php:3722
msgid "IPSECKEY with gateway-type 3 requires a domain name"
msgstr "gateway-type 3 olan IPSECKEY bir alan adi gerektirir"

#: lib/Domain/Service/Dns.php:3732
msgid "IPSECKEY gateway must be a valid domain name"
msgstr "IPSECKEY gateway gecerli bir alan adi olmalidir"

#: lib/Domain/Service/Dns.php:3815
msgid "MINFO record content is required"
msgstr "MINFO kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:3826
msgid "MINFO record must have 2 fields: rmailbx and emailbx"
msgstr "MINFO kaydi 2 alan icermelidir: rmailbx ve emailbx"

#: lib/Domain/Service/Dns.php:3839
msgid "MINFO rmailbx must be a valid domain name"
msgstr "MINFO rmailbx gecerli bir alan adi olmalidir"

#: lib/Domain/Service/Dns.php:3849
msgid "MINFO emailbx must be a valid domain name"
msgstr "MINFO emailbx gecerli bir alan adi olmalidir"

#: lib/Domain/Service/Dns.php:3874
msgid "MR record content is required"
msgstr "MR kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:3884
msgid "MR newname must be a valid domain name"
msgstr "MR newname gecerli bir alan adi olmalidir"

#: lib/Domain/Service/Dns.php:3909
msgid "WKS record content is required"
msgstr "WKS kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:3920
msgid "WKS record must have at least 3 fields: address, protocol, and services"
msgstr "WKS kaydi en az 3 alan icermelidir: address, protocol ve services"

#: lib/Domain/Service/Dns.php:3933
msgid "WKS address must be a valid IPv4 address"
msgstr "WKS adresi gecerli bir IPv4 adresi olmalidir"

#: lib/Domain/Service/Dns.php:3944 lib/Domain/Service/Dns.php:3954
msgid "WKS protocol must be an 8-bit unsigned integer (0-255) or protocol name"
msgstr ""
"WKS protocol 8-bit isaretsiz tamsayi (0-255) veya protokol adi olmalidir"

#: lib/Domain/Service/Dns.php:3968 lib/Domain/Service/Dns.php:3978
msgid "WKS service must be a 16-bit port number (0-65535) or service name"
msgstr "WKS service 16-bit port numarasi (0-65535) veya servis adi olmalidir"

#: lib/Domain/Service/Dns.php:4005
msgid "A6 record content is required"
msgstr "A6 kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:4018
msgid ""
"A6 record must have at least 2 fields: prefix-length and address-suffix or "
"prefix-name"
msgstr ""
"A6 kaydi en az 2 alan icermelidir: prefix-length ve address-suffix veya "
"prefix-name"

#: lib/Domain/Service/Dns.php:4030
msgid "A6 prefix length must be an integer (0-128)"
msgstr "A6 prefix length 0 ile 128 arasinda bir tamsayi olmalidir"

#: lib/Domain/Service/Dns.php:4055
msgid "CSYNC record content is required"
msgstr "CSYNC kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:4066
msgid ""
"CSYNC record must have at least 3 fields: SOA-serial, flags, and type-list"
msgstr "CSYNC kaydi en az 3 alan icermelidir: SOA-serial, flags ve type-list"

#: lib/Domain/Service/Dns.php:4079
msgid "CSYNC SOA serial must be a 32-bit unsigned integer (0-4294967295)"
msgstr "CSYNC SOA serial 32-bit isaretsiz tamsayi olmalidir (0-4294967295)"

#: lib/Domain/Service/Dns.php:4089
msgid "CSYNC flags must be a 16-bit unsigned integer (0-65535)"
msgstr "CSYNC flags 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:4101
msgid "CSYNC type list must contain uppercase type names"
msgstr "CSYNC tip listesi buyuk harfli tip adlari icermelidir"

#: lib/Domain/Service/Dns.php:4127
msgid "ZONEMD record content is required"
msgstr "ZONEMD kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:4138
msgid "ZONEMD record must have 4 fields: serial, scheme, algorithm, and digest"
msgstr "ZONEMD kaydi 4 alan icermelidir: serial, scheme, algorithm ve digest"

#: lib/Domain/Service/Dns.php:4153
msgid "ZONEMD serial must be a 32-bit unsigned integer (0-4294967295)"
msgstr "ZONEMD serial 32-bit isaretsiz tamsayi olmalidir (0-4294967295)"

#: lib/Domain/Service/Dns.php:4163
msgid "ZONEMD scheme must be an 8-bit unsigned integer (0-255)"
msgstr "ZONEMD scheme 8-bit isaretsiz tamsayi olmalidir (0-255)"

#: lib/Domain/Service/Dns.php:4173
msgid "ZONEMD algorithm must be an 8-bit unsigned integer (0-255)"
msgstr "ZONEMD algorithm 8-bit isaretsiz tamsayi olmalidir (0-255)"

#: lib/Domain/Service/Dns.php:4183
msgid "ZONEMD digest must be hexadecimal"
msgstr "ZONEMD digest onaltilik olmalidir"

#: lib/Domain/Service/Dns.php:4223
msgid "SVCB record content is required"
msgstr "SVCB kayit icerigi gereklidir"

#: lib/Domain/Service/Dns.php:4234
msgid "SVCB record must have at least 2 fields: priority and target"
msgstr "SVCB kaydi en az 2 alan icermelidir: priority ve target"

#: lib/Domain/Service/Dns.php:4247
msgid "SVCB priority must be a 16-bit unsigned integer (0-65535)"
msgstr "SVCB priority 16-bit isaretsiz tamsayi olmalidir (0-65535)"

#: lib/Domain/Service/Dns.php:4258
msgid "SVCB target must be a valid domain name or \".\""
msgstr "SVCB target gecerli bir alan adi veya \".\" olmalidir"

