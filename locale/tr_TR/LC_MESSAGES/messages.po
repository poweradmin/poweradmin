msgid "API functionality is disabled."
msgstr "API işlevleri devre dışı."

#: lib/Domain/Service/Auth/ApiKeyService.php:158
msgid "You do not have permission to create API keys."
msgstr "API anahtarları oluşturma izniniz yok."

