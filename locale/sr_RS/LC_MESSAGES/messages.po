"install/ да бисте је креирали или креирајте конфигурациону датотеку ручно."

#: lib/Module/DnsWizard/Controller/DnsWizardSelectController.php:59
msgid "DNS wizards are not enabled."
msgstr "DNS чаробњаци нису омогућени."

#: lib/Application/Controller/DnssecToggleKeyController.php:46
msgid "Invalid zone ID."
msgstr "Неважећи ИД зоне."

#: lib/Application/Controller/ZoneOwnershipController.php:94
msgid "Zone not found."
msgstr "Зона није пронађена."

#: lib/Application/Controller/BatchPtrRecordController.php:114
