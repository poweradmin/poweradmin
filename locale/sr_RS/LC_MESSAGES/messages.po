msgstr "Немате дозволу за додавање записа у ову зону."

#: lib/Module/DnsWizard/Controller/DnsWizardFormController.php:117
msgid "Invalid wizard type."
msgstr "Неважећи тип чаробњака."

#: lib/Module/DnsWizard/Controller/DnsWizardFormController.php:203
