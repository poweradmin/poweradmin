msgstr ""
"Te skupine ni mogoče zbrisati: je zadnji lastnik %s. Najprej dodajte drugega "
"lastnika tem conam."

#: lib/Application/Service/Zone/ZoneOwnershipMessages.php:66
msgid "Add another user owner first (zone ownership mode is users_only)."
msgstr ""
"Najprej dodajte drugega lastnika uporabnika (način lastništva cone je "
"users_only)."

#: lib/Application/Service/Zone/ZoneOwnershipMessages.php:67
msgid "Add a group first (zone ownership mode is groups_only)."
