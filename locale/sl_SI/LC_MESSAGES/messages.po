msgstr ""
"Ni mogoče odstraniti skupine: način lastništva cone je users_only in cona "
"nima lastnikov uporabnikov. Najprej dodajte lastnika uporabnika."

#: lib/Application/Service/Zone/ZoneOwnershipMessages.php:58
#, php-format
msgid ""
"Cannot delete this group: it is the last owner of %s. Add another owner to "
