msgstr "Zadajte limit zón 0 alebo vyšší, alebo pole nechajte prázdne."

#: lib/Application/Service/Zone/ZoneLimitMessages.php:40
#, php-format
msgid ""
"%1$s owns %2$d zones, more than the zone limit of %3$d. The existing zones "
"are kept; new ones are refused."
msgstr "%1$s: počet vlastnených zón (%2$d) prekračuje limit zón (%3$d). Existujúce zóny zostanú zachované; nové budú odmietnuté."

#: lib/Application/Service/Zone/ZoneLimitMessages.php:57
msgid "You have reached your zone limit and cannot own more zones."
msgstr "Dosiahli ste limit zón a nemôžete vlastniť ďalšie zóny."

#: lib/Application/Service/Zone/ZoneLimitMessages.php:58
#, php-format
msgid "You can own %d more zone."
msgid_plural "You can own %d more zones."
msgstr[0] "Môžete vlastniť ešte %d zónu."
msgstr[1] "Môžete vlastniť ešte %d zóny."
msgstr[2] "Môžete vlastniť ešte %d zón."

#: lib/Domain/Service/Zone/ZoneLimitBreach.php:53
#, php-format
msgid "Zone limit reached: group %1$s owns %2$d of %3$d zones."
msgstr "Dosiahnutý limit zón (%2$d z %3$d): skupina %1$s."

#: lib/Domain/Service/Zone/ZoneLimitBreach.php:54
#, php-format
msgid "Zone limit reached: %1$s owns %2$d of %3$d zones."
msgstr "Dosiahnutý limit zón (%2$d z %3$d): %1$s."

