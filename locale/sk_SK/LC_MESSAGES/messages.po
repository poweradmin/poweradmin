msgstr "Importovať sekundárnu zónu"

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:112
msgid ""
"Zone ownership mode is groups_only but no groups exist. Create a group "
"before importing zones."
msgstr ""
"Režim vlastníctva zóny je groups_only, ale neexistujú žiadne skupiny. Pred "
"importom zón vytvorte skupinu."

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:113
msgid ""
"Zone ownership mode is groups_only but you are not a member of any group. "
"Ask an administrator to add you to a group before importing zones."
msgstr ""
"Režim vlastníctva zóny je groups_only, ale nie ste členom žiadnej skupiny. "
"Pred importom zón požiadajte administrátora, aby vás pridal do skupiny."

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:124
msgid "Zone name and primary server address are required."
msgstr "Názov zóny a adresa primárneho servera sú povinné."

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:164
msgid "Invalid zone."
msgstr "Neplatná zóna."

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:171
msgid ""
"This zone has no transferred records yet. Wait for the transfer to complete "
"before converting it to a primary zone."
msgstr ""
"Táto zóna zatiaľ nemá žiadne prenesené záznamy. Pred prevodom na primárnu "
"zónu počkajte na dokončenie prenosu."

