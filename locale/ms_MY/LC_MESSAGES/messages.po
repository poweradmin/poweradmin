#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:399
msgid "Invalid SRV target."
msgstr "Target SRV tidak sah."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:422
msgid "Invalid value for the priority field of the SRV record."
msgstr "Nilai tidak sah untuk bidang keutamaan dari rekod SRV."

#: lib/Domain/Service/DnsValidation/AAAARecordValidator.php:85
msgid ""
"Unspecified (::) or loopback (::1) IPv6 addresses should not be used in AAAA "
"records."
msgstr "Alamat-alamat IPv6 tidak dinyatakan (::) atau loopback (:1) IPv6 tidak boleh digunakan dalam rekod AAAA."

#: lib/Domain/Service/DnsValidation/AAAARecordValidator.php:90
msgid ""
"Site-local IPv6 addresses (fec0::/10) are deprecated and should not be used."
msgstr ""
"Alamat IPv6 Situs-lokal (fec0::/10) sudah usang dan tidak boleh digunakan."

#: lib/Domain/Service/DnsValidation/AAAARecordValidator.php:147
msgid ""
"Invalid value for priority field. AAAA records must have priority value of 0."
msgstr "Nilai yang tidak sah untuk bidang keutamaan. Rekod AAA harus memiliki nilai keutamaan 0."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:103
msgid ""
"NSEC3 record owner names should typically be a Base32hex encoded hash "
"followed by the zone name (e.g., "
"\"B4Q3JBMLEL2C7EMPGKUDAMPIP4DI4C2L.example.com\")."
msgstr "Nama pemilik rekod NSEC3 seharusnya biasanya adalah hash yang dikodekan Base32hex diikuti dengan nama zona (mis., \"B4Q3JBMLEL2C7EMPGKUDAMPIP4DI4C2L.example.com\")."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:108
msgid "NSEC3 record content cannot be empty."
msgstr "Kandungan rekod NSEC3 tidak dapat kosong."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:113
msgid "NSEC3 record contains invalid characters."
msgstr "Rekod NSEC3 berisi aksara tidak sah."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:142
msgid ""
"According to RFC 5155 and RFC 9077, NSEC3 records should have the same TTL "
"as the SOA minimum TTL field."
msgstr "Menurut RFC 5155 dan RFC 9077, rekod NSEC3 harus memiliki TTL yang sama dengan ladang TTL minimum SOA."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:145
msgid ""
"NSEC3 records are part of DNSSEC and should only be managed alongside other "
"DNSSEC records (DNSKEY, RRSIG, etc.)."
msgstr "Rekod NSEEC3 adalah bagian dari DNSSEC dan seharusnya hanya dikelola bersama dengan rekod DNSSEC lainnya (DNSKEY, RRSIG, dll)."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:146
msgid ""
"Manually editing NSEC3 records is not recommended as they are typically "
"generated automatically by DNSSEC-aware nameservers."
msgstr "Secara manual editing rekod NSEC3 tidak disarankan kerana biasanya dijangkitkan secara otomatis oleh server nama DNSSEC-aware."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:147
msgid ""
"NSEC3 records require a corresponding NSEC3PARAM record at the zone apex to "
"indicate the NSEC3 parameters in use."
msgstr "Rekod NSEC3 membutuhkan rekod NSEC3PARAM yang berhubungan di apex zona untuk menunjukkan parameter NSEC3 yang digunakan."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:207
msgid ""
"NSEC3 record must contain at least hash algorithm, flags, iterations, salt, "
"and next hashed owner name."
msgstr "Rekod NSEC3 harus mengandung setidaknya algoritma hash, flag, iterasi, garam, dan nama pemilik hashed berikutnya."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:213
msgid "NSEC3 hash algorithm must be 1 (SHA-1)."
msgstr "Algoritme hash NSEC3 harus 1 (SHA-1)."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:219
msgid "NSEC3 flags must be 0 or 1."
msgstr "Flag NSEC3 harus 0 atau 1."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:231
msgid "NSEC3 iterations must be between 0 and 2500."
msgstr "iterasi NSEC3 harus antara 0 dan 2500."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:248
msgid "NSEC3 salt must be - (for empty) or a hexadecimal value."
msgstr "Garam NSEC3 harus - (untuk kosong) atau nilai heksadesimal."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:264
msgid ""
"NSEC3 next hashed owner name must be a valid Base32hex encoded value (using "
"characters 0-9 and A-V)."
msgstr ""
"Nama pemilik hashed berikutnya NSEC3 harus merupakan nilai terenkod "
"Base32hex yang valid (menggunakan karakter 0-9 dan A-V)."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:281
msgid ""
"Type bit maps should be present to indicate which RR types exist at the "
"original owner name."
msgstr ""
"Peta bit Type harus hadir untuk menunjukkan jenis RR mana yang ada pada nama "
"pemilik asli."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:355
#, php-format
msgid "NSEC3 record contains an invalid record type: %s"
msgstr "Rekod NSEC3 berisi jenis rekod tidak sah: %s"

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:361
msgid ""
"RRSIG type should typically be present in NSEC3 type bit maps for DNSSEC-"
"signed zones."
msgstr "Jenis RRISIG biasanya harus hadir dalam peta bit jenis NSEC3 untuk zona DNSSEC-signed."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:366
msgid ""
"This NSEC3 record contains both SOA and NS types, indicating it might be for "
"a zone apex."
msgstr "Rekod NSEC3 ini berisi baik jenis SOA maupun NS, menunjukkan mungkin untuk apex zona."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:369
msgid ""
"For a zone apex using NSEC3, the NSEC3PARAM type should typically be present "
"along with DNSKEY."
msgstr ""
"Untuk apex zona menggunakan NSEC3, jenis NSEC3PARAM biasanya harus hadir "
"bersama dengan DNSKEY."

#: lib/Domain/Service/DnsValidation/StringValidator.php:46
msgid "Invalid characters have been used in this record."
msgstr "Aksara tidak sah dalam rekod ini telah digunakan."

#: lib/Domain/Service/DnsValidation/StringValidator.php:60
msgid "You cannot use html tags for this type of record."
msgstr "Anda tidak boleh menggunakan tag html untuk jenis rekod ini."

#: lib/Domain/Service/DnsValidation/StringValidator.php:105
msgid "Add quotes around TXT record content."
msgstr "Tambahkan kutipan di sekitar konten rekod TXT."

#: lib/Domain/Service/DnsValidation/StringValidator.php:156
msgid "Invalid domain name format."
msgstr "Format nama domain tidak sah."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:115
msgid ""
"This appears to be an ENUM domain. NAPTR records should use E2U service "
"field and follow RFC 6116."
msgstr "Ini tampaknya domain ENUM. Rekod NAPTR harus menggunakan medan layanan E2U dan mengikuti RFC 6116."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:147
msgid ""
"Complex regexp patterns in NAPTR records can be difficult to debug and "
"maintain."
msgstr "Pola regexp kompleks dalam rekod NAPTR dapat sulit untuk debug dan mempertahankan."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:151
msgid ""
"This record follows RFC 3403. Be aware that some DNS servers may not fully "
"support all NAPTR features."
msgstr "Rekod ini mengikuti RFC 3403. Wawaslah bahwa beberapa server DNS mungkin tidak sepenuhnya mendukung semua fitur NAPTR."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:182
msgid ""
"Invalid value for priority field. NAPTR records have priority within the "
"content field and must have a priority value of 0."
msgstr "Nilai yang tidak sah untuk bidang keutamaan. Rekod NAPTR BAHASA memiliki keutamaan di dalam bidang konten dan harus memiliki nilai keutamaan 0."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:201
msgid ""
"NAPTR record must contain order, preference, flags, service, regexp, and "
"replacement values."
msgstr "Rekod NAPTR BAHASA harus mengandung susunan, preferensi, bendera, layanan, regexp, dan nilai penggantian."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:208
msgid "NAPTR record order must be a number between 0 and 65535."
msgstr "Susunan rekod NAPTR HANAK harus berupa angka antara 0 dan 65535."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:213
msgid "NAPTR record preference must be a number between 0 and 65535."
msgstr "preferensi rekod HANAPTR harus berupa angka antara 0 dan 65535."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:219
msgid "NAPTR record flags must be a quoted string."
msgstr "Bendera rekod NAPTR harus berupa string yang dikutip."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:225
msgid "NAPTR record flags must contain only A, P, S, or U."
msgstr "Bendera rekod NAPTR harus hanya berisi A, P, S, atau U."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:237
msgid "NAPTR record service must be a quoted string."
msgstr "Layanan rekod NAPTR harus berupa string yang dikutip."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:256
msgid "NAPTR record regexp must be a quoted string."
msgstr "Regexp rekod NAPTR harus berupa string yang dikutip."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:276
msgid ""
"NAPTR record replacement must be either \".\" or a valid fully-qualified "
"domain name."
msgstr ""
"Penggantian rekod NAPTR mestilah \".\" atau nama domain layak sepenuhnya "
"yang sah."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:285
msgid "NAPTR record with a regexp must have \".\" as the replacement."
msgstr "Rekod NAPTR dengan regexp harus memiliki  \" .\" sebagai pengganti."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:331
msgid ""
"NAPTR service must follow the format: [protocol][+rs][+rs]... where protocol "
"and rs start with a letter and contain alphanumeric characters, hyphens, "
"colons, or plus signs (max 32 chars each)."
msgstr ""
"Layanan NAPTR harus mengikuti format: [protocol][+rs][+rs]... dimana "
"protokol dan rs dimulai dengan huruf dan berisi karakter alfanumerik, "
"hyphen, colon, atau tanda plus (maks 32 char masing-masing)."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:361
msgid ""
"Terminal flags \"S\", \"A\", \"U\", and \"P\" should not be combined with "
"other flags."
msgstr ""
"Flag Terminal  \"S\", \"A\",U\", dan \"P\" tidak boleh digabungkan dengan "
"bendera lain."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:383
msgid "NAPTR regexp must start with a delimiter character."
msgstr "NAPTR regexp harus dimulai dengan karakter pembatas."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:389
msgid ""
"NAPTR regexp must have the format "
"delimiter+pattern+delimiter+replacement+delimiter+flags."
msgstr ""
"NAPTR regexp harus memiliki format "
"pembatas+pattern+delimier+replacement+delimier+flags."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:396
msgid ""
"NAPTR regexp flags (after third delimiter) should only contain \"i\" or be "
"empty."
msgstr ""
"Bendera regexp NAPTR (setelah pembatas ketiga) seharusnya hanya berisi  "
"\"i\" atau kosong."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:414
msgid ""
"This appears to be an ENUM NAPTR record (RFC 6116). Ensure the domain is "
"under e164.arpa or a private ENUM tree."
msgstr "Ini tampaknya merupakan rekod ENUM NAPTR (RFC 6116). Kepastian domain berada di bawah e164.arpa atau pohon ENUM pribadi."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:415
msgid "ENUM records should have the \"U\" flag to indicate URI output."
msgstr "Rekod-rekod ENUM seharusnya memiliki bendera \"U\" untuk menunjukkan keluaran URI."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:442
msgid "NAPTR regexp contains potentially dangerous pattern: "
msgstr "NAPTR regexp mengandung pola berbahaya yang berpotensi:"

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:449
msgid "NAPTR regexp is too long. Maximum length is 1000 characters."
msgstr ""
