msgid "No SOA record present, or active, in zone. This is required for DNSSEC."
msgstr ""
"Няма наличен или активен SOA запис в зоната. Това се изисква за DNSSEC."

#: lib/Domain/Service/ZoneValidationService.php:103
msgid "Add an SOA record to the zone before attempting to sign it."
msgstr "Добавяне на запис на SOA в зоната, преди да се опита да го подпише."

#: lib/Domain/Service/ZoneValidationService.php:109
#, php-format
msgid "Zone has %d SOA records. Only one SOA record is allowed per zone."
msgstr "Зоната има %d SOA записи. Допуска се само един запис на SOA за зона."

#: lib/Domain/Service/ZoneValidationService.php:110
msgid "Remove duplicate SOA records, keeping only one."
msgstr "Премахване на дублираните записи на SOA, като се съхранява само един."

#: lib/Domain/Service/ZoneValidationService.php:121
#, php-format
msgid "SOA record not at apex. Found at \"%s\" but zone is \"%s\"."
msgstr "SOA записът не е в apex. Намерен е в \"%s\", но зоната е \"%s\"."

#: lib/Domain/Service/ZoneValidationService.php:122
msgid "Move the SOA record to the zone apex."
msgstr "Преместете SOA записа в apex на зоната."

#: lib/Domain/Service/ZoneValidationService.php:132
msgid "SOA record has invalid content format."
msgstr "Записът на SOA има невалиден формат за съдържание."

#: lib/Domain/Service/ZoneValidationService.php:133
msgid ""
"SOA format should be: primary-ns hostmaster serial refresh retry expire "
"minimum"
msgstr ""
"Форматът на SOA следва да бъде: primary-ns hostmaster serial refresh retry "
"expire minimum"

#: lib/Domain/Service/ZoneValidationService.php:184
msgid ""
"Zone has no NS (Name Server) records at the apex. At least one apex NS "
"record is required for DNSSEC."
msgstr ""
"Зоната няма NS (Name Server) записи в apex. За DNSSEC е необходим поне един "
"NS запис в apex."

#: lib/Domain/Service/ZoneValidationService.php:185
msgid "Add NS records at the zone apex for your authoritative name servers."
msgstr ""
"Добавяне на NS записи в apex на зоната за вашите авторитетни сървъри за "
"имена."

#: lib/Domain/Service/ZoneValidationService.php:231
