"Zone ownership mode is groups_only but no groups exist. Create a group "
"before importing zones."
msgstr ""
"Modul de proprietate a zonei este groups_only, dar nu există grupuri. Creați "
"un grup înainte de a importa zone."

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:144
msgid ""
"Zone ownership mode is groups_only but you are not a member of any group. "
"Ask an administrator to add you to a group before importing zones."
msgstr ""
"Modul de proprietate a zonei este groups_only, dar nu sunteți membru al "
"niciunui grup. Cereți unui administrator să vă adauge într-un grup înainte "
"de a importa zone."

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:155
msgid "Zone name and primary server address are required."
msgstr "Numele zonei și adresa serverului primar sunt obligatorii."

#: lib/Domain/Service/Dns/SupermasterManager.php:318
msgid "Invalid hostname."
msgstr "Nume gazdă invalid."

#: lib/Application/Controller/BulkRegistrationController.php:209
msgid "There is already a zone with this name."
msgstr "Există deja o zonă cu acest nume."

#: lib/Domain/Service/Dns/SupermasterManager.php:312
msgid "This is not a valid IPv4 or IPv6 address."
msgstr "Aceasta nu este o adresă IPv4 sau IPv6 validă."

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:202
msgid "Failed to create the secondary zone."
msgstr "Nu s-a putut crea zona secundară."

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:231
msgid "Invalid zone."
msgstr "Zonă invalidă."

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:238
msgid ""
"This zone has no transferred records yet. Wait for the transfer to complete "
"before converting it to a primary zone."
