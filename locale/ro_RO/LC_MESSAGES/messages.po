msgstr "Nu aveți permisiunea de a importa o zonă secundară."

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:62
#: lib/Module/SecondaryZoneImport/templates/import.html:111
msgid "Import secondary zone"
msgstr "Importă zonă secundară"

#: lib/Module/SecondaryZoneImport/Controller/SecondaryZoneImportController.php:139
