#: lib/Module/DnsWizard/Service/TLSAWizard.php:45
msgid "TLSA Record"
msgstr "Rekord TLSA"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:46
msgid "TLS certificate/key authentication (DANE)"
msgstr "Uwierzytelnianie certyfikatu/klucza TLS (DANE)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:57
msgid "DNSSEC Requirement"
msgstr "Wymaganie DNSSEC"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:59
msgid ""
"TLSA records require DNSSEC to be enabled for this zone. TLSA records "
"without DNSSEC will not provide security benefits and may be ignored by "
"clients."
msgstr ""
"Rekordy TLSA wymagają włączenia DNSSEC dla tej strefy. Rekordy TLSA bez "
"DNSSEC nie zapewnią korzyści bezpieczeństwa i mogą być ignorowane przez "
"klientów."

#: lib/Module/DnsWizard/Service/SRVWizard.php:91
msgid "Service Configuration"
msgstr "Konfiguracja usługi"

#: lib/Module/DnsWizard/Service/SRVWizard.php:148
msgid "Port Number"
msgstr "Numer portu"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:72
msgid ""
"TCP/UDP port number (443 for HTTPS, 25 for SMTP, 853 for DNS-over-TLS, etc.)"
msgstr ""
"Numer portu TCP/UDP (443 dla HTTPS, 25 dla SMTP, 853 dla DNS-over-TLS itp.)"

#: lib/Module/DnsWizard/Service/SRVWizard.php:113
msgid "Protocol"
msgstr "Protokół"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:81
msgid "Transmission Control Protocol - most common for HTTPS/TLS"
msgstr "Transmission Control Protocol - najczęściej dla HTTPS/TLS"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:82
msgid "User Datagram Protocol - for DTLS connections"
msgstr "User Datagram Protocol - dla połączeń DTLS"

#: lib/Module/DnsWizard/Service/SRVWizard.php:121
msgid "Stream Control Transmission Protocol"
msgstr "Stream Control Transmission Protocol"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:85
msgid "Transport protocol for the TLS connection"
msgstr "Protokół transportowy dla połączenia TLS"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:89
#: install/templates/step4.html.twig:140
msgid "Hostname"
msgstr "Nazwa hosta"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:93
msgid ""
"Hostname for the service (leave empty for zone apex @). Record will be "
"created at _port._protocol.hostname"
msgstr ""
"Nazwa hosta dla usługi (pozostaw puste dla wierzchołka strefy @). Rekord "
"zostanie utworzony w _port._protocol.hostname"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:98
msgid "Certificate Usage"
msgstr "Użycie certyfikatu"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:102
msgid "Usage"
msgstr "Użycie"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:107
msgid "0 - CA Constraint"
msgstr "0 - Ograniczenie CA"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:107
msgid "Certificate must chain to specified CA (PKIX-TA)"
msgstr "Certyfikat musi łączyć się z określonym CA (PKIX-TA)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:108
msgid "1 - Service Certificate"
msgstr "1 - Certyfikat usługi"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:108
msgid "Certificate must match exactly (PKIX-EE)"
msgstr "Certyfikat musi dokładnie pasować (PKIX-EE)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:109
msgid "2 - Trust Anchor Assertion"
msgstr "2 - Asercja kotwicy zaufania"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:109
msgid "Certificate must chain to specified anchor (DANE-TA)"
msgstr "Certyfikat musi łączyć się z określoną kotwicą (DANE-TA)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:110
msgid "3 - Domain-Issued Certificate"
msgstr "3 - Certyfikat wydany przez domenę"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:110
msgid "Certificate must match exactly, bypassing PKI (DANE-EE)"
msgstr "Certyfikat musi dokładnie pasować, omijając PKI (DANE-EE)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:112
msgid ""
"How the certificate should be validated. Type 3 is most common for self-"
"signed or custom CAs."
msgstr ""
"Jak certyfikat powinien być walidowany. Typ 3 jest najczęstszy dla "
"certyfikatów self-signed lub własnych CA."

#: lib/Module/DnsWizard/Service/DKIMWizard.php:72
msgid "Selector"
msgstr "Selektor"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:126
msgid "0 - Full Certificate"
msgstr "0 - Pełny certyfikat"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:126
msgid "Use the entire certificate"
msgstr "Użyj całego certyfikatu"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:127
msgid "1 - Public Key"
msgstr "1 - Klucz publiczny"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:127
msgid "Use only the Subject Public Key Info (SPKI)"
msgstr "Użyj tylko Subject Public Key Info (SPKI)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:129
msgid ""
"What part of the certificate to match. Type 1 (public key) survives "
"certificate renewal."
msgstr ""
"Którą część certyfikatu dopasować. Typ 1 (klucz publiczny) przetrwa "
"odnowienie certyfikatu."

#: lib/Module/DnsWizard/Service/TLSAWizard.php:138
msgid "Matching Type"
msgstr "Typ dopasowania"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:143
msgid "0 - Exact Match"
msgstr "0 - Dokładne dopasowanie"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:143
msgid "Full certificate/key data (very long record)"
msgstr "Pełne dane certyfikatu/klucza (bardzo długi rekord)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:144
msgid "1 - SHA-256 Hash"
msgstr "1 - Hash SHA-256"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:144
msgid "SHA-256 hash of certificate/key"
msgstr "Hash SHA-256 certyfikatu/klucza"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:145
msgid "2 - SHA-512 Hash"
msgstr "2 - Hash SHA-512"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:145
msgid "SHA-512 hash of certificate/key (more secure but longer)"
msgstr "Hash SHA-512 certyfikatu/klucza (bezpieczniejszy ale dłuższy)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:147
msgid ""
"How to encode the certificate data. SHA-256 (type 1) provides good balance "
"of security and length."
msgstr ""
"Jak zakodować dane certyfikatu. SHA-256 (typ 1) zapewnia dobrą równowagę "
"bezpieczeństwa i długości."

#: lib/Module/DnsWizard/Service/TLSAWizard.php:152
msgid "Certificate Data"
msgstr "Dane certyfikatu"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:156
msgid "Certificate Association Data"
msgstr "Dane asocjacji certyfikatu"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:161
msgid ""
"Hexadecimal hash or full certificate data (depending on matching type). For "
"SHA-256: use \"openssl x509 -in cert.pem -pubkey -noout | openssl pkey "
"-pubin -outform DER | openssl dgst -sha256\""
msgstr ""
"Hash szesnastkowy lub pełne dane certyfikatu (w zależności od typu "
"dopasowania). Dla SHA-256: użyj \"openssl x509 -in cert.pem -pubkey -noout | "
"openssl pkey -pubin -outform DER | openssl dgst -sha256\""

#: lib/Module/DnsWizard/Service/SRVWizard.php:184
msgid "Record Settings"
msgstr "Ustawienia rekordu"

#: lib/Module/DnsWizard/Service/SRVWizard.php:188
msgid "TTL (seconds)"
msgstr "TTL (sekundy)"

#: lib/Module/DnsWizard/Service/SRVWizard.php:193
msgid "Time to live - how long DNS resolvers should cache this record"
msgstr "Time to live - jak długo resolvery DNS powinny buforować ten rekord"

#: lib/Module/DnsWizard/Service/SRVWizard.php:289
msgid "Port must be between 1 and 65535"
msgstr "Port musi być między 1 a 65535"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:233
msgid "Usage must be 0, 1, 2, or 3"
msgstr "Użycie musi wynosić 0, 1, 2 lub 3"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:238
msgid "Selector must be 0 or 1"
msgstr "Selektor musi wynosić 0 lub 1"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:243
msgid "Matching type must be 0, 1, or 2"
msgstr "Typ dopasowania musi wynosić 0, 1 lub 2"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:248
msgid "Certificate association data is required"
msgstr "Dane asocjacji certyfikatu są wymagane"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:253
msgid "Certificate data must be hexadecimal (0-9, a-f)"
msgstr "Dane certyfikatu muszą być szesnastkowe (0-9, a-f)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:259
#, php-format
msgid ""
"SHA-256 hash should be 64 hexadecimal characters, got %d. Verify the hash is "
"correct."
msgstr ""
"Hash SHA-256 powinien mieć 64 znaki szesnastkowe, otrzymano %d. Sprawdź, czy "
"hash jest prawidłowy."

#: lib/Module/DnsWizard/Service/TLSAWizard.php:263
#, php-format
msgid ""
"SHA-512 hash should be 128 hexadecimal characters, got %d. Verify the hash "
"is correct."
msgstr ""
"Hash SHA-512 powinien mieć 128 znaków szesnastkowych, otrzymano %d. Sprawdź, "
"czy hash jest prawidłowy."

#: lib/Module/DnsWizard/Service/TLSAWizard.php:267
msgid ""
"Full certificate data seems too short. Ensure you provided the complete "
"certificate."
msgstr ""
"Pełne dane certyfikatu wydają się zbyt krótkie. Upewnij się, że podałeś "
"kompletny certyfikat."

#: lib/Module/DnsWizard/Service/TLSAWizard.php:274
#: templates/modern/edit.html:79 templates/modern/edit.html:684
msgid "Invalid hostname format"
msgstr "Nieprawidłowy format nazwy hosta"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:278
msgid ""
"CRITICAL: TLSA records require DNSSEC to be enabled on this zone. Without "
"DNSSEC, TLSA records provide NO security benefit."
msgstr ""
"KRYTYCZNE: Rekordy TLSA wymagają włączenia DNSSEC w tej strefie. Bez DNSSEC "
"rekordy TLSA NIE zapewniają żadnych korzyści bezpieczeństwa."

#: lib/Module/DnsWizard/Service/DMARCWizard.php:44
msgid "DMARC Record"
msgstr "Rekord DMARC"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:45
msgid "Email authentication policy and reporting configuration"
msgstr "Polityka uwierzytelniania e-mail i konfiguracja raportowania"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:56
msgid "Policy Settings"
msgstr "Ustawienia polityki"

#: lib/Module/DnsWizard/Service/SPFWizard.php:135
msgid "Policy"
msgstr "Polityka"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:65
msgid "None (monitor only)"
msgstr "Brak (tylko monitoring)"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:65
msgid "No action taken, just collect reports for analysis"
msgstr "Nie podejmuj działań, po prostu zbieraj raporty do analizy"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:80
msgid "Quarantine"
msgstr "Kwarantanna"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:66
msgid "Treat suspicious emails as spam/junk"
msgstr "Traktuj podejrzane e-maile jako spam"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:81
msgid "Reject"
msgstr "Odrzuć"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:67
msgid "Block delivery of suspicious emails entirely"
msgstr "Całkowicie zablokuj dostarczanie podejrzanych e-maili"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:69
msgid "Start with \"none\" to collect data before enforcing a stricter policy."
msgstr ""
"Zacznij od \"brak\", aby zbierać dane przed wymuszeniem surowszej polityki."

#: lib/Module/DnsWizard/Service/DMARCWizard.php:73
msgid "Subdomain Policy"
msgstr "Polityka subdomen"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:78
msgid "Same as domain policy"
msgstr "Taka sama jak polityka domeny"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:78
msgid "Use the same policy as the main domain"
msgstr "Użyj tej samej polityki co główna domena"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:79
msgid "None"
msgstr "Brak"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:79
msgid "Monitor only for subdomains"
msgstr "Tylko monitoring dla subdomen"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:80
msgid "Quarantine suspicious subdomain emails"
msgstr "Kwarantanna podejrzanych e-maili z subdomen"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:81
msgid "Reject suspicious subdomain emails"
msgstr "Odrzuć podejrzane e-maile z subdomen"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:83
msgid "Policy for emails from subdomains (e.g., mail.example.com)"
msgstr "Polityka dla e-maili z subdomen (np. mail.example.com)"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:87
msgid "Policy Application Percentage"
msgstr "Procent zastosowania polityki"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:93
msgid ""
"Percentage of messages to which the policy should apply (100 = all "
"messages). Use lower values during policy rollout."
msgstr ""
"Procent wiadomości, do których polityka powinna się stosować (100 = "
"wszystkie wiadomości). Użyj niższych wartości podczas wdrażania polityki."

#: lib/Module/DnsWizard/Service/DMARCWizard.php:98
msgid "Reporting Settings"
msgstr "Ustawienia raportowania"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:102
msgid "Aggregate Report Email"
msgstr "E-mail raportu zbiorczego"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:106
msgid "Email address to receive daily aggregate reports"
msgstr "Adres e-mail do otrzymywania dziennych raportów zbiorczych"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:110
msgid "Forensic Report Email"
msgstr "E-mail raportu szczegółowego"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:114
msgid ""
"Email address to receive detailed failure reports (optional, can be high "
"volume)"
msgstr ""
"Adres e-mail do otrzymywania szczegółowych raportów błędów (opcjonalnie, "
"może być duża objętość)"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:118
msgid "Forensic Reporting Options"
msgstr "Opcje raportowania szczegółowego"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:122
msgid "Generate reports if all authentication mechanisms fail"
msgstr "Generuj raporty, jeśli wszystkie mechanizmy uwierzytelniania zawiodą"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:123
msgid "Generate reports if any authentication mechanism fails"
msgstr ""
"Generuj raporty, jeśli jakikolwiek mechanizm uwierzytelniania zawiedzie"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:124
msgid "Generate reports if DKIM check fails"
msgstr "Generuj raporty, jeśli sprawdzenie DKIM zawiedzie"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:125
msgid "Generate reports if SPF check fails"
msgstr "Generuj raporty, jeśli sprawdzenie SPF zawiedzie"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:127
msgid ""
"When to generate forensic reports (only applies if forensic email is set)"
msgstr ""
"Kiedy generować raporty szczegółowe (dotyczy tylko, jeśli ustawiono e-mail "
"szczegółowy)"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:132
msgid "Alignment Settings"
msgstr "Ustawienia wyrównania"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:133
msgid "Advanced settings for SPF and DKIM alignment modes"
msgstr "Zaawansowane ustawienia dla trybów wyrównania SPF i DKIM"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:137
msgid "DKIM Alignment Mode"
msgstr "Tryb wyrównania DKIM"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:153
msgid "Relaxed"
msgstr "Złagodzony"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:142
msgid "DKIM domain can be subdomain of From: domain"
msgstr "Domena DKIM może być subdomeną domeny Od:"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:154
msgid "Strict"
msgstr "Ścisły"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:143
msgid "DKIM domain must exactly match From: domain"
msgstr "Domena DKIM musi dokładnie pasować do domeny Od:"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:148
msgid "SPF Alignment Mode"
msgstr "Tryb wyrównania SPF"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:153
msgid "SPF domain can be subdomain of From: domain"
msgstr "Domena SPF może być subdomeną domeny Od:"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:154
msgid "SPF domain must exactly match From: domain"
msgstr "Domena SPF musi dokładnie pasować do domeny Od:"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:258
msgid "Policy is required"
msgstr "Polityka jest wymagana"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:260
msgid "Invalid policy value"
msgstr "Nieprawidłowa wartość polityki"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:265
msgid "Invalid subdomain policy value"
msgstr "Nieprawidłowa wartość polityki subdomeny"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:272
msgid "Percentage must be between 0 and 100"
msgstr "Procent musi być między 0 a 100"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:274
#, php-format
msgid ""
"Policy will only apply to %d%% of messages. Use 100%% once testing is "
"complete."
msgstr ""
"Polityka będzie stosowana tylko do %d%% wiadomości. Użyj 100%%, gdy testy "
"zostaną zakończone."

#: lib/Module/DnsWizard/Service/DMARCWizard.php:280
msgid "Invalid aggregate report email address"
msgstr "Nieprawidłowy adres e-mail raportu zbiorczego"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:284
msgid "Invalid forensic report email address"
msgstr "Nieprawidłowy adres e-mail raportu szczegółowego"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:289
msgid ""
"No reporting email addresses configured. You will not receive DMARC reports."
msgstr ""
"Nie skonfigurowano adresów e-mail raportowania. Nie otrzymasz raportów DMARC."

#: lib/Module/DnsWizard/Service/DMARCWizard.php:302
msgid ""
"Using \"p=none\" provides monitoring only. Consider stricter policy "
"(quarantine/reject) once you've reviewed reports."
msgstr ""
"Użycie \"p=none\" zapewnia tylko monitoring. Rozważ surowszą politykę "
"(kwarantanna/odrzuć), gdy przejrzysz raporty."

#: lib/Module/DnsWizard/Service/SPFWizard.php:46
msgid "SPF Record"
msgstr "Rekord SPF"

#: lib/Module/DnsWizard/Service/SPFWizard.php:47
msgid "Authorized mail server configuration"
msgstr "Konfiguracja autoryzowanych serwerów pocztowych"

#: lib/Module/DnsWizard/Service/SPFWizard.php:58
msgid "Basic Mechanisms"
msgstr "Podstawowe mechanizmy"

#: lib/Module/DnsWizard/Service/SPFWizard.php:59
msgid "Select common mechanisms to authorize email sending"
msgstr "Wybierz typowe mechanizmy do autoryzacji wysyłania e-maili"

#: lib/Module/DnsWizard/Service/SPFWizard.php:63
msgid "MX Records"
msgstr "Rekordy MX"

#: lib/Module/DnsWizard/Service/SPFWizard.php:66
msgid "Authorize all servers listed in MX records for this domain"
msgstr "Autoryzuj wszystkie serwery wymienione w rekordach MX dla tej domeny"

#: lib/Module/DnsWizard/Service/SPFWizard.php:70
msgid "A/AAAA Records"
msgstr "Rekordy A/AAAA"

#: lib/Module/DnsWizard/Service/SPFWizard.php:73
msgid "Authorize the domain's A and AAAA records"
msgstr "Autoryzuj rekordy A i AAAA domeny"

#: lib/Module/DnsWizard/Service/SPFWizard.php:78
msgid "IP Addresses"
msgstr "Adresy IP"

#: lib/Module/DnsWizard/Service/SPFWizard.php:79
msgid "Authorized IP addresses and networks (CIDR notation supported)"
msgstr "Autoryzowane adresy IP i sieci (obsługiwana notacja CIDR)"

