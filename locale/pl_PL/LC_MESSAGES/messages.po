msgstr "Ten rekord domeny był nieprawidłowy i nie mógł zostać dodany."

#: lib/Domain/Service/DomainRecordCreator.php:132
msgid "The domain record was successfully added."
msgstr "Rekord domeny został pomyślnie dodany."

