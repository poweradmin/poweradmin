#, php-format
msgid "SOA record not at apex. Found at \"%s\" but zone is \"%s\"."
msgstr "רשומת SOA אינה ב-apex. נמצאה ב-\"%s\" אך האזור הוא \"%s\"."

#: lib/Domain/Service/ZoneValidationService.php:122
msgid "Move the SOA record to the zone apex."
msgstr "העבר את רשומת ה-SOA ל-apex של האזור."

#: lib/Domain/Service/ZoneValidationService.php:132
msgid "SOA record has invalid content format."
msgstr "לרשומת SOA יש פורמט תוכן לא חוקי."

#: lib/Domain/Service/ZoneValidationService.php:133
msgid ""
"SOA format should be: primary-ns hostmaster serial refresh retry expire "
