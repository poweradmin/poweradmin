msgid "A record with this hostname, type, and content already exists."
msgstr "רשומה עם שם מארח, סוג ותוכן אלה כבר קיימת."

#: lib/Domain/Service/Dns/RecordManager.php:222
msgid "Failed to add record to DNS backend."
msgstr "נכשל להוסיף רשומות ל- DNS backend."

#: lib/Domain/Service/Dns/RecordManager.php:456
