#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:111
msgid "Priority field for IPSECKEY records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות IPSECKEY חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:116
msgid ""
"IPSECKEY records should be used with DNSSEC to ensure secure transmission of "
"keying material (RFC 4025 Section 4)."
msgstr ""
"יש להשתמש ברשומות IPSECKEY יחד עם DNSSEC כדי להבטיח שידור מאובטח של חומר "
"מפתח (RFC 4025 סעיף 4)."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:117
msgid ""
"The public key in IPSECKEY records should be regularly rotated for improved "
"security."
msgstr "יש להחליף את המפתח הציבורי ברשומות IPSECKEY באופן קבוע לשיפור האבטחה."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:126
msgid ""
"When using domain name gateways, ensure both forward and reverse DNS records "
"exist and are properly secured with DNSSEC."
msgstr ""
"בעת שימוש בשערי שם דומיין, יש להבטיח את רשומות ה- DNS קדימה והפוך קיימות "
"ומאובטחים כראוי עם DNSSEC."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:154
msgid "Invalid characters in IPSECKEY record content."
msgstr "תווים לא חוקיים בתוכן רשומת IPSECKEY."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:160
msgid ""
"IPSECKEY record must contain precedence, gateway type, algorithm, gateway, "
"and public key."
msgstr ""
"רשומת IPSECKEY חייבת להכיל עדיפות, סוג שער, אלגוריתם, שער ומפתח ציבורי."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:169
msgid "IPSECKEY precedence must be a number between 0 and 255."
msgstr "עדיפות IPSECKEY חייבת להיות מספר בין 0 ל-255."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:175
msgid ""
"IPSECKEY gateway type must be 0 (No gateway), 1 (IPv4), 2 (IPv6), or 3 "
"(Domain name)"
msgstr ""
"סוג שער IPSECKEY חייב להיות 0 (ללא שער), 1 (IPv4), 2 (IPv6), או 3 (שם דומיין)"

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:181
msgid ""
"IPSECKEY algorithm must be 0 (No key), 1 (RSA), 2 (DSA), 3 (ECDSA), or 4 "
"(Ed25519)."
msgstr ""
"אלגוריתם IPSECKEY חייב להיות 0 (ללא מפתח), 1 (RSA), 2 (DSA), 3 (ECDSA), או 4 "
"(Ed25519)."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:188
msgid "For gateway type 0 (No gateway), gateway must be \".\"."
msgstr "עבור סוג שער 0 (ללא שער), השער חייב להיות \".\"."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:195
msgid "For gateway type 1, gateway must be a valid IPv4 address."
msgstr "עבור סוג שער 1, שער חייב להיות כתובת IPv4 בתוקף."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:202
msgid "For gateway type 2, gateway must be a valid IPv6 address."
msgstr "עבור סוג השער 2, שער חייב להיות כתובת IPv6 בתוקף."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:212
msgid "For gateway type 3, gateway must be a valid domain name."
msgstr "עבור סוג השער 3, שער חייב להיות שם דומיין חוקי."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:221
msgid "IPSECKEY public key is required when algorithm is not 0."
msgstr "מפתח ציבורי IPSECKEY נדרש כאשר האלגוריתם אינו 0."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:226
msgid "IPSECKEY public key must be properly Base64 encoded."
msgstr "מפתח ציבורי IPSECKEY חייב להיות מקודד כראוי ב-Base64."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:233
msgid "RSA keys should follow the format defined in RFC 3110."
msgstr "מפתחות RSA צריכים לעקוב אחר התבנית המוגדרת ב-RFC 3110."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:237
msgid "DSA keys should follow the format defined in RFC 2536."
msgstr "מפתחות DSA צריכים לעקוב אחר התבנית המוגדרת ב-RFC 2536."

#: lib/Domain/Service/DnsValidation/IPSECKEYRecordValidator.php:242
msgid ""
"When algorithm is 0 (No key), the public key field is typically empty or "
"ignored."
msgstr ""
"כאשר האלגוריתם הוא 0 (ללא מפתח), שדה המפתח הציבורי הוא בדרך כלל ריק או "
"שמתעלמים ממנו."

#: lib/Domain/Service/DnsValidation/HHITRecordValidator.php:54
msgid "HHIT record content must be a non-empty base64-encoded blob."
msgstr "תוכן רשומת HHIT חייב להיות בלוב מקודד base64 שאינו ריק."

#: lib/Domain/Service/DnsValidation/HHITRecordValidator.php:68
msgid "Priority must be 0 for HHIT records."
msgstr "העדיפות חייבת להיות 0 עבור רשומות HHIT."

#: lib/Domain/Service/Template/ZoneTemplateRecordService.php:179
msgid "Priority for MX/SRV records must be a number between 0 and 65535."
msgstr "עדיפות עבור רשומות MX/SRV חייב להיות מספר בין 0 ל 65535."

#: lib/Domain/Service/DnsValidation/DnsCommonValidator.php:84
msgid ""
"You can not point a NS or MX record to a CNAME record. Remove or rename the "
"CNAME record first, or take another name."
msgstr ""
"אינך יכול להפנות רשומת NS או MX לרשומת CNAME. הסר או שנה את שם רשומת ה-CNAME "
"תחילה, או בחר שם אחר."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:100
msgid "Invalid characters in hostname."
msgstr "תווים לא חוקיים בשם המארח."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:116
msgid ""
"Name appears to be in SRV record format. For TLSA with SRV (RFC 7673), "
"ensure:"
msgstr "השם נראה בפורמט של רשומת SRV. עבור TLSA עם SRV (RFC 7673), יש לוודא:"

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:117
msgid "1. The entire chain of SRV lookups must be DNSSEC-signed"
msgstr "1. כל שרשרת חיפושי ה-SRV חייבת להיות חתומה ב-DNSSEC"

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:118
msgid ""
"2. TLSA records should be found at _$port._$protocol.$hostname where $port, "
"$protocol, and $hostname are from the target of SRV lookup"
msgstr ""
"2. רשומות TLSA צריכות להימצא ב-_$port._$protocol.$hostname כאשר $port, "
"$protocol ו-$hostname לקוחים מהיעד של חיפוש ה-SRV"

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:119
msgid ""
"3. Both SRV and TLSA records must have DNSSEC validation status \"secure\""
msgstr ""
"3. גם רשומות SRV וגם רשומות TLSA חייבות להיות במצב אימות DNSSEC \"secure\""

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:122
msgid ""
"TLSA record name should typically follow the format _port._protocol.hostname "
"(e.g., _443._tcp.www.example.com)."
msgstr ""
"שם רשומת TLSA צריך בדרך כלל לעקוב אחר הפורמט _port._protocol.hostname (למשל, "
"_443._tcp.www.example.com)."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:127
msgid ""
"TLSA record is using a non-standard protocol. Common protocols are tcp, udp, "
"and sctp."
msgstr ""
"רשומות TLSA משתמשות בפרוטוקול לא סטנדרטי. פרוטוקולים נפוצים הם tcp, udp, ו "
"sctp."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:137
msgid ""
"This appears to be a TLSA record for SMTP. Ensure MX records are also "
"configured correctly."
msgstr "זה נראה כמו רשומת TLSA עבור SMTP. ודא שגם רשומות ה-MX מוגדרות כראוי."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:139
msgid ""
"This appears to be a TLSA record for HTTPS. Ensure the certificate matches "
"the domain in the TLSA record."
msgstr ""
"זה נראה כמו רשומת TLSA עבור HTTPS. ודא שהתעודה תואמת את הדומיין ברשומת "
"ה-TLSA."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:141
msgid ""
"This appears to be a TLSA record for DNS over TLS. Ensure your DNS server is "
"properly configured for DoT."
msgstr ""
"זה נראה כמו רשומת TLSA עבור DNS מעל TLS. ודא ששרת ה-DNS שלך מוגדר כראוי עבור "
"DoT."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:147
msgid ""
"CRITICAL: TLSA records REQUIRE DNSSEC to provide any security benefits. "
"Ensure your domain is DNSSEC-signed."
msgstr ""
"קריטי: רשומות TLSA מחייבות DNSSEC כדי לספק יתרונות אבטחה כלשהם. ודא שהדומיין "
"שלך חתום ב-DNSSEC."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:150
msgid ""
"If using CNAMEs, ensure the entire CNAME chain is DNSSEC-signed for TLSA to "
"work correctly (RFC 7671)."
msgstr ""
"אם משתמשים ב-CNAME, ודאו שכל שרשרת ה-CNAME חתומה ב-DNSSEC כדי ש-TLSA יעבוד "
"כראוי (RFC 7671)."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:154
msgid "This appears to be an SMIMEA record (RFC 8162) for S/MIME certificates."
msgstr "זה נראה כמו רשומת SMIMEA (RFC 8162) עבור תעודות S/MIME."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:155
msgid ""
"SMIMEA records use the same format as TLSA but associate S/MIME certificates "
"with email addresses."
msgstr ""
"רשומות SMIMEA משתמשות באותו פורמט כמו TLSA אך מקשרות תעודות S/MIME לכתובות "
"דוא\"ל."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:156
msgid ""
"The local part of an email address is hashed with SHA-256 and placed before "
"_smimecert.<domain>"
msgstr ""
"החלק המקומי של כתובת דוא\"ל עובר גיבוב עם SHA-256 וממוקם לפני _smimecert."
"<domain>"

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:168
msgid ""
"TLSA records should typically be placed at \"_port._protocol.hostname\" "
"(e.g., \"_443._tcp.www.example.com\")."
msgstr ""
"רשומות TLSA צריכות בדרך כלל להיות ממוקמות ב-\"_port._protocol.hostname\" "
"(למשל, \"_443._tcp.www.example.com\")."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:193
msgid ""
"Invalid value for priority field. TLSA records must have priority value of 0."
msgstr ""
"ערך לא חוקי בשדה העדיפות. רשומות TLSA חייבות להיות בעלות ערך עדיפות של 0."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:220
msgid ""
"TLSA record must contain usage, selector, matching-type, and certificate-"
"data separated by spaces."
msgstr ""
"רשומת TLSA חייבת להכיל usage, selector, matching-type ו-certificate-data "
"מופרדים ברווחים."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:231
msgid "TLSA usage field must be a number between 0 and 3."
msgstr "שדה השימוש של TLSA חייב להיות מספר בין 0 ל 3."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:237
msgid ""
"Usage 0 (PKIX-TA) requires proper CA certificate management and may break "
"when certificates expire."
msgstr ""
"שימוש 0 (PKIX-TA) דורש ניהול נכון של אישורי CA ועלול להישבר כאשר האישורים "
"יפוגו."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:239
msgid ""
"Usage 1 (PKIX-EE) depends on both DANE and traditional PKIX validation. May "
"break when certificates expire."
msgstr ""
"שימוש 1 (PKIX-EE) תלוי באימות DANE ו- PKIX המסורתי. יכול להישבר כאשר "
"האישורים יפוגו."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:241
msgid ""
"Usage 2 (DANE-TA) requires proper trust anchor management and may break when "
"certificates expire."
msgstr ""
"שימוש 2 (DANE-TA) דורש ניהול נכון של עוגן אמון ועלול להישבר כאשר האישורים "
"יפוגו."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:243
msgid ""
"Usage 3 (DANE-EE) is recommended by RFC 7671 as it is not affected by "
"certificate expiration or CA validation issues."
msgstr ""
"שימוש 3 (DANE-EE) מומלץ על ידי RFC 7671 מכיוון שהוא אינו מושפע מפקיעת "
"אישורים או מבעיות אימות CA."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:248
msgid ""
"RFC 7671 recommends usage=3 (DANE-EE), selector=1 (SPKI), matching-type=1 "
"(SHA-256) as the most robust configuration."
msgstr ""
"RFC 7671 ממליץ על usage=3 (DANE-EE), selector=1 (SPKI), matching-type=1 "
"(SHA-256) כתצורה החזקה ביותר."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:255
msgid ""
"TLSA selector field must be 0 (Full certificate) or 1 (SubjectPublicKeyInfo)."
msgstr ""
"שדה הבורר של TLSA חייב להיות 0 (תעודה מלאה) או 1 (SubjectPublicKeyInfo)."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:261
msgid ""
"Selector 0 (Full certificate) may break when certificate attributes change. "
"Selector 1 (SPKI) is recommended."
msgstr ""
"בורר 0 (תעודה מלאה) עלול להישבר כאשר תכונות התעודה משתנות. בורר 1 (SPKI) "
"מומלץ."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:269
msgid ""
"TLSA matching type field must be 0 (Exact match), 1 (SHA-256), or 2 "
"(SHA-512)."
msgstr ""
"שדה סוג ההתאמה של TLSA חייב להיות 0 (התאמה מדויקת), 1 (SHA-256), או 2 "
"(SHA-512)."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:275
msgid ""
"Matching-type 0 (Exact match) is not recommended. SHA-256 (1) provides "
"better compatibility and security."
msgstr ""
"matching-type 0 (התאמה מדויקת) אינו מומלץ. SHA-256 (1) מספק תאימות ואבטחה "
"טובות יותר."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:280
msgid "TLSA certificate data must be a hexadecimal string."
msgstr "נתוני התעודה של TLSA חייבים להיות מחרוזת הקסדצימלית."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:286
msgid "TLSA SHA-256 certificate data must be 64 characters long."
msgstr "נתוני התעודה של TLSA SHA-256 חייבים להיות באורך 64 תווים."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:288
msgid "TLSA SHA-512 certificate data must be 128 characters long."
msgstr "נתוני האישור של TLSA SHA-512 חייבים להיות באורך 128 תווים."

#: lib/Domain/Service/DnsValidation/TLSARecordValidator.php:291
msgid "TLSA exact match certificate data seems too short to be valid."
msgstr ""
"נתוני האישור של התאמה מדויקת (exact match) ב-TLSA נראים קצרים מדי מכדי להיות "
"תקפים."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:98
msgid ""
"NSEC3PARAM records MUST only be present at the zone apex (root domain, not "
"subdomain)."
msgstr ""
"רשומות NSEC3PARAM חייבות להיות נוכחים רק באזור apex (בסיס דומיין, לא תת-"
"דומיין)."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:103
msgid "NSEC3PARAM record content cannot be empty."
msgstr "תוכן רשומת NSEC3PARAM אינו יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:108
msgid "NSEC3PARAM record contains invalid characters."
msgstr "רשומת NSEC3PARAM מכילה תווים לא חוקיים."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:137
msgid ""
"According to RFC 5155 and RFC 9077, NSEC3PARAM records should have the same "
"TTL as the SOA minimum TTL field."
msgstr ""
"על פי RFC 5155 ו RFC 9077, רשומות NSEC3PARAM צריכות להיות אותו TTL כמו שדה "
"TTL מינימלי SOA."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:140
msgid ""
"NSEC3PARAM records are part of DNSSEC and should only be managed alongside "
"other DNSSEC records (DNSKEY, RRSIG, etc.)."
msgstr ""
"רשומות NSEC3PARAM הן חלק מ-DNSSEC ויש לנהל רק לצד רשומות DNSSEC אחרות "
"(DNSKEY, RRSIG וכו ')."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:141
msgid ""
"Manually editing NSEC3PARAM records is not recommended as they are typically "
"generated automatically by DNSSEC-aware nameservers."
msgstr ""
"עריכה ידנית של רשומות NSEC3PARAM אינה מומלצת, מכיוון שהן נוצרות בדרך כלל "
"באופן אוטומטי על ידי שרתי שמות מודעי DNSSEC."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:142
msgid ""
"NSEC3PARAM records indicate to authoritative servers which parameters to use "
"for NSEC3-based authenticated denial of existence."
msgstr ""
"רשומות NSEC3PARAM מציינות לשרתים הסמכותיים באילו פרמטרים להשתמש עבור הכחשת "
"קיום מאומתת המבוססת על NSEC3."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:143
msgid ""
"When updating NSEC3 parameters, both NSEC3 and NSEC3PARAM records must be re-"
"generated with the same parameters."
msgstr ""
"בעת עדכון NSEC3 פרמטרים, שני רשומות NSEC3 ו-NSEC3PARAM יש ליצור מחדש עם אותם "
"פרמטרים."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:175
msgid ""
"NSEC3PARAM record must contain exactly hash algorithm, flags, iterations, "
"and salt."
msgstr ""
"רשומת NSEC3PARAM חייבת להכיל בדיוק אלגוריתם גיבוב (hash), דגלים, איטרציות "
"ומלח (salt)."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:181
msgid "NSEC3PARAM hash algorithm must be 1 (SHA-1)."
msgstr "אלגוריתם הגיבוב (hash) של NSEC3PARAM חייב להיות 1 (SHA-1)."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:187
msgid "NSEC3PARAM flags must be between 0 and 255."
msgstr "דגלי NSEC3PARAM חייבים להיות בין 0 ל 255."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:218
msgid ""
"Flag value 1 indicates Opt-Out is in use. This means NSEC3 records may cover "
"unsigned delegations."
msgstr ""
"ערך הדגל 1 מציין ש-Opt-Out נמצא בשימוש. משמעות הדבר היא שרשומות NSEC3 עשויות "
"לכסות האצלות לא חתומות."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:219
msgid ""
"RFC 9276 recommends using Opt-Out only for very large and sparsely signed "
"zones where the majority of records are insecure delegations."
msgstr ""
"RFC 9276 ממליץ להשתמש ב-Opt-Out רק באזורים גדולים מאוד וחתומים באופן דליל, "
"שבהם רוב הרשומות הן האצלות לא מאובטחות."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:195
msgid ""
"Flags values greater than 1 are reserved for future use. Current "
"implementations may not handle these values correctly."
msgstr ""
"ערכי דגלים גדולים מ-1 שמורים לשימוש עתידי. ייתכן שמימושים נוכחיים לא יטפלו "
"בערכים אלה כראוי."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:201
msgid "NSEC3PARAM iterations must be between 0 and 2500."
msgstr "מספר האיטרציות של NSEC3PARAM חייב להיות בין 0 ל-2500."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:230
msgid ""
"RFC 9276 recommends using 0 iterations. Additional iterations add "
"computational cost without enhancing security."
msgstr ""
"RFC 9276 ממליץ להשתמש ב-0 איטרציות. איטרציות נוספות מוסיפות עלות חישובית ללא "
"שיפור האבטחה."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:233
msgid ""
"High iteration values (>100) may cause validating resolvers to reject your "
"zones. RFC 9276 STRONGLY recommends using 0 iterations."
msgstr ""
"ערכי איטרציה גבוהים (>100) עלולים לגרום לפותרי DNS מאמתים לדחות את האזורים "
"שלך. RFC 9276 ממליץ בחום להשתמש ב-0 איטרציות."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:235
msgid ""
"Iteration values >10 create unnecessary computational load without security "
"benefits. RFC 9276 recommends using 0 iterations."
msgstr ""
"ערכי איטרציה >10 יוצרים עומס חישובי מיותר ללא יתרונות אבטחה. RFC 9276 ממליץ "
"להשתמש ב-0 איטרציות."

#: lib/Domain/Service/DnsValidation/NSEC3PARAMRecordValidator.php:218
msgid "NSEC3PARAM salt must be - (for empty) or a hexadecimal value."
msgstr "מלח NSEC3PARAM חייב להיות - (לריקה) או ערך hexadecimal."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:247
msgid ""
"RFC 9276 recommends NOT using a salt (indicated by \"-\") to simplify "
"operation without reducing security."
msgstr ""
"RFC 9276 ממליץ לא להשתמש במלח (המצוין על ידי \"-\") כדי לפשט את הפעולה מבלי "
"לצמצם את האבטחה."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:250
msgid ""
"Long salts provide no additional security benefit. Consider using a shorter "
"salt or no salt (-)."
msgstr ""
"מלחים ארוכים אינם מספקים תועלת ביטחונית נוספת. מומלץ להשתמש במלח קצר יותר או "
"ללא מלח (-)"

#: lib/Domain/Service/DnsValidation/LPRecordValidator.php:107
msgid ""
"NOTE: The LP record type is defined in RFC 6742 as an experimental protocol, "
"not a formal IETF standard."
msgstr ""
"הערה: סוג הרשומה LP מוגדר ב-RFC 6742 כפרוטוקול ניסיוני, ולא כתקן IETF רשמי."

#: lib/Domain/Service/DnsValidation/LPRecordValidator.php:108
msgid ""
"LP records should only be used with the Identifier-Locator Network Protocol "
"(ILNP)."
msgstr ""
"יש להשתמש ברשומות LP רק עם פרוטוקול Identifier-Locator Network Protocol "
"(ILNP)."

#: lib/Domain/Service/DnsValidation/LPRecordValidator.php:109
msgid ""
"LP records MUST NOT be present for nodes that are not ILNP-capable (RFC 6742 "
"Section 3.4)."
msgstr ""
"אסור שרשומות LP יופיעו עבור צמתים שאינם תומכי ILNP (RFC 6742 סעיף 3.4)."

#: lib/Domain/Service/DnsValidation/LPRecordValidator.php:118
msgid ""
"Warning: The FQDN in an LP record SHOULD NOT have the same value as the "
"owner name (RFC 6742)."
msgstr ""
"אזהרה: ל-FQDN שברשומת LP לא אמור להיות אותו ערך כמו שם הבעלים (RFC 6742)."

#: lib/Domain/Service/DnsValidation/LPRecordValidator.php:123
msgid ""
"It is recommended to end FQDN values with a trailing dot to ensure they are "
"treated as absolute domain names rather than relative ones."
msgstr ""
"מומלץ לסיים ערכי FQDN בנקודה בסופם, כדי להבטיח שהם יטופלו כשמות דומיין "
"מוחלטים ולא יחסיים."

#: lib/Domain/Service/DnsValidation/LPRecordValidator.php:128
msgid ""
"Consider using longer TTL values for LP records. Unlike L32/L64 records, LP "
"records are stable and benefit from longer cache times (RFC 6742)."
msgstr ""
"שקול להשתמש בערכי TTL ארוכים יותר עבור רשומות LP. בשונה מרשומות L32/L64, "
"רשומות LP יציבות ומרוויחות מזמני מטמון ארוכים יותר (RFC 6742)."

#: lib/Domain/Service/DnsValidation/LPRecordValidator.php:152
msgid "LP record must contain preference and FQDN separated by space."
msgstr "רשומת LP חייבת להכיל העדפה ו-FQDN מופרדים ברווח."

#: lib/Domain/Service/DnsValidation/LPRecordValidator.php:159
msgid "LP preference must be a number between 0 and 65535."
msgstr "העדפת LP חייבת להיות מספר בין 0 ל-65535."

#: lib/Domain/Service/DnsValidation/LPRecordValidator.php:165
msgid "LP FQDN must be a valid fully qualified domain name."
msgstr "LP FQDN חייב להיות שם דומיין מוסמך לחלוטין."

#: lib/Domain/Service/DnsValidation/AFSDBRecordValidator.php:76
msgid ""
"AFSDB records are deprecated by RFC 5864 in favor of SRV records for AFS "
"service location."
msgstr ""
"רשומות AFSDB הוצאו משימוש על ידי RFC 5864 לטובת רשומות SRV עבור איתור שירות "
"AFS."

#: lib/Domain/Service/DnsValidation/AFSDBRecordValidator.php:90
msgid "Invalid AFSDB hostname."
msgstr "שם מארח AFSDB לא חוקי."

#: lib/Domain/Service/DnsValidation/AFSDBRecordValidator.php:99
msgid "AFSDB server hostname must be a fully qualified domain name (FQDN)."
msgstr "שם המארח של שרת AFSDB חייב להיות שם דומיין מוסמך לחלוטין (FQDN)."

#: lib/Domain/Service/DnsValidation/AFSDBRecordValidator.php:105
msgid ""
"AFSDB server hostname must be a fully qualified domain name with at least "
"two parts."
msgstr ""
"שם המארח של שרת AFSDB חייב להיות שם דומיין מוסמך לחלוטין עם לפחות שני חלקים."

#: lib/Domain/Service/DnsValidation/AFSDBRecordValidator.php:154
msgid ""
"Invalid AFSDB subtype. Must be 1 (AFS cell database server) or 2 (DCE "
"authenticated name server)."
msgstr ""
"תת-סוג AFSDB לא חוקי. חייב להיות 1 (שרת מסד נתונים של תא AFS) או 2 (שרת שמות "
"מאומת של DCE)."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:106
msgid "Priority field for LOC records must be 0 or empty."
msgstr "שדה עדיפות עבור רשומות LOC חייב להיות 0 או ריק."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:112
msgid ""
"NOTE: The LOC record type is defined in RFC 1876 as an experimental "
"protocol, not a formal IETF standard."
msgstr ""
"הערה: סוג הרשומה LOC מוגדר ב-RFC 1876 כפרוטוקול ניסיוני, ולא כתקן IETF רשמי."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:113
msgid ""
"LOC records are rarely used but can be helpful for geographical mapping of "
"resources."
msgstr ""
"רשומות LOC משמשות לעתים רחוקות אך ניתן לעזור למיפוי גיאוגרפי של משאבים."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:122
msgid ""
"Exact 90 degrees North latitude (the North Pole) detected. This is an "
"extreme point and might indicate incorrect data entry."
msgstr ""
"זוהה קו רוחב של בדיוק 90 מעלות צפון (הקוטב הצפוני). זו נקודה קיצונית ועשויה "
"להצביע על הזנת נתונים שגויה."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:124
msgid ""
"Zero latitude detected (the Equator). If this is intentional, it is fine; "
"otherwise, please verify your coordinates."
msgstr ""
"זוהה קו רוחב אפס (קו המשווה). אם זה בכוונה, זה בסדר; אחרת, אנא בדוק את "
"הקואורדינטות שלך."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:129
msgid ""
"Default precision values detected (1m size, 10000m horizontal precision, 10m "
"vertical precision). Consider using more accurate values if you have them."
msgstr ""
"זוהו ערכי דיוק של ברירת מחדל (גודל 1 מטר, דיוק אופקי 10000 מטר, דיוק אנכי 10 "
"מטר). שקול להשתמש בערכים מדויקים יותר אם יש לך אותם."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:153
msgid "Latitude degrees must be between 0 and 90."
msgstr "מעלות רוחב צריכות להיות בין 0 ל-90."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:159
msgid "Latitude direction must be specified as N or S."
msgstr "יש לציין את כיוון קו הרוחב כ-N או S."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:163
msgid "Longitude direction must be specified as E or W."
msgstr "יש לציין את כיוון קו האורך כ-E או W."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:170
msgid "Longitude degrees must be between 0 and 180."
msgstr "מעלות קו האורך חייבות להיות בין 0 ל-180."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:178
msgid "Minutes must be between 0 and 59."
msgstr "דקות צריכות להיות בין 0 ל-59."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:185
msgid "Seconds must be between 0 and 59.999."
msgstr "שניות חייבות להיות בין 0 ל-59.999."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:194
msgid "Altitude must be between -100000 and 42849672.95 meters."
msgstr "הגובה חייב להיות בין -100000 ל-42849672.95 מטר."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:212
msgid ""
"Invalid size, horizontal precision, or vertical precision value. These must "
"be between 0 and 90000000 meters."
msgstr ""
"גודל, דיוק אופקי או ערך דיוק אנכי לא חוקיים. אלה חייבים להיות בין 0 "
"ל-90000000 מטר."

#: lib/Domain/Service/DnsValidation/LOCRecordValidator.php:217
msgid ""
"Invalid LOC record format. Format should be: d1 [m1 [s1]] {\"N\"|\"S\"} d2 "
"[m2 [s2]] {\"E\"|\"W\"} alt[\"m\"] [siz[\"m\"] [hp[\"m\"] [vp[\"m\"]]]]."
msgstr ""
"פורמט רשומת LOC לא חוקי. הפורמט צריך להיות: d1 [m1 [s1]] {\"N\"|\"S\"} d2 "
"[m2 [s2]] {\"E\"|\"W\"} alt[\"m\"] [siz[\"m\"] [hp[\"m\"] [vp[\"m\"]]]]."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:76
msgid "Invalid characters in name field."
msgstr "תווים לא חוקיים בשדה השם."

#: lib/Domain/Service/DnsValidation/TXTRecordValidator.php:163
msgid "Invalid characters in content field."
msgstr "תווים לא חוקיים בשדה התוכן."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:135
msgid "Priority field for RKEY records must be 0 or empty."
msgstr "שדה עדיפות עבור רשומות RKEY חייב להיות 0 או ריק."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:139
msgid ""
"RKEY records should be used with caution as they are not widely supported by "
"DNS servers and resolvers."
msgstr ""
"יש להשתמש ברשומות RKEY בזהירות, מכיוון שהן אינן נתמכות באופן נרחב על ידי "
"שרתי DNS ופותרי DNS."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:162
msgid "RKEY record content cannot be empty."
msgstr "תוכן רשומת RKEY אינו יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:168
msgid ""
"RKEY record must contain flags, protocol, algorithm, and public key data."
msgstr "רישום RKEY חייב להכיל דגלים, פרוטוקול, אלגוריתם ונתוני מפתח ציבוריים."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:175
msgid "RKEY flags field must be a numeric value."
msgstr "שדה דגלי RKEY חייב להיות ערך מספרי."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:183
msgid ""
"Unusual flags value. Common values are 0, 256 (Zone Key), or 257 (Zone Key + "
"SEP)."
msgstr ""
"ערך דגלים חריג. ערכים נפוצים הם 0, 256 (Zone Key), או 257 (Zone Key + SEP)."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:188
msgid ""
"Bit 7 (Zone Key flag) is set in the flags field, indicating this is a zone "
"key."
msgstr "bit 7 (Zone Key flag) מוגדר בשדה הדגלים, המציין כי זהו מפתח אזורי."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:192
msgid ""
"Bit 0 (SEP flag) is set in the flags field, indicating this is a secure "
"entry point."
msgstr "bit 0 (SEP דגל) מוגדר בשדה הדגלים, המציין כי זהו נקודת כניסה בטוחה."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:197
msgid "RKEY protocol field must be a numeric value."
msgstr "שדה פרוטוקול RKEY חייב להיות ערך מספרי."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:202
msgid ""
"Protocol field should be 3 for compliance with standards based on DNSKEY "
"format."
msgstr ""
"שדה פרוטוקול צריך להיות 3 עבור עמידה בסטנדרטים המבוססים על פורמט DNSKEY."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:207
msgid "RKEY algorithm field must be a numeric value."
msgstr "שדה אלגוריתם RKEY חייב להיות ערך מספרי."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:213
msgid "RKEY algorithm field must be a valid DNSSEC algorithm number (0-16)."
msgstr "שדה אלגוריתם RKEY חייב להיות מספר אלגוריתם DNSSEC בתוקף (0-16)."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:218
msgid "Algorithm 1 (RSA/MD5) is deprecated (RFC 6725) and should NOT be used."
msgstr "Algorithm 1 (RSA/MD5) הוצא משימוש (RFC 6725) ואין להשתמש בו."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:220
msgid ""
"Algorithm 3 (DSA/SHA1) is considered insecure and should be replaced with a "
"stronger algorithm."
msgstr ""
"Algorithm 3 (DSA/SHA1) נחשב חסר ביטחון ויש להחליף אותו באלגוריתם חזק יותר."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:222
msgid ""
"Algorithm 5 (RSA/SHA-1) is considered insecure and should be replaced with a "
"stronger algorithm."
msgstr ""
"Algorithm 5 (RSA/SHA-1) נחשב חסר ביטחון ויש להחליף אותו באלגוריתם חזק יותר."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:224
msgid ""
"Algorithm 7 (RSASHA1-NSEC3-SHA1) uses SHA-1 which is no longer considered "
"secure."
msgstr "Algorithm 7 (RSASHA1-NSEC3-SHA1) משתמש SHA-1 שכבר אינו נחשב בטוח."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:201
msgid ""
"Algorithm 8 (RSA/SHA-256) is currently recommended for DNSSEC deployments."
msgstr "Algorithm 8 (RSA/SHA-256) מומלץ כיום לפריסות DNSSEC."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:228
msgid "Algorithm 10 (RSA/SHA-512) provides strong security."
msgstr "Algorithm 10 (RSA/SHA-512) מספק אבטחה חזקה."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:230
msgid ""
"Algorithm 13 (ECDSA Curve P-256 with SHA-256) provides good security with "
"smaller signatures than RSA."
msgstr ""
"Algorithm 13 (ECDSA Curve P-256 עם SHA-256) מספק אבטחה טובה עם חתימה קטנה "
"יותר מאשר RSA."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:232
msgid ""
"Algorithm 14 (ECDSA Curve P-384 with SHA-384) provides strong security with "
"smaller signatures than RSA."
msgstr ""
"Algorithm 14 (ECDSA Curve P-384 עם SHA-384) מספק אבטחה חזקה עם חתימות קטנות "
"יותר מאשר RSA."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:234
msgid ""
"Algorithm 15 (Ed25519) offers modern security but may have compatibility "
"issues with older validators."
msgstr ""
"Algorithm 15 (Ed25519) מציע אבטחה מודרנית אך עלולות להיות בעיות תאימות עם "
"מאמתים ישנים יותר."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:236
msgid ""
"Algorithm 16 (Ed448) offers strong modern security but may have "
"compatibility issues with older validators."
msgstr ""
"Algorithm 16 (Ed448) מציע אבטחה מודרנית חזקה, אך עלולות להיות בעיות תאימות "
"עם מאמתים ישנים יותר."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:217
msgid ""
"CRITICAL: This algorithm is considered insecure. Use algorithm 8 (RSA/"
"SHA-256) or later."
msgstr ""
"CRITICAL: אלגוריתם זה נחשב חסר ביטחון. השתמש באלגוריתם 8 (RSA/SHA-256) או "
"מאוחר יותר."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:245
msgid "RKEY public key data cannot be empty."
msgstr "נתוני המפתח הציבורי של RKEY אינם יכולים להיות ריקים."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:250
msgid "Public key data should be Base64 encoded according to RFC 4034."
msgstr "נתוני המפתח הציבורי צריכים להיות מקודדים ב-Base64 בהתאם ל-RFC 4034."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:254
msgid ""
"RKEY records were never formally standardized as an RFC, only proposed in "
"draft-reid-dnsext-rkey-00."
msgstr ""
"רשומות RKEY מעולם לא תוקננו רשמית כ-RFC, אלא רק הוצעו ב-draft-reid-dnsext-"
"rkey-00."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:255
msgid "RKEY records are rarely used in modern DNS implementations."
msgstr "רשומות RKEY משמשות לעתים רחוקות ביישום DNS מודרני."

#: lib/Domain/Service/DnsValidation/RKEYRecordValidator.php:256
msgid "Consider using standardized record types for cryptographic purposes."
msgstr "שקול להשתמש בסוגי רשומות סטנדרטיים למטרות הצפנה."

#: lib/Domain/Service/DnsValidation/APLRecordValidator.php:207
msgid "Empty APL record represents an empty list of address prefixes."
msgstr "רשומת APL ריקה מייצגת רשימה ריקה של קידומות כתובות."

#: lib/Domain/Service/DnsValidation/APLRecordValidator.php:293
msgid ""
"RFC 3123 recommends that trailing zero octets should not be present in APL "
"address parts."
msgstr ""
"RFC 3123 ממליץ שלא יופיעו אוקטטים אפסיים בסוף חלקי הכתובת של רשומות APL."

#: lib/Domain/Service/DnsValidation/APLRecordValidator.php:154
msgid ""
"RFC 3123 notes security considerations when using APL records for access "
"control lists."
msgstr "RFC 3123 מציין שיקולי אבטחה בעת שימוש ברשומות APL לרשימות בקרת גישה."

#: lib/Domain/Service/DnsValidation/APLRecordValidator.php:188
msgid ""
"Invalid value for priority field. APL records must have priority value of 0."
msgstr ""
"ערך לא חוקי לתחום עדיפות. רשומות APL חייבות להיות בעלות ערך עדיפות של 0."

#: lib/Domain/Service/DnsValidation/APLRecordValidator.php:254
msgid "Invalid APL element format. Expected [!]afi:address/prefix."
msgstr "פורמט רכיב APL לא חוקי. הפורמט הצפוי: [!]afi:address/prefix."

#: lib/Domain/Service/DnsValidation/APLRecordValidator.php:264
msgid ""
"Invalid Address Family Identifier (AFI). Must be 1 for IPv4 or 2 for IPv6."
msgstr ""
"מזהה משפחת כתובות (AFI) לא חוקי. חייב להיות 1 עבור IPv4 או 2 עבור IPv6."

#: lib/Domain/Service/DnsValidation/APLRecordValidator.php:272
msgid "Invalid IPv4 address in APL record."
msgstr "כתובת IPv4 לא חוקית ברשומת APL."

#: lib/Domain/Service/DnsValidation/APLRecordValidator.php:277
msgid "IPv4 prefix must be between 0 and 32."
msgstr "קידומת IPv4 חייבת להיות בין 0 ל-32."

#: lib/Domain/Service/DnsValidation/APLRecordValidator.php:299
msgid "Invalid IPv6 address in APL record."
msgstr "כתובת IPv6 לא חוקית ברשומת APL."

#: lib/Domain/Service/DnsValidation/APLRecordValidator.php:304
msgid "IPv6 prefix must be between 0 and 128."
msgstr "קידומת IPv6 חייבת להיות בין 0 ל-128."

#: lib/Domain/Service/DnsValidation/APLRecordValidator.php:313
msgid ""
"Using APL records for AXFR access control should be combined with other "
"security measures as noted in RFC 3123."
msgstr ""
"באמצעות רשומות APL עבור בקרת גישה AXFR יש לשלב עם אמצעי אבטחה אחרים כפי "
"שצוין ב RFC 3123."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:78
msgid ""
"Note: NID records are used for the ILNP protocol, which is experimental (RFC "
"6740, 6742)."
msgstr "הערה: רשומות NID משמשות לפרוטוקול ILNP, שהוא ניסיוני (RFC 6740, 6742)."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:82
msgid "NID record content cannot be empty."
msgstr "תוכן רישום NID אינו יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:149
msgid ""
"NID record content must be in format xxxx:xxxx:xxxx:xxxx with 4 groups of 4 "
"hexadecimal digits."
msgstr ""
"תוכן רשומת NID חייב להיות בפורמט xxxx:xxxx:xxxx:xxxx עם 4 קבוצות של 4 ספרות "
"hexadecimal."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:155
msgid "NID record content must have exactly 4 groups of hexadecimal digits."
msgstr "תוכן רשומת NID חייב לכלול בדיוק 4 קבוצות של ספרות hexadecimal."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:168
msgid ""
"NID record content must be a 64-bit hexadecimal value (16 hex characters or "
"xxxx:xxxx:xxxx:xxxx format)."
msgstr ""
"תוכן רשומת NID חייב להיות ערך הקסדצימלי של 64 סיביות (16 תווי hex או בפורמט "
"xxxx:xxxx:xxxx:xxxx)."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:175
msgid ""
"NID records should use the RFC 6742 presentation format "
"(xxxx:xxxx:xxxx:xxxx) with colons for better readability."
msgstr ""
"רשומות NID צריכות להשתמש בפורמט התצוגה של RFC 6742 (xxxx:xxxx:xxxx:xxxx) עם "
"נקודתיים לקריאות טובה יותר."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:214
msgid ""
"Invalid NID record: The Group bit (g bit, least significant bit of first "
"byte) MUST be 0 in ILNP as specified in RFC 6742."
msgstr ""
"רשומת NID לא חוקית: ביט הקבוצה (g bit, הביט הפחות משמעותי של הבייט הראשון) "
"חייב להיות 0 ב-ILNP כפי שצוין ב-RFC 6742."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:221
msgid ""
"The universal/local bit (u/l bit) is set to universal (0), indicating this "
"NID is based on a globally unique identifier."
msgstr ""
"הביט האוניברסלי/מקומי (u/l bit) מוגדר לאוניברסלי (0), מה שמציין ש-NID זה "
"מבוסס על מזהה ייחודי גלובלית."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:223
msgid ""
"The universal/local bit (u/l bit) is set to local (1), indicating this NID "
"is locally assigned and not globally unique."
msgstr ""
"הביט האוניברסלי/מקומי (u/l bit) מוגדר למקומי (1), מה שמציין ש-NID זה מוקצה "
"באופן מקומי ואינו ייחודי גלובלית."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:228
msgid "A zero NodeID value is unusual and may indicate a configuration error."
msgstr "ערך אפס NodeID הוא יוצא דופן ועשוי להצביע על טעות בתצורה."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:233
msgid ""
"An all-ones NodeID value is unusual and may indicate a configuration error."
msgstr ""
"ערך NodeID המורכב כולו מאחדות הוא יוצא דופן ועשוי להצביע על טעות בתצורה."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:267
msgid "NID record preference must be a number."
msgstr "העדפה לרישום NID חייבת להיות מספר."

#: lib/Domain/Service/DnsValidation/NIDRecordValidator.php:274
msgid "NID record preference must be between 0 and 65535."
msgstr "העדפה של NID צריכה להיות בין 0 ל 65535."

#: lib/Domain/Service/DnsValidation/ALIASRecordValidator.php:95
msgid "ALIAS target must be a fully qualified domain name (FQDN)."
msgstr "המטרה של ALIAS חייבת להיות שם דומיין מוסמך לחלוטין (FQDN)."

#: lib/Domain/Service/DnsValidation/ALIASRecordValidator.php:100
msgid ""
"ALIAS target cannot point to itself, as this would create a resolution loop."
msgstr "המטרה של ALIAS אינה יכולה להצביע על עצמה, שכן זה היה יוצר לולאת פתרון."

#: lib/Domain/Service/DnsValidation/ALIASRecordValidator.php:149
msgid ""
"Invalid value for priority field. ALIAS records must have priority value of "
"0."
msgstr ""
"ערך לא חוקי לתחום עדיפות. רשומות ALIAS חייבות להיות בעלות ערך עדיפות של 0."

#: lib/Domain/Service/DnsValidation/DefaultRecordValidator.php:55
msgid "Content field cannot be empty."
msgstr "שדה תוכן לא יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/DefaultRecordValidator.php:66
msgid ""
"Generic record data must be \"\\# <length> <hex>\" with the length matching "
"the hex data."
msgstr "נתוני רשומה כלליים חייבים להיות בתבנית \"\\# <length> <hex>\", כשהאורך תואם לנתונים ההקסדצימליים."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:91
msgid "NSEC record content cannot be empty."
msgstr "תוכן רשומת NSEC אינו יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:96
msgid "NSEC record contains invalid characters."
msgstr "רשומת NSEC מכילה תווים לא חוקיים."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:117
msgid ""
"According to RFC 4034, NSEC records should have the same TTL as the SOA "
"minimum TTL field."
msgstr ""
"על פי RFC 4034, רשומות NSEC צריך להיות אותו TTL כמו שדה TTL מינימלי SOA."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:120
msgid ""
"NSEC records enable \"zone walking\", allowing enumeration of all names in a "
"zone, which may be a privacy concern."
msgstr ""
"רשומות NSEC מאפשרות \"הליכה באזור\" (zone walking), המאפשרת מנייה של כל "
"השמות באזור, דבר שעשוי להוות בעיית פרטיות."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:121
msgid ""
"If zone enumeration is a concern, consider using NSEC3 records (RFC 5155) "
"instead, which use hashed owner names."
msgstr ""
"אם מניית האזור מהווה חשש, שקול להשתמש ברשומות NSEC3 (RFC 5155) במקום זאת, "
"המשתמשות בשמות בעלים מגובבים (hashed)."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:122
msgid ""
"NSEC records are part of DNSSEC and should only be managed alongside other "
"DNSSEC records (DNSKEY, RRSIG, etc.)."
msgstr ""
"רשומות NSEC הן חלק מ-DNSSEC וצריכה להיות מנוהלת רק לצד רשומות DNSSEC אחרות "
"(DNSKEY, RRSIG וכו ')."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:123
msgid ""
"Manually editing NSEC records is not recommended as they are typically "
"generated automatically by DNSSEC-aware nameservers."
msgstr ""
"עריכה ידנית של רשומות NSEC אינה מומלצת, מכיוון שהן נוצרות בדרך כלל באופן "
"אוטומטי על ידי שרתי שמות מודעי DNSSEC."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:127
msgid ""
"Wildcard names in NSEC records require special handling. According to RFC "
"4035, wildcard owner names appear in NSEC records without expansion."
msgstr ""
"שמות Wildcard ברשומות NSEC דורשים טיפול מיוחד. על פי RFC 4035, שמות בעלים "
"מסוג Wildcard מופיעים ברשומות NSEC ללא הרחבה."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:162
msgid "NSEC record must contain a valid next domain name."
msgstr "רשומת NSEC חייבת לכלול שם דומיין הבא תקף."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:167
msgid ""
"The next domain name field must be the next owner name in canonical ordering "
"of the zone. Canonical ordering is case-insensitive and sorts by labels from "
"right to left."
msgstr ""
"שדה שם הדומיין הבא חייב להיות שם הבעלים הבא בסדר הקנוני של האזור. הסדר "
"הקנוני אינו רגיש לאותיות גדולות/קטנות וממיין לפי תוויות מימין לשמאל."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:171
msgid ""
"If this is the last NSEC record in the zone, the next domain name should be "
"the zone apex (the owner name of the zone's SOA RR)."
msgstr ""
"אם זו רשומת ה-NSEC האחרונה באזור, שם הדומיין הבא צריך להיות ה-apex של האזור "
"(שם הבעלים של רשומת ה-SOA של האזור)."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:188
msgid ""
"Type bit maps should be present to indicate which RR types exist at the NSEC "
"owner name. An empty type bitmap is unusual."
msgstr ""
"מפות סיביות של סוגים (type bit maps) צריכות להופיע כדי לציין אילו סוגי RR "
"קיימים בשם הבעלים של NSEC. מפת סיביות ריקה של סוגים היא יוצאת דופן."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:318
#, php-format
msgid ""
"Numeric type \"%s\" should be represented using the RFC 3597 format "
"(TYPE###)."
msgstr "סוג Numeric \"%s\" צריך להיות מיוצג באמצעות פורמט RFC 3597 (TYPE###)."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:260
#, php-format
msgid "NSEC record contains an invalid record type: %s"
msgstr "רשומת NSEC מכילה סוג רשומה לא חוקי: %s"

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:266
msgid ""
"NSEC type should typically be present in its own type bit map, as each name "
"in a signed zone should have an NSEC record."
msgstr ""
"סוג NSEC צריך בדרך כלל להופיע במפת הסיביות של הסוגים שלו עצמו, שכן לכל שם "
"באזור חתום צריכה להיות רשומת NSEC."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:270
msgid ""
"RRSIG type should typically be present in NSEC type bit maps for DNSSEC-"
"signed zones."
msgstr ""
"סוג RRSIG צריך להיות נוכח בדרך כלל במפות הביטים של הסוגים ברשומות NSEC עבור "
"אזורים חתומים ב-DNSSEC."

#: lib/Domain/Service/DnsValidation/NSECRecordValidator.php:275
msgid ""
"This NSEC record contains both SOA and NS types, indicating it might be for "
"a zone apex."
msgstr ""
"רשומת NSEC זו מכילה גם את הסוג SOA וגם את הסוג NS, מה שמעיד שייתכן שהיא "
"מיועדת לקודקוד האזור (apex)."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:106
msgid ""
"The record name does not follow the standard OPENPGPKEY format "
"(<hash>._openpgpkey.<domain>). Standard format is recommended for "
"interoperability."
msgstr ""
"שם הרשומה אינו עוקב אחר הפורמט התקני של OPENPGPKEY (<hash>._openpgpkey."
"<domain>). מומלץ להשתמש בפורמט התקני לצורך תאימות הדדית."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:132
msgid "Priority field for OPENPGPKEY records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות OPENPGPKEY חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:136
msgid ""
"OPENPGPKEY records should typically be generated using specialized tools "
"like GnuPG with the --print-dane-records option, rather than created "
"manually."
msgstr ""
"רשומות OPENPGPKEY צריכות להיווצר בדרך כלל באמצעות כלים ייעודיים כמו GnuPG עם "
"האפשרות --print-dane-records, ולא להיווצר באופן ידני."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:190
msgid "OPENPGPKEY record content cannot be empty."
msgstr "תוכן רשומת OPENPGPKEY אינו יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:196
msgid "Invalid characters in OPENPGPKEY record content."
msgstr "תווים לא חוקיים בתוכן רשומת OPENPGPKEY."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:202
msgid "OPENPGPKEY records must contain valid base64-encoded data."
msgstr "רשומות OPENPGPKEY חייבות להכיל נתונים תקינים המקודדים ב-base64."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:208
msgid "OPENPGPKEY record contains invalid base64 data."
msgstr "רשומת OPENPGPKEY מכילה נתוני base64 לא חוקיים."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:215
msgid ""
"OPENPGPKEY record exceeds 4KB in size. RFC 7929 recommends keeping DNS "
"records as small as possible to ensure reliable transport. Consider using a "
"minimal key export format."
msgstr ""
"רשומת OPENPGPKEY חורגת מגודל של 4KB. RFC 7929 ממליץ לשמור על רשומות DNS "
"קטנות ככל האפשר כדי להבטיח העברה אמינה. שקול להשתמש בפורמט ייצוא מפתח "
"מינימלי."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:217
msgid ""
"OPENPGPKEY record is unusually small. Verify that this is a valid OpenPGP "
"public key."
msgstr ""
"רשומת OPENPGPKEY קטנה באופן חריג. ודא שמדובר במפתח ציבורי תקין של OpenPGP."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:226
msgid ""
"The decoded content does not appear to be a valid OpenPGP packet. OpenPGP "
"packets must start with a byte that has the high bit set (RFC 9580)."
msgstr ""
"התוכן המפוענח אינו נראה כחבילת OpenPGP תקינה. חבילות OpenPGP חייבות להתחיל "
"בבייט שבו הסיבית הגבוהה דלוקה (RFC 9580)."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:245
msgid ""
"The decoded content does not appear to contain a public key packet (tag 6) "
"or public subkey packet (tag 14) as its first packet."
msgstr ""
"התוכן המפוענח אינו נראה כמכיל חבילת מפתח ציבורי (tag 6) או חבילת תת-מפתח "
"ציבורי (tag 14) כחבילה הראשונה שלו."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:252
msgid ""
"OPENPGPKEY records REQUIRE DNSSEC for any security benefit. Without DNSSEC "
"validation, these records offer no security advantage."
msgstr ""
"רשומות OPENPGPKEY דורשות DNSSEC כדי להעניק תועלת אבטחה כלשהי. ללא אימות "
"DNSSEC, רשומות אלה אינן מציעות יתרון אבטחה."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:253
msgid ""
"OPENPGPKEY records are EXPERIMENTAL as per RFC 7929 and may not be supported "
"by all email clients or OpenPGP implementations."
msgstr ""
"רשומות OPENPGPKEY הן ניסיוניות על פי RFC 7929 וייתכן שאינן נתמכות על ידי כל "
"לקוחות הדואר האלקטרוני או מימושי OpenPGP."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:254
msgid ""
"OPENPGPKEY records are not a replacement for the OpenPGP Web of Trust. "
"Additional verification methods are still recommended."
msgstr ""
"רשומות OPENPGPKEY אינן תחליף לרשת OpenPGP של אמון. שיטות אימות נוספות עדיין "
"מומלץ."

#: lib/Domain/Service/DnsValidation/OPENPGPKEYRecordValidator.php:255
msgid ""
"To create OPENPGPKEY records, use specialized tools like GnuPG with the --"
"print-dane-records option to ensure correct format and content."
msgstr ""
"כדי ליצור רשומות OPENPGPKEY, השתמש בכלים ייעודיים כמו GnuPG עם האפשרות --"
"print-dane-records כדי להבטיח פורמט ותוכן נכונים."

#: lib/Domain/Service/DnsValidation/NSRecordValidator.php:126
msgid ""
"Invalid value for priority field. NS records must have priority value of 0."
msgstr ""
"ערך לא חוקי עבור שדה העדיפות. רשומות NS חייבות להיות בעלות ערך עדיפות של 0."

#: lib/Domain/Service/DnsValidation/HINFORecordValidator.php:112
msgid ""
"Warning: HINFO records reveal potentially sensitive information about host "
"hardware and software that could be useful to attackers. Consider security "
"implications before using in public-facing DNS."
msgstr ""
"אזהרה: רשומות HINFO חושפות מידע שעלול להיות רגיש על החומרה והתוכנה של המארח, "
"שעשוי להיות שימושי לתוקפים. שקול את השלכות האבטחה לפני שימוש ב-DNS הפונה "
"לציבור."

#: lib/Domain/Service/DnsValidation/HINFORecordValidator.php:141
msgid "Priority field for HINFO records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות HINFO חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/HINFORecordValidator.php:167
msgid "HINFO record must have CPU type and OS fields."
msgstr "רשומת HINFO חייבת לכלול את השדות סוג CPU ומערכת הפעלה."

#: lib/Domain/Service/DnsValidation/HINFORecordValidator.php:183
msgid "HINFO record must have exactly two fields: CPU type and OS."
msgstr "רשומת HINFO חייבת לכלול בדיוק שני שדות: סוג CPU ומערכת הפעלה."

#: lib/Domain/Service/DnsValidation/HINFORecordValidator.php:208
msgid "Invalid quoting in HINFO "
msgstr "שימוש לא חוקי במירכאות ב-HINFO "

#: lib/Domain/Service/DnsValidation/HINFORecordValidator.php:237
msgid "HINFO "
msgstr "HINFO "

#: lib/Domain/Service/DnsValidation/HINFORecordValidator.php:232
msgid "Invalid quote marks within HINFO "
msgstr "סימני מירכאות לא חוקיים בתוך HINFO "

#: lib/Domain/Service/DnsValidation/HINFORecordValidator.php:250
msgid ""
"CPU type does not contain any standard values. Consider using a standard CPU "
"type for better interoperability."
msgstr ""
"סוג ה-CPU אינו מכיל ערכים סטנדרטיים. שקול להשתמש בסוג CPU סטנדרטי לשיפור "
"ההפעלה ההדדית."

#: lib/Domain/Service/DnsValidation/HINFORecordValidator.php:254
msgid ""
"OS type does not contain any standard values. Consider using a standard OS "
"type for better interoperability."
msgstr ""
"סוג מערכת ההפעלה אינו מכיל ערכים סטנדרטיים. שקול להשתמש בסוג מערכת הפעלה "
"סטנדרטי לשיפור ההפעלה ההדדית."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:119
msgid ""
"TSIG timestamp is more than 24 hours old. This could indicate a replay "
"attack or clock synchronization issue."
msgstr ""
"חותמת הזמן של TSIG ישנה ביותר מ-24 שעות. הדבר עשוי להצביע על מתקפת שידור "
"חוזר או על בעיה בסנכרון השעונים."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:124
msgid ""
"TSIG timestamp is set in the future. This could indicate a clock "
"synchronization issue."
msgstr "TSIG Timestamp מוגדר בעתיד. זה יכול להצביע על בעיה של סינכרון שעון."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:148
msgid "TSIG keys should be rotated periodically as a security best practice."
msgstr "יש להחליף מפתחות TSIG מעת לעת כשיטת אבטחה מומלצת."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:149
msgid ""
"TSIG provides transaction authentication but not data integrity. Consider "
"using DNSSEC in addition to TSIG."
msgstr ""
"TSIG מספק אימות עסקה אך לא שלמות נתונים. שקול להשתמש ב-DNSSEC בנוסף ל-TSIG."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:150
msgid ""
"Accurate system clocks are required on both client and server for TSIG to "
"work correctly."
msgstr "נדרשים שעוני מערכת מדויקים הן בלקוח והן בשרת כדי ש-TSIG יעבוד כראוי."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:175
msgid ""
"TSIG record must contain at least algorithm-name, timestamp, fudge, mac, "
"original-id, error, and other-len separated by spaces."
msgstr ""
"רשומת TSIG חייבת לכלול לפחות algorithm-name, timestamp, fudge, mac, original-"
"id, error ו-other-len מופרדים ברווחים."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:183
msgid ""
"TSIG algorithm name must be a valid domain name ending with a dot (e.g., "
"hmac-sha256.)."
msgstr ""
"שם אלגוריתם TSIG חייב להיות שם דומיין תקין המסתיים בנקודה (למשל, hmac-"
"sha256.)."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:189
msgid "TSIG timestamp must be a non-negative integer."
msgstr "חותמת הזמן של TSIG חייבת להיות מספר שלם לא שלילי."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:195
msgid "TSIG fudge must be a non-negative integer."
msgstr "ערך ה-fudge של TSIG חייב להיות מספר שלם לא שלילי."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:201
msgid "TSIG MAC must be a valid base64-encoded string or hexadecimal string."
msgstr ""
"TSIG MAC חייב להיות מחרוזת תקינה המקודדת ב-base64 או מחרוזת הקסדצימלית."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:226
msgid ""
"TSIG MAC is too short. RFC 8945 recommends a minimum of 16 octets for "
"security."
msgstr "TSIG MAC קצר מדי. RFC 8945 ממליץ על מינימום של 16 אוקטטים למען האבטחה."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:231
msgid "TSIG original ID must be a number between 0 and 65535."
msgstr "מזהה מקורי TSIG חייב להיות מספר בין 0 ל 65535."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:237
msgid "TSIG error must be a valid DNS RCODE number between 0 and 23."
msgstr "שגיאת TSIG חייבת להיות מספר RCODE תקין של DNS בין 0 ל-23."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:244
msgid ""
"TSIG error code 16 (BADSIG) indicates that the signature in the TSIG record "
"is invalid. Check keys and crypto configuration."
msgstr ""
"קוד שגיאות TSIG 16 (BADSIG) מציין כי החתימה ברשומה של TSIG אינה בתוקף. בדוק "
"את המפתחות ואת תצורת הקריפטו."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:247
msgid ""
"TSIG error code 17 (BADKEY) indicates that the key used in the TSIG record "
"is invalid. Verify the key is configured on both DNS servers."
msgstr ""
"קוד שגיאות TSIG 17 (BADKEY) מצביע על כך שהמפתח המשמש ברשומות TSIG אינו חוקי. "
"בדוק את המפתח מוגדר בשני שרתי DNS."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:250
msgid ""
"TSIG error code 18 (BADTIME) indicates that the timestamp in the TSIG record "
"is outside the allowed time window. Check clock synchronization."
msgstr ""
"קוד שגיאות TSIG 18 (BADTIME) מצביע על כך שהזמן ברשומות TSIG הוא מחוץ לחלון "
"הזמן המותר. בדוק את הסינכרון של השעון."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:253
msgid ""
"TSIG error code 22 (BADTRUNC) indicates that the truncated MAC in the TSIG "
"record is invalid. Check MAC size configuration."
msgstr ""
"קוד השגיאה TSIG 22 (BADTRUNC) מציין כי ה-MAC המקוצר ברשומת TSIG אינו חוקי. "
"בדוק את תצורת גודל ה-MAC."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:259
msgid "TSIG other-len must be a non-negative integer."
msgstr "הערך other-len של TSIG חייב להיות מספר שלם לא שלילי."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:265
msgid ""
"TSIG other-data must be a valid base64-encoded string or hexadecimal string."
msgstr ""
"הערך other-data של TSIG חייב להיות מחרוזת תקינה המקודדת ב-base64 או מחרוזת "
"הקסדצימלית."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:306
msgid ""
"HMAC-MD5 is considered weak by modern standards. RFC 8945 recommends using "
"HMAC-SHA256 or stronger algorithms."
msgstr ""
"HMAC-MD5 נחשב חלש בסטנדרטים מודרניים. RFC 8945 ממליץ להשתמש ב- HMAC-SHA256 "
"או אלגוריתמים חזקים יותר."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:311
msgid ""
"HMAC-SHA256 is recommended by RFC 8945 as the preferred TSIG algorithm for "
"most deployments."
msgstr ""
"HMAC-SHA256 מומלץ על ידי RFC 8945 כאלגוריתם TSIG המועדף עבור רוב הפריסה."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:319
msgid "TSIG algorithm name must end with a dot."
msgstr "שם אלגוריתם TSIG חייב להסתיים עם נקודה."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:327
msgid "TSIG algorithm name must be a valid domain name ending with a dot."
msgstr "שם אלגוריתם TSIG חייב להיות שם דומיין תקין המסתיים בנקודה."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:331
msgid ""
"Using a non-standard TSIG algorithm name. This may not be widely supported."
msgstr "שימוש בשם אלגוריתם TSIG לא סטנדרטי. ייתכן שאינו נתמך באופן נרחב."

#: lib/Domain/Service/DnsValidation/TSIGRecordValidator.php:332
msgid "RFC 8945 recommends using HMAC-SHA256 as the standard TSIG algorithm."
msgstr "RFC 8945 ממליץ להשתמש HMAC-SHA256 כאלגוריתם TSIG סטנדרטי."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:105
msgid ""
"ZONEMD is defined in RFC 8976 (February 2021) and may not be supported by "
"all DNS servers."
msgstr ""
"ZONEMD מוגדר ב- RFC 8976 (פברואר 2021) ועשוי שלא להיות נתמך על ידי כל שרתי "
"ה-DNS."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:106
msgid "ZONEMD records must be placed at the zone apex (same as SOA record)."
msgstr ""
"רשומות ZONEMD חייבות להיות ממוקמות בקודקוד האזור (apex), כמו רשומת ה-SOA."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:107
msgid ""
"For proper security, zones with ZONEMD records should also be signed with "
"DNSSEC."
msgstr "עבור אבטחה נאותה, אזורים עם רשומות ZONEMD יש לחתום גם עם DNSSEC."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:108
msgid ""
"The serial number in the ZONEMD record should match the zone's SOA serial "
"number."
msgstr ""
"המספר הסידורי ברשומת ZONEMD צריך להתאים למספר הסידורי של ה-SOA של האזור."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:119
msgid ""
"ZONEMD scheme values 240-255 are reserved for private use and may not be "
"interoperable."
msgstr ""
"ערכי הסכימה של ZONEMD בטווח 240-255 שמורים לשימוש פרטי וייתכן שלא יתאפשר "
"איתם תפעול הדדי."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:124
msgid ""
"SHA-384 (algorithm 1) is the recommended hash algorithm for ZONEMD records."
msgstr ""
"SHA-384 (algorithm 1) הוא אלגוריתם הגיבוב (hash) המומלץ עבור רשומות ZONEMD."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:126
msgid ""
"SHA-512 (algorithm 2) provides stronger security but requires more "
"processing resources than SHA-384."
msgstr ""
"SHA-512 (algorithm 2) מספק אבטחה חזקה יותר, אך דורש יותר משאבי עיבוד מאשר "
"SHA-384."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:128
msgid ""
"ZONEMD hash algorithm values 240-255 are reserved for private use and may "
"not be interoperable."
msgstr ""
"ערכי אלגוריתם הגיבוב (hash) של ZONEMD בטווח 240-255 שמורים לשימוש פרטי "
"וייתכן שלא יתאפשר איתם תפעול הדדי."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:154
msgid ""
"ZONEMD record must contain serial, scheme, hash-algorithm, and digest "
"separated by spaces."
msgstr ""
"רשומת ZONEMD חייבת להכיל serial, scheme, hash-algorithm ו-digest מופרדים "
"ברווחים."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:162
msgid ""
"ZONEMD serial must be a number between 0 and 4294967295 (32-bit unsigned "
"integer)."
msgstr ""
"המספר הסידורי (serial) של ZONEMD חייב להיות מספר בין 0 ל-4294967295 (32-bit "
"unsigned integer)."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:173
msgid "ZONEMD scheme must be a number between 0 and 255."
msgstr "סכימת ZONEMD חייבת להיות מספר בין 0 ל-255."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:180
msgid ""
"ZONEMD scheme must be 1 (Simple ZONEMD scheme) for standard use. Other "
"values are reserved or unassigned."
msgstr ""
"סכימת ZONEMD חייבת להיות 1 (Simple ZONEMD scheme) לשימוש סטנדרטי. ערכים "
"אחרים שמורים או לא מוקצים."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:186
msgid "ZONEMD scheme 0 is reserved and not for standard use."
msgstr "סכימת ZONEMD 0 שמורה ואינה מיועדת לשימוש סטנדרטי."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:198
msgid "ZONEMD hash algorithm must be a number between 0 and 255."
msgstr "אלגוריתם הגיבוב (hash) של ZONEMD חייב להיות מספר בין 0 ל-255."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:205
msgid "ZONEMD hash algorithm 0 is reserved and not for standard use."
msgstr "אלגוריתם הגיבוב (hash) 0 של ZONEMD שמור ואינו מיועד לשימוש סטנדרטי."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:211
msgid "ZONEMD digest must be a hexadecimal string."
msgstr "ה-digest של ZONEMD חייב להיות מחרוזת הקסדצימלית."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:217
msgid "ZONEMD digest must be at least 24 hexadecimal characters (12 octets)."
msgstr ""
"ה-digest של ZONEMD חייב להיות באורך של לפחות 24 תווים הקסדצימליים (12 "
"אוקטטים)."

#: lib/Domain/Service/DnsValidation/ZONEMDRecordValidator.php:225
msgid ""
"ZONEMD digest for SHA-384 (algorithm 1) must be exactly 96 hexadecimal "
"characters (48 octets)."
msgstr ""
"ה-digest של ZONEMD עבור SHA-384 (algorithm 1) חייב להיות בדיוק 96 תווים "
"הקסדצימליים (48 אוקטטים)."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:98
msgid "Priority field for CERT records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות CERT חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:102
msgid ""
"Per RFC 4398, consider DNS record size limitations when using CERT records. "
"Large certificates may cause DNS message fragmentation."
msgstr ""
"בהתאם ל-RFC 4398, שקול את מגבלות הגודל של רשומות DNS בעת שימוש ברשומות CERT. "
"תעודות גדולות עלולות לגרום לפיצול הודעות DNS."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:105
msgid "This CERT record content is quite large ("
msgstr "תוכן רשומת CERT זו גדול למדי ("

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:132
msgid "Invalid characters in CERT record content."
msgstr "תווים לא חוקיים בתוכן רשומת CERT."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:138
msgid ""
"CERT record must contain type, key-tag, algorithm and certificate-data "
"separated by spaces."
msgstr ""
"רשומת CERT חייבת לכלול type, key-tag, algorithm ו-certificate-data מופרדים "
"ברווחים."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:164
msgid "CERT type must be a number between 0 and 65535 or a valid mnemonic."
msgstr "סוג CERT חייב להיות מספר בין 0 ל 65535 או mnemonic תקף."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:174
msgid "CERT type value "
msgstr "ערך סוג CERT "

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:180
msgid ""
"CERT type must be a number between 0 and 65535 or a valid mnemonic (PKIX, "
"SPKI, PGP, etc.)."
msgstr ""
"סוג CERT חייב להיות מספר בין 0 ל 65535 או mnemonic תקף (PKIX, SPKI, PGP וכו "
"')."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:186
msgid ""
"URL-based certificate types (IPKIX, ISPKI, IPGP, IACPKIX) introduce "
"additional indirection and potential security concerns."
msgstr ""
"סוגי תעודה מבוססי URL (IPKIX, ISPKI, IPGP, IACPKIX) מציגים עקיפה נוספת "
"ודאגות אבטחה פוטנציאליות."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:191
msgid "CERT key tag must be a number between 0 and 65535."
msgstr "תג המפתח של CERT חייב להיות מספר בין 0 ל 65535."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:215
msgid "CERT algorithm must be a number between 0 and 255 or a valid mnemonic."
msgstr "אלגוריתם CERT חייב להיות מספר בין 0 ל 255 או mnemonic תקף."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:221
msgid ""
"CERT algorithm must be a number between 0 and 255 or a valid mnemonic "
"(RSASHA1, DSA, etc.)."
msgstr ""
"אלגוריתם CERT חייב להיות מספר בין 0 ל 255 או mnemonic תקף (RSASHA1, DSA וכו "
"')."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:199
msgid "Algorithm "
msgstr "אלגוריתם "

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:243
msgid "For URL-based CERT types, the certificate data must be a valid URL."
msgstr "עבור סוגים מבוססי URL CERT, נתוני האישור חייבים להיות כתובת URL בתוקף."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:255
msgid "Certificate data is "
msgstr "נתוני האישור הם "

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:274
msgid ""
"CERT certificate data must contain only valid base64 characters (A-Z, a-z, "
"0-9, +, /, =)."
msgstr ""
"נתוני תעודת CERT חייבים להכיל רק תווי base64 תקינים (A-Z, a-z, 0-9, +, /, =)."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:279
msgid ""
"CERT certificate data has invalid base64 padding. Equals signs (=) should "
"only appear at the end of the data."
msgstr ""
"לנתוני תעודת CERT יש ריפוד (padding) לא חוקי של base64. סימני שוויון (=) "
"צריכים להופיע רק בסוף הנתונים."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:287
msgid ""
"CERT certificate data has invalid base64 length. Base64 data must be a "
"multiple of 4 characters (with padding)."
msgstr ""
"לנתוני תעודת CERT יש אורך base64 לא חוקי. נתוני base64 חייבים להיות כפולה של "
"4 תווים (כולל padding)."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:293
msgid "CERT certificate data must be valid base64-encoded data."
msgstr "נתוני תעודת CERT חייבים להיות נתונים תקינים המקודדים ב-base64."

#: lib/Domain/Service/DnsValidation/CERTRecordValidator.php:298
msgid "CERT certificate data must not be empty after base64 decoding."
msgstr "נתוני תעודת CERT לא יכולים להיות ריקים לאחר פענוח base64."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:81
msgid ""
"IMPORTANT: DLV records have been obsoleted by RFC 8749 (March 2020). Major "
"DNS resolvers have removed or deprecated DLV support. Consider using "
"standard DNSSEC validation with DS records instead."
msgstr ""
"חשוב: רשומות DLV הוצאו משימוש על ידי RFC 8749 (מרץ 2020). פותרי DNS מרכזיים "
"הסירו את התמיכה ב-DLV או הוציאו אותה משימוש. שקול להשתמש באימות DNSSEC "
"סטנדרטי עם רשומות DS במקום זאת."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:93
msgid ""
"This name appears to be in a DLV lookup domain. Note that dlv.isc.org, the "
"main DLV registry, was decommissioned in 2017."
msgstr ""
"נראה ששם זה נמצא בדומיין חיפוש של DLV. שים לב ש-dlv.isc.org, מרשם ה-DLV "
"הראשי, הוצא משירות בשנת 2017."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:117
msgid "Priority field for DLV records must be 0 or empty."
msgstr "שדה עדיפות עבור רשומות DLV חייב להיות 0 או ריק."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:121
msgid ""
"DLV records were typically placed in special DLV registry domains, not in "
"the same domain as the DNSKEY records they reference."
msgstr ""
"רשומות DLV הוצבו בדרך כלל בדומיינים ייעודיים של מרשם DLV, ולא באותו דומיין "
"כמו רשומות ה-DNSKEY שאליהן הן מתייחסות."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:145
msgid ""
"Invalid DLV record format. Expected: <key-tag> <algorithm> <digest-type> "
"<digest>."
msgstr ""
"פורמט רשומת DLV לא חוקי. צפוי: <key-tag> <algorithm> <digest-type> <digest>."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:151
msgid "Invalid DLV record format. Should contain exactly 4 parts."
msgstr "פורמט רשומת DLV לא חוקי. צריך להכיל בדיוק 4 חלקים."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:158
msgid "Invalid key tag. Must be a number between 1 and 65535."
msgstr "תג מפתח לא חוקי צריך להיות מספר בין 1 ל 65535."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:162
msgid ""
"The key tag field does not uniquely identify a DNSKEY. More than one key can "
"have the same key tag."
msgstr ""
"שדה תג המפתח אינו מזהה ייחודי DNSKEY. יותר ממפתח אחד יכול להיות אותו תג מפתח."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:179
msgid "Invalid algorithm. Must be one of the valid DNSSEC algorithms (1-16)."
msgstr "אלגוריתם לא חוקי חייב להיות אחד האלגוריתמים ה-DNSSEC בתוקף (1-16)."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:198
msgid "Invalid digest type. Must be 1 (SHA-1), 2 (SHA-256), or 4 (SHA-384)."
msgstr "סוג digest לא חוקי. חייב להיות 1 (SHA-1), 2 (SHA-256) או 4 (SHA-384)."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:203
msgid ""
"SHA-1 (digest type 1) is considered weak for cryptographic use. Consider "
"using SHA-256 (type 2) or SHA-384 (type 4) instead."
msgstr ""
"SHA-1 (digest type 1) נחשב חלש לשימוש קריפטוגרפי. שקול להשתמש ב-SHA-256 "
"(type 2) או ב-SHA-384 (type 4) במקום זאת."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:211
msgid "Invalid digest length for SHA-1. Should be 40 hexadecimal characters."
msgstr "אורך digest לא חוקי עבור SHA-1. צריך להיות 40 תווים הקסדצימליים."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:216
msgid "Invalid digest length for SHA-256. Should be 64 hexadecimal characters."
msgstr "אורך digest לא חוקי עבור SHA-256. צריך להיות 64 תווים הקסדצימליים."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:221
msgid "Invalid digest length for SHA-384. Should be 96 hexadecimal characters."
msgstr "אורך digest לא חוקי עבור SHA-384. צריך להיות 96 תווים הקסדצימליים."

#: lib/Domain/Service/DnsValidation/DLVRecordValidator.php:228
msgid "Digest must contain only hexadecimal characters (0-9, a-f)."
msgstr "ה-digest חייב להכיל רק תווים הקסדצימליים (0-9, a-f)."

#: lib/Domain/Service/DnsValidation/MXRecordValidator.php:91
msgid "Null MX record (.) must have priority 0 according to RFC 7505."
msgstr "רשומת null MX (.) חייבת להיות בעלת עדיפות 0 על פי RFC 7505."

#: lib/Domain/Service/DnsValidation/MXRecordValidator.php:97
msgid ""
"This is a null MX record (RFC 7505) indicating this domain does not accept "
"email."
msgstr ""
"זוהי רשומת null MX (RFC 7505) המציינת שדומיין זה אינו מקבל דואר אלקטרוני."

#: lib/Domain/Service/DnsValidation/MXRecordValidator.php:98
msgid "A domain with null MX record must not have any other MX records."
msgstr "לדומיין עם רשומת null MX אסור שיהיו רשומות MX אחרות."

#: lib/Domain/Service/DnsValidation/MXRecordValidator.php:104
msgid "Invalid mail server hostname."
msgstr "שם מארח לא חוקי של שרת הדואר."

#: lib/Domain/Service/DnsValidation/MXRecordValidator.php:111
msgid "MX records should not point to CNAME records (RFC 2181)."
msgstr "רשומות MX לא צריכות להצביע על רשומות CNAME (RFC 2181)."

#: lib/Domain/Service/DnsValidation/MXRecordValidator.php:115
msgid "Priority values above 100 are unusual and may be unnecessary."
msgstr "ערכי עדיפות מעל 100 הם יוצאי דופן ועשויים להיות מיותרים."

#: lib/Domain/Service/DnsValidation/MXRecordValidator.php:168
msgid "Invalid value for MX priority field. Must be between 0 and 65535."
msgstr "ערך לא חוקי עבור שדה העדיפות של MX. חייב להיות בין 0 ל-65535."

#: lib/Domain/Service/DnsValidation/HTTPSRecordValidator.php:93
msgid ""
"Priority field should not be used for HTTPS records as priority is part of "
"the content."
msgstr "שדה עדיפות לא צריך לשמש עבור רשומות HTTPS כעדיפות היא חלק מהתוכן."

#: lib/Domain/Service/DnsValidation/HTTPSRecordValidator.php:122
msgid "HTTPS record must contain at least priority and target values."
msgstr "רשומות HTTPS חייבות להכיל לפחות עדיפות וערכי יעד."

#: lib/Domain/Service/DnsValidation/HTTPSRecordValidator.php:129
msgid "HTTPS record priority must be a number between 0 and 65535."
msgstr "העדיפות של רשומת HTTPS חייבת להיות מספר בין 0 ל-65535."

#: lib/Domain/Service/DnsValidation/HTTPSRecordValidator.php:138
msgid ""
"HTTPS record target must be either \".\" or a valid fully-qualified domain "
"name."
msgstr "היעד של רשומת HTTPS חייב להיות \".\" או שם דומיין מלא ותקין."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:155
msgid "In Alias Mode (priority = 0), no SvcParams are allowed."
msgstr "במצב Alias (priority = 0), אין SvcParams מותר."

#: lib/Domain/Service/DnsValidation/HTTPSRecordValidator.php:205
msgid ""
"HTTPS record parameters must be in key=value format separated by spaces."
msgstr "הפרמטרים של רשומת HTTPS חייבים להיות בפורמט key=value מופרדים ברווחים."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:220
#, php-format
msgid "The %s parameter is written without a value or \"=\"."
msgstr "הפרמטר %s נכתב ללא ערך או \"=\"."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:225
#, php-format
msgid "Use the parameter name instead of \"%s\"."
msgstr "השתמש בשם הפרמטר במקום \"%s\"."

#: lib/Domain/Service/DnsValidation/HTTPSRecordValidator.php:216
#, php-format
msgid "Unknown HTTPS parameter key: \"%s\". See RFC 9460 for valid keys."
msgstr "מפתח פרמטר HTTPS לא ידוע: \"%s\". ראו RFC 9460 עבור מפתחות חוקיים."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:229
#, php-format
msgid "The connected PowerDNS version cannot load the %s parameter."
msgstr "גרסת PowerDNS המחוברת אינה יכולה לטעון את הפרמטר %s."

#: lib/Domain/Service/DnsValidation/HTTPSRecordValidator.php:224
#, php-format
msgid "Duplicate HTTPS parameter key: \"%s\". Each key can only appear once."
msgstr "מפתח פרמטר HTTPS כפול: \"%s\". כל מפתח יכול להופיע רק פעם אחת."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:243
msgid "ALPN value must be a comma-separated list of protocol identifiers."
msgstr "ערך ALPN חייב להיות רשימה של מזהי פרוטוקול מופרדים בפסיקים."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:250
msgid "Port value must be a number between 1 and 65535."
msgstr "ערך הפורט חייב להיות מספר בין 1 ל-65535."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:259
#, php-format
msgid "Invalid IPv4 address in ipv4hint: \"%s\"."
msgstr "כתובת IPv4 לא חוקית ב-ipv4hint: \"%s\"."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:269
#, php-format
msgid "Invalid IPv6 address in ipv6hint: \"%s\"."
msgstr "כתובת IPv6 לא חוקית ב-ipv6hint: \"%s\"."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:277
msgid "DoH path must start with a forward slash (/)."
msgstr "נתיב DoH חייב להתחיל בקו נטוי (/)."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:283
msgid "The ech value must be base64 encoded."
msgstr "ערך ה-ech חייב להיות מקודד ב-base64."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:289
msgid ""
"The tls-supported-groups value must be a comma-separated list of numbers "
"between 0 and 65535."
msgstr "ערך ה-tls-supported-groups חייב להיות רשימת מספרים בין 0 ל-65535, מופרדים בפסיקים."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:302
msgid "The mandatory parameter cannot list itself."
msgstr "הפרמטר mandatory אינו יכול לכלול את עצמו."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:304
#, php-format
msgid "Parameter \"%s\" is marked as mandatory but not included in the record."
msgstr "הפרמטר \"%s\" מסומן כחובה אך אינו נכלל ברשומה."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:127
msgid ""
"RFC 2930 requires TKEY records to have TTL=0 to prevent caching. The current "
"non-zero TTL may cause issues with older DNS implementations."
msgstr ""
"RFC 2930 דורש שלרשומות TKEY יהיה TTL=0 כדי למנוע שמירה במטמון. ערך ה-TTL "
"הנוכחי, השונה מאפס, עלול לגרום לבעיות עם יישומי DNS ישנים יותר."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:132
msgid "Priority field for TKEY records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות TKEY חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:136
msgid ""
"TKEY records are not for DNS data authentication, they are for key "
"establishment between DNS servers/resolvers."
msgstr ""
"רשומות TKEY אינן עבור אימות נתונים של DNS, הן מיועדות להקמת מפתח בין שרתי "
"DNS/resolvers."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:161
msgid "Invalid characters in TKEY record content."
msgstr "תווים לא חוקיים בתוכן רשומת TKEY."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:167
msgid ""
"TKEY record must contain algorithm-name, inception-time, expiration-time, "
"mode, error, and key-data separated by spaces."
msgstr ""
"רשומת TKEY חייבת להכיל algorithm-name, inception-time, expiration-time, "
"mode, error ו-key-data, מופרדים ברווחים."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:175
msgid ""
"TKEY algorithm name must be a valid domain name ending with a dot (e.g., "
"hmac-sha256.)."
msgstr ""
"שם האלגוריתם של TKEY חייב להיות שם דומיין תקין המסתיים בנקודה (למשל hmac-"
"sha256.)."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:185
msgid ""
"TKEY inception time must be a valid Unix timestamp or YYYYMMDDHHmmSS format."
msgstr ""
"זמן ההתחלה של TKEY חייב להיות חותמת זמן Unix תקינה או בפורמט YYYYMMDDHHmmSS."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:189
msgid ""
"TKEY expiration time must be a valid Unix timestamp or YYYYMMDDHHmmSS format."
msgstr ""
"זמן התפוגה של TKEY חייב להיות חותמת זמן Unix תקינה או בפורמט YYYYMMDDHHmmSS."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:194
msgid ""
"TKEY mode must be a number between 1 and 5 (1: Server assignment, 2: Diffie-"
"Hellman exchange, 3: GSS-API negotiation, 4: Resolver assignment, 5: Key "
"deletion)."
msgstr ""
"מצב TKEY חייב להיות מספר בין 1 ל-5 (1: הקצאת שרת, 2: חילופי Diffie-Hellman, "
"3: משא ומתן GSS-API, 4: הקצאת resolver, 5: מחיקת מפתח)."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:204
msgid "GSS-API mode (3) ignores inception and expiration times per RFC 3645."
msgstr "מצב GSS-API (3) מתעלם מזמני ההתחלה והתפוגה בהתאם ל-RFC 3645."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:208
msgid "GSS-API mode requires key data to contain a GSS-API token."
msgstr "מצב GSS-API דורש שנתוני המפתח יכילו אסימון GSS-API."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:211
msgid ""
"Diffie-Hellman mode should be authenticated using TSIG or SIG(0) to prevent "
"man-in-the-middle attacks."
msgstr ""
"מצב Diffie-Hellman צריך להיות מאומת באמצעות TSIG או SIG(0) כדי למנוע התקפות "
"אדם-באמצע."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:213
msgid ""
"Key deletion operations MUST be authenticated using TSIG with the key being "
"deleted."
msgstr "פעולות מחיקת מפתח חייבות להיות מאומתות באמצעות TSIG עם המפתח הנמחק."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:218
msgid "TKEY error must be a valid DNS RCODE number between 0 and 23."
msgstr "שגיאת TKEY חייבת להיות מספר RCODE תקין של DNS בין 0 ל-23."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:223
msgid ""
"TKEY key data must be valid base64-encoded data or a hexadecimal string."
msgstr ""
"נתוני המפתח של TKEY חייבים להיות נתונים מקודדים ב-base64 או מחרוזת "
"הקסדצימלית."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:227
msgid ""
"TKEY established keys are associated with DNS servers/resolvers, not zones."
msgstr "מפתחות מבוססים TKEY קשורים לשרתי DNS/resolvers, לא לאזורים."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:228
msgid ""
"TKEY record exchanges should be secured - authentication depends on mode "
"used."
msgstr "יש לאבטח את חילופי רשומות TKEY - האימות תלוי במצב שבו נעשה שימוש."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:281
msgid ""
"Legacy algorithm detected. HMAC-SHA256 or stronger is recommended for better "
"security."
msgstr "אלגוריתם Legacy זוהה. HMAC-SHA256 או חזק יותר מומלץ לאבטחה טובה יותר."

#: lib/Domain/Service/DnsValidation/TKEYRecordValidator.php:304
msgid ""
"Custom algorithm name detected. Standard algorithm names like \"hmac-"
"sha256.\" are recommended for better compatibility."
msgstr ""
"זוהה שם אלגוריתם מותאם אישית. שמות אלגוריתם סטנדרטיים כמו \"hmac-sha256.\" "
"מומלצים לתאימות טובה יותר."

#: lib/Domain/Service/DnsValidation/TTLValidator.php:74
msgid ""
"Invalid value for default TTL. It must be a number between 0 and 2147483647."
msgstr ""
"ערך לא חוקי עבור ברירת מחדל TTL. זה חייב להיות מספר בין 0 ל 2147483647."

#: lib/Domain/Service/DnsValidation/TTLValidator.php:96
msgid "Invalid value for TTL field. It must be numeric."
msgstr "ערך לא חוקי עבור שדה TTL. זה חייב להיות מספרי."

#: lib/Domain/Service/DnsValidation/TTLValidator.php:103
msgid "TTL value cannot be negative. It must be 0 or higher."
msgstr "ערך TTL אינו יכול להיות שלילי. זה חייב להיות 0 או גבוה יותר."

#: lib/Domain/Service/DnsValidation/TTLValidator.php:108
#, php-format
msgid ""
"TTL value exceeds maximum allowed (%d). RFC 2181 limits it to a signed 32-"
"bit integer."
msgstr ""
"ערך TTL עולה על המקסימום המותר (%d). RFC 2181 מגביל אותו למספר שלם חתום של "
"32 סיביות."

#: lib/Domain/Service/DnsValidation/TTLValidator.php:141
#, php-format
msgid ""
"TTL value (%d) is below the recommended minimum of %d seconds (5 minutes). "
"Low TTL values increase DNS traffic."
msgstr ""
"ערך TTL (%d) הוא מתחת למינימום המומלצת של %d שניות (5 דקות). ערכי TTL נמוכים "
"מגבירים את התנועה DNS."

#: lib/Domain/Service/DnsValidation/TTLValidator.php:150
#, php-format
msgid ""
"TTL value (%d) is above the recommended maximum of %d seconds (1 week). High "
"TTL values delay DNS updates."
msgstr ""
"ערך TTL (%d) הוא מעל למקסימום המומלצת של %d שניות (1 שבועות). ערכי TTL "
"גבוהים מעכבים עדכוני DNS."

#: lib/Domain/Service/DnsValidation/TTLValidator.php:160
#, php-format
msgid ""
"SOA record TTL (%d) is below the recommended minimum of %d seconds (1 hour)."
msgstr ""
"ערך ה-TTL של רשומת SOA (%d) נמוך מהמינימום המומלץ של %d שניות (שעה אחת)."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:126
msgid ""
"URI records should be protected with DNSSEC to prevent manipulation by "
"attackers."
msgstr ""
"רשומות URI צריך להיות מוגן עם DNSSEC כדי למנוע מניפולציה על ידי תוקפים."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:190
msgid "Consider using HTTPS instead of HTTP for better security."
msgstr "שקול להשתמש ב- HTTPS במקום HTTP לאבטחה טובה יותר."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:194
msgid "FTP is considered less secure than alternatives like SFTP or HTTPS."
msgstr "FTP נחשב פחות בטוח מאשר חלופות כגון SFTP או HTTPS."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:198
msgid "Consider using LDAPS (LDAP over SSL/TLS) for securing LDAP connections."
msgstr "שקול באמצעות LDAPS (LDAP על SSL/TLS) לאבטחת חיבורי LDAP."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:203
msgid "Phone-related URI schemes may contain sensitive personal information."
msgstr "סכמות URI הקשורות לטלפון עשויות להכיל מידע אישי רגיש."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:207
msgid ""
"The \"file\" URI scheme may pose security risks and is not recommended for "
"public DNS records."
msgstr ""
"סכמת ה-URI \"file\" עלולה להוות סיכוני אבטחה ואינה מומלצת לרשומות DNS "
"ציבוריות."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:228
msgid "URI record must be in the format: <priority> <weight> \"<target URI>\""
msgstr "רשומת URI חייבת להיות בפורמט: <priority> <weight> \"<target URI>\""

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:238
msgid "URI priority must be between 0 and 65535 (16-bit unsigned integer)."
msgstr "עדיפות URI צריכה להיות בין 0 ל 65535 (16 סיביות ללא חתימה)."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:244
msgid "URI weight must be between 0 and 65535 (16-bit unsigned integer)."
msgstr "משקל URI חייב להיות בין 0 ל 65535 (16 סיביות ללא חתימה)."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:250
msgid "URI must not be empty."
msgstr "שדה ה-URI לא יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:256
msgid ""
"URI must start with a valid scheme that begins with a letter followed by "
"letters, digits, plus, period, or hyphen."
msgstr ""
"URI חייב להתחיל בסכמה תקינה שמתחילה באות ואחריה אותיות, ספרות, סימן חיבור, "
"נקודה או מקף."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:265
msgid ""
"URI uses an uncommon protocol. Consider using a standard URI scheme for "
"better compatibility."
msgstr ""
"URI משתמש בפרוטוקול נדיר. שקול להשתמש בסכמת URI סטנדרטית לתאימות טובה יותר."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:274
msgid "URI with this protocol must include \"://\" after the protocol name."
msgstr "URI עם פרוטוקול זה חייב לכלול \"://\" לאחר שם הפרוטוקול."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:283
msgid "HTTP/HTTPS URIs must include a hostname."
msgstr "HTTP/HTTPS URIs חייב לכלול שם מארח."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:289
msgid "URI must not contain control characters."
msgstr "URI לא יכול להכיל תווי בקרה."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:295
msgid ""
"URI contains backslash characters, which may be interpreted differently "
"across systems."
msgstr "URI מכיל תווי לוכסן הפוך, שעשויים להתפרש באופן שונה במערכות שונות."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:299
msgid ""
"URI contains \"..\" sequences, which may be used for directory traversal "
"attacks."
msgstr "URI מכיל רצפי \"..\", שעשויים לשמש להתקפות מעבר בין תיקיות."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:306
msgid ""
"URI contains percent characters not used for properly formatted percent-"
"encoding."
msgstr "URI מכיל תווי אחוז שאינם משמשים לקידוד אחוזים בפורמט תקין."

#: lib/Domain/Service/DnsValidation/URIRecordValidator.php:314
msgid ""
"URI contains non-ASCII characters in hostname. Consider using Punycode for "
"international domain names."
msgstr ""
"URI מכיל תווים שאינם ASCII בשם המארח. שקול להשתמש ב-Punycode עבור שמות "
"דומיין בינלאומיים."

#: lib/Domain/Service/DnsValidation/KXRecordValidator.php:85
msgid ""
"Invalid key exchanger hostname. The exchanger field must be a valid domain "
"name."
msgstr ""
"שם מארח לא חוקי של מחליף המפתחות. שדה המחליף חייב להיות שם דומיין חוקי."

#: lib/Domain/Service/DnsValidation/KXRecordValidator.php:117
msgid ""
"IMPORTANT: RFC 2230 requires KX records to be signed using DNSSEC. Unsigned "
"KX records MUST be ignored for security reasons."
msgstr ""
"חשוב: RFC 2230 דורש שרשומות KX ייחתמו באמצעות DNSSEC. יש להתעלם מרשומות KX "
"לא חתומות מסיבות אבטחה."

#: lib/Domain/Service/DnsValidation/KXRecordValidator.php:118
msgid ""
"Systems not implementing Secure DNS should ignore KX records entirely "
"according to RFC 2230."
msgstr ""
"מערכות שאינן מיישמות DNS מאובטח צריכות להתעלם לחלוטין מרשומות KX בהתאם ל-RFC "
"2230."

#: lib/Domain/Service/DnsValidation/KXRecordValidator.php:123
msgid ""
"Ensure that the key exchanger host has appropriate forward and reverse DNS "
"records configured."
msgstr "ודא שלמארח מחליף המפתחות מוגדרות רשומות DNS מתאימות קדימה ולאחור."

#: lib/Domain/Service/DnsValidation/KXRecordValidator.php:124
msgid ""
"The key exchanger host should have appropriate A/AAAA records for type A/"
"AAAA additional section processing."
msgstr ""
"למארח מחליף המפתחות צריכות להיות רשומות A/AAAA מתאימות עבור עיבוד המקטע "
"הנוסף מסוג A/AAAA."

#: lib/Domain/Service/DnsValidation/KXRecordValidator.php:160
msgid "Invalid value for KX preference field. Must be between 0 and 65535."
msgstr "ערך לא חוקי עבור שדה ההעדפה של KX. חייב להיות בין 0 ל-65535."

#: lib/Domain/Service/DnsValidation/MINFORecordValidator.php:83
msgid ""
"NOTE: The MINFO record type is marked as EXPERIMENTAL in RFC 1035. It may "
"not be universally supported."
msgstr ""
"הערה: סוג הרשומה MINFO מסומן כניסיוני (EXPERIMENTAL) ב-RFC 1035. ייתכן שאינו "
"נתמך באופן אוניברסלי."

#: lib/Domain/Service/DnsValidation/MINFORecordValidator.php:95
msgid "MINFO record content cannot be empty."
msgstr "תוכן רישום MINFO לא יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/MINFORecordValidator.php:101
msgid ""
"MINFO record must contain both responsible mailbox and error mailbox "
"separated by a space (RFC 1035 Section 3.3.7)."
msgstr ""
"רשומת MINFO חייבת לכלול גם את תיבת הדואר האחראית וגם את תיבת דואר השגיאות, "
"מופרדות ברווח (RFC 1035 סעיף 3.3.7)."

#: lib/Domain/Service/DnsValidation/MINFORecordValidator.php:112
msgid "Invalid responsible mailbox hostname (RMAILBX)."
msgstr "שם מארח לא חוקי של תיבת הדואר האחראית (RMAILBX)."

#: lib/Domain/Service/DnsValidation/MINFORecordValidator.php:120
msgid ""
"RFC 1035 notes that many mailing lists use a mailbox \"list-name-request\" "
"for the responsible mailbox field."
msgstr ""
"RFC 1035 מציין כי רשימות דיוור רבות משתמשות בתיבת דואר \"list-name-request\" "
"עבור שדה תיבת הדואר האחראית."

#: lib/Domain/Service/DnsValidation/MINFORecordValidator.php:125
msgid ""
"Using \".\" (root) for RMAILBX indicates that the owner of the MINFO record "
"is responsible for itself."
msgstr ""
"השימוש ב-\".\" (שורש) עבור RMAILBX מציין כי הבעלים של רשומת ה-MINFO אחראי "
"לעצמו."

#: lib/Domain/Service/DnsValidation/MINFORecordValidator.php:132
msgid "Invalid error mailbox hostname (EMAILBX)."
msgstr "שם המארח של תיבת דואר השגיאות (EMAILBX) לא חוקי."

#: lib/Domain/Service/DnsValidation/MINFORecordValidator.php:140
msgid ""
"Using \".\" (root) for EMAILBX indicates that errors should be returned to "
"the sender of the message."
msgstr ""
"השימוש ב-\".\" (שורש) עבור EMAILBX מציין כי יש להחזיר שגיאות לשולח ההודעה."

#: lib/Domain/Service/DnsValidation/MINFORecordValidator.php:145
msgid ""
"The responsible mailbox and error mailbox are identical. Consider using "
"different mailboxes for these functions."
msgstr ""
"תיבת הדואר האחראית ותיבת דואר השגיאות זהות. שקול להשתמש בתיבות דואר שונות "
"עבור פונקציות אלה."

#: lib/Domain/Service/DnsValidation/MINFORecordValidator.php:158
msgid ""
"Priority field for MINFO records must be 0 or empty. MINFO does not use "
"priority values per RFC 1035."
msgstr ""
"שדה עדיפות עבור רשומות MINFO חייב להיות 0 או ריק. MINFO אינו משתמש בערכי "
"עדיפות בהתאם ל-RFC 1035."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:141
msgid "Priority field for SPF records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות SPF חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:154
msgid "SPF record must start with \"v=spf1\""
msgstr "רשומת SPF חייבת להתחיל ב-\"v=spf1\""

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:160
msgid ""
"SPF record exceeds 255 character limit. Split across multiple TXT records."
msgstr "רשומת SPF חורגת ממגבלת 255 התווים. פצל אותה למספר רשומות TXT."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:188
msgid ""
"Multiple \"all\" mechanisms found. Only the first one will be effective."
msgstr "נמצאו מספר מנגנוני \"all\". רק הראשון יהיה בתוקף."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:198
#, php-format
msgid "Duplicate %s modifier found. Each modifier can appear at most once."
msgstr "נמצא מגדיר %s כפול. כל מגדיר יכול להופיע פעם אחת לכל היותר."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:212
msgid "Invalid IPv4 address or network in ip4 mechanism."
msgstr "כתובת IPv4 או רשת לא חוקית במנגנון ip4."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:218
msgid "Invalid IPv6 address or network in ip6 mechanism."
msgstr "כתובת IPv6 או רשת לא חוקית במנגנון ip6."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:232
#, php-format
msgid "Invalid domain name in %s mechanism."
msgstr "שם דומיין לא חוקי במנגנון %s."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:238
#, php-format
msgid "CIDR notation is not valid with the %s mechanism."
msgstr "סימון CIDR אינו תקף עם מנגנון %s."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:241
msgid "Invalid CIDR length in mechanism."
msgstr "אורך CIDR לא חוקי במנגנון."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:248
msgid ""
"The ptr mechanism is not recommended due to performance issues (RFC 7208 "
"Section 5.5)."
msgstr "מנגנון ptr אינו מומלץ עקב בעיות ביצועים (RFC 7208 סעיף 5.5)."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:255
msgid ""
"The \"all\" mechanism should be the last mechanism in the record (RFC 7208 "
"Section 5.1)."
msgstr "מנגנון \"all\" צריך להיות המנגנון האחרון ברשומה (RFC 7208 סעיף 5.1)."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:264
msgid "Invalid domain in redirect modifier."
msgstr "דומיין לא חוקי במגדיר redirect."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:269
msgid "Invalid domain in exp modifier."
msgstr "דומיין לא חוקי במגדיר exp."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:273
#, php-format
msgid "Unknown modifier: %s"
msgstr "מגדיר לא ידוע: %s"

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:279
#, php-format
msgid "Unknown mechanism: %s"
msgstr "מנגנון לא ידוע: %s"

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:286
msgid ""
"SPF record should have either a terminating \"all\" mechanism or a "
"\"redirect\" modifier (RFC 7208 Section 4.6.2)."
msgstr ""
"רשומת SPF צריכה לכלול מנגנון \"all\" מסיים או מגדיר \"redirect\" (RFC 7208 "
"סעיף 4.6.2)."

#: lib/Domain/Service/DnsValidation/SPFRecordValidator.php:291
msgid ""
"SPF record has both \"all\" mechanism and \"redirect\" modifier. The "
"\"redirect\" modifier will be ignored when \"all\" is present (RFC 7208 "
"Section 6.1)."
msgstr ""
"רשומת SPF כוללת גם מנגנון \"all\" וגם מגדיר \"redirect\". יש להתעלם מהמגדיר "
"\"redirect\" כאשר \"all\" קיים (RFC 7208 סעיף 6.1)."

#: lib/Domain/Service/DnsValidation/CNAMERecordValidator.php:196
msgid ""
"Invalid value for priority field. CNAME records must have priority value of "
"0."
msgstr ""
"ערך לא חוקי עבור שדה העדיפות. רשומות CNAME חייבות להיות בעלות ערך עדיפות 0."

#: lib/Domain/Service/DnsValidation/CNAMERecordValidator.php:213
msgid ""
"This is not a valid CNAME. There already exists a record with this name."
msgstr "זהו אינו CNAME חוקי. כבר קיימת רשומה עם שם זה."

#: lib/Domain/Service/DnsValidation/CNAMERecordValidator.php:233
msgid ""
"This is not a valid CNAME. Did you assign an MX or NS record to the record?"
msgstr "זהו אינו CNAME חוקי. האם הקצית רשומת MX או NS לרשומה זו?"

#: lib/Domain/Service/DnsValidation/CNAMERecordValidator.php:251
msgid "Empty CNAME records are not allowed."
msgstr "רשומות CNAME ריקות אינן מורשות."

#: lib/Domain/Service/DnsValidation/CNAMERecordValidator.php:269
msgid ""
"This is not a valid record. There already exists a CNAME with this name."
msgstr "זו אינה רשומה חוקית. כבר קיים CNAME עם שם זה."

#: lib/Domain/Service/DnsValidation/CNAMERecordValidator.php:313
msgid ""
"CNAME target must be a fully qualified domain name (FQDN) with a valid top-"
"level domain."
msgstr ""
"המטרה של CNAME חייבת להיות שם דומיין מוסמך לחלוטין (FQDN) עם דומיין ברמה "
"עליונה תקין."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:82
msgid "Invalid characters in DHCID record content."
msgstr "תווים לא חוקיים בתוכן רשומת DHCID."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:101
msgid ""
"As per RFC 4701 and RFC 4703, DHCID records should be placed at the same "
"name as the A or AAAA records they correspond to."
msgstr ""
"בהתאם ל-RFC 4701 ול-RFC 4703, יש למקם רשומות DHCID באותו שם כמו רשומות ה-A "
"או ה-AAAA שאליהן הן מתאימות."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:114
msgid "Priority field for DHCID records must be 0 or empty."
msgstr "שדה עדיפות עבור רשומות DHCID חייב להיות 0 או ריק."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:118
msgid ""
"Per RFC 4703, DHCID records are used for collision detection when multiple "
"DHCP clients claim the same name. The presence of a DHCID record indicates "
"the name is in use by a DHCP client."
msgstr ""
"לפי RFC 4703, רשומות DHCID משמשות לזיהוי התנגשויות כאשר מספר לקוחות DHCP "
"טוענים לאותו שם. נוכחות של רשומת DHCID מעידה שהשם נמצא בשימוש על ידי לקוח "
"DHCP."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:145
msgid ""
"DHCID record must contain only valid base64 characters (A-Z, a-z, 0-9, +, /, "
"=)."
msgstr ""
"רשומת DHCID חייבת להכיל רק תווי base64 חוקיים (A-Z, a-z, 0-9, +, /, =)."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:151
msgid ""
"DHCID record has invalid base64 padding. Equals signs (=) should only appear "
"at the end of the data."
msgstr ""
"לרשומת DHCID יש ריפוד base64 לא חוקי. סימני שוויון (=) צריכים להופיע רק בסוף "
"הנתונים."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:160
msgid ""
"DHCID record has invalid base64 length. Base64 data must be a multiple of 4 "
"characters (with padding)."
msgstr ""
"לרשומת DHCID יש אורך base64 לא חוקי. נתוני base64 חייבים להיות כפולה של 4 "
"תווים (כולל ריפוד)."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:166
msgid "DHCID record must contain valid base64-encoded data."
msgstr "רשומת DHCID חייבת להכיל נתונים תקינים המקודדים ב-base64."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:175
msgid ""
"DHCID record is too short. The decoded data must contain at least 3 bytes "
"(type codes and digest)."
msgstr ""
"רשומת DHCID קצרה מדי. הנתונים המפוענחים חייבים להכיל לפחות 3 בתים (קודי סוג "
"ותקציר)."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:184
#, php-format
msgid ""
"DHCID identifier type 0x%04X is not one of the standard types defined in RFC "
"4701 (0x0000, 0x0001, 0x0002)."
msgstr ""
"DHCID מזהה סוג 0x%04X אינו אחד מסוגים סטנדרטיים המוגדרים ב- RFC 4701 "
"(0x0000, 0x0001, 0x0002)."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:192
#, php-format
msgid ""
"DHCID digest type %d is not the standard type (1 for SHA-256) defined in RFC "
"4701."
msgstr ""
"סוג התקציר %d של DHCID אינו הסוג הסטנדרטי (1 עבור SHA-256) המוגדר ב-RFC 4701."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:197
msgid ""
"DHCID record with SHA-256 digest (type 1) must be at least 35 bytes when "
"decoded (2 for identifier type, 1 for digest type, 32 for SHA-256 digest)."
msgstr ""
"רשומת DHCID עם תקציר SHA-256 (סוג 1) חייבת להיות באורך 35 בתים לפחות לאחר "
"הפענוח (2 עבור סוג המזהה, 1 עבור סוג התקציר, 32 עבור תקציר SHA-256)."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:201
msgid ""
"DHCID records should be updated only by authorized DHCP clients or servers "
"to prevent conflicts and unauthorized DNS updates."
msgstr ""
"רשומות DHCID צריכות להיות מעודכנים רק על ידי לקוחות מורשים של DHCP או שרתים "
"כדי למנוע סכסוכים ועדכוני DNS לא מורשים."

#: lib/Domain/Service/DnsValidation/DHCIDRecordValidator.php:202
msgid ""
"Consider using DNSSEC or TSIG authentication (RFC 3007) for secure DHCID "
"updates as recommended by RFC 4701."
msgstr ""
"שקול באמצעות אימות DNSSEC או TSIG (RFC 3007) עבור עדכונים מאובטח DHCID כפי "
"מומלץ על ידי RFC 4701."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:86
msgid "Hostname contains invalid characters."
msgstr "שם המארח מכיל תווים לא חוקיים."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:135
msgid "Priority field for RRSIG records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות RRSIG חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:139
msgid ""
"RRSIG records should only be created by your DNS server when signing a zone. "
"Manual manipulation is not recommended."
msgstr ""
"רשומות RRSIG צריכות להיווצר רק על ידי שרת ה- DNS שלך בעת חתימה על אזור. "
"מניפולציה ידנית אינה מומלצת."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:140
msgid ""
"Regular key rollovers are recommended security practice: ZSK every 1-3 "
"months, KSK every 1-2 years."
msgstr ""
"החלפות מפתח סדירות הן נוהג אבטחה מומלץ: ZSK כל 1-3 חודשים, KSK כל 1-2 שנים."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:163
msgid "RRSIG record content cannot be empty."
msgstr "תוכן רישום RRSIG אינו יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:168
msgid "RRSIG record contains invalid characters."
msgstr "רשומת RRSIG מכילה תווים לא חוקיים."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:174
msgid ""
"RRSIG record must contain covered-type, algorithm, labels, original TTL, "
"expiration, inception, key tag, signer name and signature."
msgstr ""
"רשומת RRSIG חייבת להכיל סוג מכוסה, אלגוריתם, תוויות, TTL מקורי, זמן תפוגה, "
"זמן התחלה, תג מפתח, שם החותם וחתימה."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:182
msgid "RRSIG covered type must be a valid DNS record type."
msgstr "סוג מכוסה RRSIG חייב להיות סוג של רשומות DNS בתוקף."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:187
msgid "RRSIG algorithm field must be a numeric value."
msgstr "שדה אלגוריתם RRSIG חייב להיות ערך מספרי."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:193
msgid ""
"Algorithm 1 (RSA/MD5) is deprecated and should NOT be used due to "
"cryptographic weaknesses."
msgstr ""
"Algorithm 1 (RSA/MD5) הוא deprecated ולא צריך לשמש בשל חולשות קריפטוגרפיים."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:195
msgid ""
"Algorithm 3 (DSA/SHA1) is considered insecure and should be replaced with "
"stronger algorithms."
msgstr ""
"Algorithm 3 (DSA/SHA1) נחשב חסר ביטחון ויש להחליף אותו באלגוריתמים חזקים "
"יותר."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:197
msgid ""
"Algorithm 5 (RSA/SHA-1) is considered insecure and should be replaced with "
"stronger algorithms."
msgstr ""
"Algorithm 5 (RSA/SHA-1) נחשב חסר ביטחון ויש להחליף אותו באלגוריתמים חזקים "
"יותר."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:199
msgid ""
"Algorithm 7 (RSASHA1-NSEC3-SHA1) uses SHA-1 which is no longer considered "
"secure. Consider using RSA/SHA-256 or newer algorithms."
msgstr ""
"Algorithm 7 (RSASHA1-NSEC3-SHA1) משתמש SHA-1 שכבר אינו נחשב בטוח. שקול "
"באמצעות RSA/SHA-256 או אלגוריתמים חדשים יותר."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:203
msgid ""
"Algorithm 10 (RSA/SHA-512) provides strong security but may have "
"interoperability issues with some validators."
msgstr ""
"Algorithm 10 (RSA/SHA-512) מספק אבטחה חזקה אך עלול לגרום לבעיות תאימות עם "
"חלק מהמאמתים."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:205
msgid ""
"Algorithm 13 (ECDSA P-256 with SHA-256) provides good security with smaller "
"signatures than RSA."
msgstr ""
"Algorithm 13 (ECDSA P-256 עם SHA-256) מספק אבטחה טובה עם חתימה קטנה יותר "
"מאשר RSA."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:207
msgid ""
"Algorithm 14 (ECDSA P-384 with SHA-384) provides strong security with "
"smaller signatures than RSA."
msgstr ""
"Algorithm 14 (ECDSA P-384 עם SHA-384) מספק אבטחה חזקה עם חתימות קטנות יותר "
"מאשר RSA."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:209
msgid ""
"Algorithm 15 (ED25519) offers modern security but may have compatibility "
"issues with older DNSSEC validators."
msgstr ""
"Algorithm 15 (ED25519) מציע אבטחה מודרנית, אך ייתכנו בעיות תאימות עם מאמתי "
"DNSSEC ישנים יותר."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:211
msgid ""
"Algorithm 16 (ED448) offers strong modern security but may have "
"compatibility issues with older DNSSEC validators."
msgstr ""
"Algorithm 16 (ED448) מציע אבטחה מודרנית חזקה, אך ייתכנו בעיות תאימות עם "
"מאמתי DNSSEC ישנים יותר."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:213
msgid ""
"Unknown algorithm value. Only algorithms defined in RFCs should be used."
msgstr "ערך אלגוריתם לא ידוע. יש להשתמש רק באלגוריתמים המוגדרים ב-RFC."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:222
msgid "RRSIG labels field must be a numeric value."
msgstr "שדה תוויות RRSIG חייב להיות ערך מספרי."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:228
msgid "RRSIG labels field must be a reasonable value (0-128)."
msgstr "שדה תוויות RRSIG חייב להיות ערך סביר (0-128)."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:233
msgid "RRSIG original TTL field must be a numeric value."
msgstr "שדה TTL המקורי RRSIG חייב להיות ערך מספרי."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:238
msgid "RRSIG original TTL must be a valid positive integer."
msgstr "ה-TTL המקורי של RRSIG חייב להיות מספר שלם חיובי תקף."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:242
msgid ""
"Original TTL is greater than 1 day (86400). For DNSSEC records, shorter TTLs "
"are generally preferred for faster recovery in case of key compromise."
msgstr ""
"ה-TTL המקורי גדול מיום אחד (86400). עבור רשומות DNSSEC, ערכי TTL קצרים יותר "
"מועדפים בדרך כלל לצורך התאוששות מהירה יותר במקרה של דליפת מפתח."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:247
msgid "RRSIG expiration must be in YYYYMMDDHHmmSS format."
msgstr "תפוגת RRSIG חייבת להיות בפורמט YYYYMMDDHHmmSS."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:252
msgid "RRSIG inception must be in YYYYMMDDHHmmSS format."
msgstr "תחילת התוקף של RRSIG חייבת להיות בפורמט YYYYMMDDHHmmSS."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:264
msgid ""
"The expiration time must be later than the inception time. This signature "
"appears to have expired before it became valid."
msgstr ""
"זמן התפוגה חייב להיות מאוחר יותר מזמן תחילת התוקף. נראה כי תוקף החתימה הזו "
"פג עוד לפני שהפכה לתקפה."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:271
msgid ""
"CRITICAL: This signature has already expired. It will not be validated by "
"DNSSEC resolvers."
msgstr "CRITICAL: החתימה הזו כבר הסתיימה. זה לא יאומת על ידי פותרי DNSSEC."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:273
msgid ""
"WARNING: This signature will expire within the next 7 days. Consider "
"renewing it soon."
msgstr "אזהרה: חתימה זו תפוג בתוך 7 הימים הבאים. לשקול לחדש אותו בקרוב."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:275
msgid "This signature will expire within the next 30 days. Plan for renewal."
msgstr "חתימה זו תפוג בתוך 30 הימים הבאים. יש לתכנן את חידושה."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:280
msgid ""
"WARNING: This signature is not yet valid. It will not be validated by DNSSEC "
"resolvers until the inception time is reached."
msgstr ""
"אזהרה: החתימה הזו עדיין לא תקפה. היא לא תאומת על ידי פותרי DNSSEC עד שיגיע "
"זמן תחילת התוקף."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:287
msgid ""
"The signature validity period is over 90 days, which is longer than "
"recommended practices. Long validity periods increase vulnerability in case "
"of key compromise."
msgstr ""
"תקופת התוקף של החתימה היא מעל 90 ימים, ארוכה יותר מהשיטות המומלצות. תקופות "
"תוקף ארוכות מגבירות את הפגיעות במקרה של דליפת מפתח."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:291
msgid "Could not parse signature timestamps to check validity period."
msgstr "לא ניתן לנתח את חותמות הזמן של החתימה כדי לבדוק את תקופת התוקף."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:296
msgid "RRSIG key tag field must be a numeric value."
msgstr "שדה תג מפתח RRSIG חייב להיות ערך מספרי."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:301
msgid "RRSIG key tag must be a valid value between 0 and 65535."
msgstr "תג מפתח RRSIG חייב להיות ערך תקף בין 0 ל 65535."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:306
msgid ""
"RRSIG signer name must be a fully qualified domain name (end with a dot)."
msgstr "שם החותם של RRSIG חייב להיות שם דומיין מוסמך לחלוטין (מסתיים בנקודה)."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:312
msgid "RRSIG signer name must be a valid domain name."
msgstr "שם החותם של RRSIG חייב להיות שם דומיין חוקי."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:317
msgid "RRSIG signature cannot be empty."
msgstr "חתימת RRSIG לא יכולה להיות ריקה."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:322
msgid ""
"The signature does not appear to be valid base64 encoded data. RRSIG "
"signatures should be base64 encoded."
msgstr ""
"החתימה אינה נראית כנתונים תקינים המקודדים ב-base64. חתימות RRSIG צריכות "
"להיות מקודדות ב-base64."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:326
msgid ""
"RRSIG records are part of DNSSEC and provide cryptographic signatures for "
"DNS records. They should be managed automatically by the DNS server."
msgstr ""
"רשומות RRSIG הן חלק מ-DNSSEC ומספקות חתימות הצפנה עבור רשומות DNS. הם צריכים "
"להיות מנוהלים באופן אוטומטי על ידי שרת ה- DNS."

#: lib/Domain/Service/DnsValidation/RRSIGRecordValidator.php:327
msgid ""
"Remember that RRSIG records must be regenerated before their expiration date "
"to maintain DNSSEC validation."
msgstr ""
"זכור כי יש ליצור מחדש רשומות RRSIG לפני תאריך התפוגה שלהן כדי לשמור על אימות "
"DNSSEC."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:119
msgid "Priority field for RP records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות RP חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:123
msgid ""
"RP records were defined in RFC 1183 (1990) and are not widely used in modern "
"DNS configurations."
msgstr ""
"רשומות RP הוגדרו ב- RFC 1183 (1990) ולא בשימוש נרחב בתצורת DNS המודרנית."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:124
msgid ""
"Consider including other contact methods besides RP records for critical "
"domains."
msgstr ""
"שקול לכלול שיטות נוספות ליצירת קשר מלבד רשומות RP עבור דומיינים קריטיים."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:125
msgid "Type code for RP records is 17."
msgstr "סוג קוד עבור רשומות RP הוא 17."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:148
msgid "RP record content cannot be empty."
msgstr "תוכן רשומת RP לא יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:153
msgid "RP record contains invalid characters."
msgstr "רשומת RP מכילה תווים לא חוקיים."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:159
msgid ""
"RP record must contain mailbox-domain (mbox-dname) and txt-record-domain "
"(txt-dname)."
msgstr ""
"רשומת RP חייבת לכלול דומיין של תיבת דואר (mbox-dname) ודומיין של רשומת txt "
"(txt-dname)."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:187
msgid ""
"RP records expose contact information in DNS which can create privacy and "
"security concerns."
msgstr ""
"רשומות RP חושפות מידע ליצירת קשר ב-DNS, מה שעלול ליצור בעיות פרטיות ואבטחה."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:188
msgid ""
"The RP record is less commonly used today. Consider using WHOIS records or "
"other contact mechanisms instead."
msgstr ""
"רשומת ה-RP פחות נפוצה כיום. שקול להשתמש ברשומות WHOIS או במנגנונים אחרים "
"ליצירת קשר במקומה."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:189
msgid ""
"Ensure corresponding TXT records exist for the txt-dname field if not using "
"a dot (.)."
msgstr ""
"ודא כי קיימות רשומות TXT מתאימות עבור השדה txt-dname אם אינך משתמש בנקודה "
"(.)."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:207
msgid ""
"Using \".\" for the mailbox domain indicates no responsible person is "
"specified. This is not recommended for production domains."
msgstr ""
"שימוש ב-\".\" עבור דומיין תיבת הדואר מציין שלא צוין אדם אחראי. הדבר אינו "
"מומלץ עבור דומיינים בסביבת ייצור."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:213
msgid ""
"RP mailbox domain must be a fully qualified domain name (end with a dot)."
msgstr ""
"דומיין תיבת הדואר של RP חייב להיות שם דומיין מוסמך לחלוטין (מסתיים בנקודה)."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:227
msgid ""
"RP mailbox local part contains invalid characters. Only characters valid in "
"email addresses are allowed."
msgstr ""
"החלק המקומי של תיבת הדואר של RP מכיל תווים לא חוקיים. מותרים רק תווים "
"החוקיים בכתובות דואר אלקטרוני."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:232
#, php-format
msgid "The mailbox domain represents the email address: %s"
msgstr "דומיין תיבת הדואר מייצג את כתובת הדואר האלקטרוני: %s"

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:236
msgid ""
"RP mailbox domain part contains underscores, which are not allowed in domain "
"names."
msgstr ""
"חלק הדומיין של תיבת הדואר של RP מכיל קווים תחתונים, שאינם מותרים בשמות "
"דומיין."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:239
msgid "RP mailbox domain must include both local part and domain sections."
msgstr "RP תיבת דואר חייב לכלול גם חלקים מקומיים ודומיינים."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:250
msgid "RP mailbox domain contains empty label."
msgstr "RP תיבת דואר מכיל תווית ריקה."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:255
msgid "RP mailbox domain label exceeds maximum length of 63 characters."
msgstr "תווית דומיין RP תיבת דואר עולה על אורך מקסימלי של 63 תווים."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:260
msgid "RP mailbox domain contains invalid characters or format."
msgstr "דומיין תיבת הדואר של RP מכיל תווים או פורמט לא חוקיים."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:266
msgid "RP mailbox domain exceeds maximum length of 253 characters."
msgstr "דומיין תיבת הדואר של RP עולה על אורך מקסימלי של 253 תווים."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:271
msgid "RP mailbox domain part is not a valid domain name."
msgstr "RP תיבת דואר חלק אינו שם דומיין תקף."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:275
msgid ""
"The mailbox domain should use the same format as the RNAME field in SOA "
"records, with @ replaced by a dot."
msgstr ""
"דומיין תיבת הדואר צריך להשתמש באותו פורמט כמו שדה RNAME ברשומות SOA, כאשר @ "
"מוחלף בנקודה."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:293
msgid ""
"Using \".\" for the TXT domain indicates no additional information TXT "
"record is available."
msgstr ""
"שימוש ב-\".\" עבור דומיין ה-TXT מציין שאין רשומת TXT זמינה עם מידע נוסף."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:299
msgid "RP TXT domain must be a fully qualified domain name (end with a dot)."
msgstr "דומיין ה-TXT של RP חייב להיות שם דומיין מוסמך לחלוטין (מסתיים בנקודה)."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:307
msgid "RP TXT domain is not a valid domain name."
msgstr "RP TXT דומיין הוא לא שם דומיין חוקי."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:314
msgid "RP TXT domain contains empty label."
msgstr "RP TXT דומיין מכיל תווית ריקה."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:319
msgid "RP TXT domain label exceeds maximum length of 63 characters."
msgstr "תווית דומיין RP TXT עולה על אורך מקסימלי של 63 תווים."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:324
msgid "RP TXT domain contains invalid characters or format."
msgstr "דומיין ה-TXT של RP מכיל תווים או פורמט לא חוקיים."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:330
msgid "RP TXT domain exceeds maximum length of 253 characters."
msgstr "RP TXT דומיין עולה על אורך מקסימלי של 253 תווים."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:334
msgid ""
"Ensure a TXT record exists at this domain name containing contact "
"information for the responsible person."
msgstr ""
"ודא כי רישום TXT קיים בשם התחום המכיל מידע ליצירת קשר עבור האדם האחראי."

#: lib/Domain/Service/DnsValidation/RPRecordValidator.php:335
#, php-format
msgid "You should create a TXT record at domain: %s"
msgstr "עליך ליצור רשומת TXT בדומיין: %s"

#: lib/Domain/Service/DnsValidation/EUI64RecordValidator.php:187
msgid ""
"This appears to be an EUI-64 address derived from an EUI-48 address "
"(contains FF-FE in the middle)."
msgstr "נראה כי מדובר בכתובת EUI-64 הנגזרת מכתובת EUI-48 (כולל FF-FE באמצע)."

#: lib/Domain/Service/DnsValidation/EUI64RecordValidator.php:191
msgid ""
"This appears to be an IPv6 interface identifier (has the universal/local bit "
"flipped compared to standard EUI-64)."
msgstr ""
"נראה כי זהו מזהה ממשק IPv6 (הביט האוניברסלי/מקומי הפוך בהשוואה ל-EUI-64 "
"התקני)."

#: lib/Domain/Service/DnsValidation/EUI64RecordValidator.php:124
msgid "Priority field for EUI64 records must be 0 or empty."
msgstr "שדה עדיפות עבור רשומות EUI64 חייב להיות 0 או ריק."

#: lib/Domain/Service/DnsValidation/EUI64RecordValidator.php:128
msgid ""
"RFC 7043 recommends against publishing EUI-64 addresses in the public DNS "
"due to potential privacy implications."
msgstr ""
"RFC 7043 ממליץ שלא לפרסם כתובות EUI-64 ב-DNS הציבורי בשל השלכות פרטיות "
"אפשריות."

#: lib/Domain/Service/DnsValidation/EUI64RecordValidator.php:151
msgid ""
"EUI64 record uses colon separators (xx:xx:xx:xx:xx:xx:xx:xx) but requires "
"hyphen separators (xx-xx-xx-xx-xx-xx-xx-xx)."
msgstr ""
"רשומת EUI64 משתמשת במפרידי נקודתיים (xx:xx:xx:xx:xx:xx:xx:xx) אך נדרשים "
"מפרידי מקף (xx-xx-xx-xx-xx-xx-xx-xx)."

#: lib/Domain/Service/DnsValidation/EUI64RecordValidator.php:154
msgid ""
"EUI64 record is missing separators. Format must be xx-xx-xx-xx-xx-xx-xx-xx "
"with hyphens between octets."
msgstr ""
"רשומת EUI64 חסרה מפרידים. הפורמט חייב להיות xx-xx-xx-xx-xx-xx-xx-xx עם מקפים "
"בין האוקטטות."

#: lib/Domain/Service/DnsValidation/EUI64RecordValidator.php:157
msgid ""
"EUI64 record appears to be in dotted format. Format must be xx-xx-xx-xx-xx-"
"xx-xx-xx."
msgstr ""
"רשומת EUI64 נראית בפורמט עם נקודות. הפורמט חייב להיות xx-xx-xx-xx-xx-xx-xx-"
"xx."

#: lib/Domain/Service/DnsValidation/EUI64RecordValidator.php:161
msgid ""
"EUI64 record must be a valid EUI-64 address in xx-xx-xx-xx-xx-xx-xx-xx "
"format (where x is a hexadecimal digit)."
msgstr ""
"רשומת EUI64 חייבת להיות כתובת EUI-64 תקפה בפורמט xx-xx-xx-xx-xx-xx-xx-xx "
"(כאשר x הוא ספרה הקסדצימלית)."

#: lib/Domain/Service/DnsValidation/EUI48RecordValidator.php:152
msgid ""
"This appears to be a multicast address (the least significant bit of the "
"first octet is set to 1)."
msgstr ""
"נראה כי זוהי כתובת multicast (הביט הפחות משמעותי של האוקטטה הראשונה מוגדר "
"ל-1)."

#: lib/Domain/Service/DnsValidation/EUI48RecordValidator.php:157
msgid ""
"This appears to be a locally administered address (the second least "
"significant bit of the first octet is set to 1)."
msgstr ""
"נראה כי זוהי כתובת מנוהלת מקומית (הביט השני הפחות משמעותי של האוקטטה הראשונה "
"מוגדר ל-1)."

#: lib/Domain/Service/DnsValidation/EUI48RecordValidator.php:162
msgid "This is the all-zeros address, which may not be valid in all contexts."
msgstr "זוהי כתובת כל האפסים, שעשויה שלא להיות תקפה בכל ההקשרים."

#: lib/Domain/Service/DnsValidation/EUI48RecordValidator.php:172
msgid "This appears to be an IANA OUI (00-00-5E) address."
msgstr "זה נראה ככתובת IANA OUI (00-00-5E)."

#: lib/Domain/Service/DnsValidation/DNAMERecordValidator.php:87
msgid ""
"This DNAME record appears to be at zone apex. According to RFC 6672, using "
"DNAME at the zone apex requires special handling for NS and related records."
msgstr ""
"ה-DNAME הזה מופיע ב- Zone Apex. על פי RFC 6672, באמצעות DNAME באזור Apex "
"דורש טיפול מיוחד עבור NS ורשומות קשורות."

#: lib/Domain/Service/DnsValidation/DNAMERecordValidator.php:93
msgid "DNAME target must be a valid fully-qualified domain name."
msgstr "יעד ה-DNAME חייב להיות שם דומיין תקף ומוסמך לחלוטין."

#: lib/Domain/Service/DnsValidation/DNAMERecordValidator.php:100
msgid "DNAME record cannot point to itself."
msgstr "רשומת DNAME אינה יכולה להצביע על עצמה."

#: lib/Domain/Service/DnsValidation/DNAMERecordValidator.php:105
msgid ""
"The DNAME target appears to be a subdomain of the owner name. This could "
"create problematic circular references when resolving subdomains."
msgstr ""
"יעד ה-DNAME נראה כתת-דומיין של שם הבעלים. הדבר עלול ליצור הפניות מעגליות "
"בעייתיות בעת פתרון תת-דומיינים."

#: lib/Domain/Service/DnsValidation/DNAMERecordValidator.php:118
msgid "Priority field for DNAME records must be 0 or empty."
msgstr "שדה עדיפות עבור רשומות DNAME חייב להיות 0 או ריק."

#: lib/Domain/Service/DnsValidation/DNAMERecordValidator.php:122
msgid ""
"According to RFC 6672, DNAME records must be unique at a given owner name "
"(singleton rule)."
msgstr ""
"על פי RFC 6672, רשומות DNAME חייבות להיות ייחודיות בשם בעלים נתון (כלל "
"ה-singleton)."

#: lib/Domain/Service/DnsValidation/DNAMERecordValidator.php:123
msgid ""
"DNAME and CNAME records MUST NOT coexist at the same owner name (RFC 6672 "
"Section 2.3)."
msgstr ""
"אסור שרשומות DNAME ו-CNAME יתקיימו יחד באותו שם בעלים (RFC 6672 סעיף 2.3)."

#: lib/Domain/Service/DnsValidation/DNAMERecordValidator.php:126
msgid ""
"DNAME records MUST NOT appear at the same owner name as NS records, unless "
"the owner name is the zone apex."
msgstr ""
"אסור שרשומות DNAME יופיעו באותו שם בעלים כמו רשומות NS, אלא אם כן שם הבעלים "
"הוא קודקוד האזור."

#: lib/Domain/Service/DnsValidation/DNAMERecordValidator.php:129
msgid ""
"DNAME creates synthetic aliases for all subdomains of its owner name. "
"Consider this carefully when planning your zone structure."
msgstr ""
"DNAME יוצר כינויים סינתטיים לכל subdomains של שם הבעלים שלו. שקול זאת "
"בזהירות בעת תכנון מבנה האזור שלך."

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:97
msgid ""
"DS records should typically be placed at delegation points, not at the zone "
"apex. Check if this is intentional."
msgstr ""
"בדרך כלל יש להציב רשומות DS בנקודות האצלה, ולא בקודקוד האזור. בדוק אם הדבר "
"נעשה בכוונה."

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:278
msgid ""
"This is a special CDS deletion record (RFC 8078) that signals the parent to "
"remove the DS record."
msgstr ""
"זוהי רשומת מחיקה מיוחדת של CDS (RFC 8078) שמאותתת להורה להסיר את רשומת ה-DS."

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:141
msgid "Priority field for DS records must be 0 or empty."
msgstr "שדה עדיפות עבור רשומות DS חייב להיות 0 או ריק."

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:165
msgid ""
"DS record must be in the format: <key-tag> <algorithm> <digest-type> <digest>"
msgstr ""
"רשומת DS חייבת להיות בפורמט: <key-tag> <algorithm> <digest-type> <digest>"

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:171
msgid "DS record must contain exactly 4 fields"
msgstr "רשומת DS חייבת להכיל בדיוק 4 שדות"

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:178
msgid "Key tag must be a number between 1 and 65535"
msgstr "תג מפתח חייב להיות מספר בין 1 ל 65535"

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:207
msgid "Algorithm must be one of: 1, 2, 3, 5, 6, 7, 8, 10, 12, 13, 14, 15, 16"
msgstr ""
"האלגוריתם חייב להיות אחד מ: 1, 2, 3, 5, 6, 7, 8, 10, 12, 13, 14, 15, 16"

#: lib/Domain/Service/DnsValidation/DNSKEYRecordValidator.php:208
#, php-format
msgid ""
"%s (algorithm %d) is a RECOMMENDED algorithm for use according to RFC 8624."
msgstr "%s (algorithm %d) הוא אלגוריתם RECOMMENDED לשימוש על פי RFC 8624."

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:216
#, php-format
msgid ""
"%s (algorithm %d) is in common use, but newer algorithms like "
"ECDSAP256SHA256 (13) or ED25519 (15) are preferred."
msgstr ""
"%s (algorithm %d) בשימוש נפוץ, אך אלגוריתמים חדשים יותר כמו ECDSAP256SHA256 "
"(13) או ED25519 (15) מועדפים."

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:218
#, php-format
msgid "%s (algorithm %d) is optional for implementation according to RFC 8624."
msgstr "%s (algorithm %d) הוא אופציונלי ליישום על פי RFC 8624."

#: lib/Domain/Service/DnsValidation/DNSKEYRecordValidator.php:212
#, php-format
msgid ""
"%s (algorithm %d) is NOT RECOMMENDED for use according to RFC 8624. Consider "
"using ECDSAP256SHA256 (13) or ED25519 (15) instead."
msgstr ""
"%s (algorithm %d) אינו מומלץ (NOT RECOMMENDED) לשימוש על פי RFC 8624. שקול "
"להשתמש ב-ECDSAP256SHA256 (13) או ב-ED25519 (15) במקום."

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:229
msgid "Digest type must be one of: 1 (SHA-1), 2 (SHA-256), 4 (SHA-384)"
msgstr "סוג ה-digest חייב להיות אחד מ: 1 (SHA-1), 2 (SHA-256), 4 (SHA-384)"

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:234
msgid ""
"SHA-1 (digest type 1) is NOT RECOMMENDED for use according to RFC 8624. "
"SHA-256 (digest type 2) is the recommended digest algorithm."
msgstr ""
"SHA-1 (digest מסוג 1) אינו מומלץ (NOT RECOMMENDED) לשימוש על פי RFC 8624. "
"SHA-256 (digest מסוג 2) הוא אלגוריתם ה-digest המומלץ."

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:236
msgid ""
"SHA-256 (digest type 2) is the RECOMMENDED digest algorithm according to RFC "
"8624."
msgstr ""
"SHA-256 (digest מסוג 2) הוא אלגוריתם ה-digest המומלץ (RECOMMENDED) על פי RFC "
"8624."

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:238
msgid ""
"SHA-384 (digest type 4) is a good choice for higher security requirements, "
"but SHA-256 (digest type 2) is sufficient for most deployments and has wider "
"support."
msgstr ""
"SHA-384 (digest מסוג 4) הוא בחירה טובה לדרישות אבטחה גבוהות יותר, אך SHA-256 "
"(digest מסוג 2) מספיק עבור רוב הפריסות ויש לו תמיכה רחבה יותר."

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:246
msgid "SHA-1 digest must be exactly 40 hexadecimal characters"
msgstr "ה-digest של SHA-1 חייב להיות בדיוק 40 תווים הקסדצימליים"

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:251
msgid "SHA-256 digest must be exactly 64 hexadecimal characters"
msgstr "ה-digest של SHA-256 חייב להיות בדיוק 64 תווים הקסדצימליים"

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:256
msgid "SHA-384 digest must be exactly 96 hexadecimal characters"
msgstr "ה-digest של SHA-384 חייב להיות בדיוק 96 תווים הקסדצימליים"

#: lib/Domain/Service/DnsValidation/DSRecordValidator.php:262
msgid ""
"DS records establish a chain of trust from parent to child zones. The parent "
"zone must have this DS record, and the child zone must have the "
"corresponding DNSKEY record."
msgstr ""
"רשומות DS יוצרות שרשרת אמון מאזור ההורה לאזורי הבן. אזור ההורה חייב לכלול את "
"רשומת ה-DS הזו, ואזור הבן חייב לכלול את רשומת ה-DNSKEY המתאימה."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:92
msgid ""
"CSYNC records should only be placed at the zone apex (RFC 7477). This record "
"may not be processed by parental agents."
msgstr ""
"רשומות CSYNC צריכות להיות ממוקמות רק בקודקוד האזור (RFC 7477). ייתכן שרשומה "
"זו לא תעובד על ידי סוכני ההורה."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:122
msgid ""
"CSYNC records require DNSSEC signing to be processed by parental agents (RFC "
"7477). Ensure your zone is properly signed with DNSSEC."
msgstr ""
"רשומות CSYNC דורשות חתימה של DNSSEC שתעובד על ידי סוכני הורים (RFC 7477). "
"ודא שהאזור שלך נחתם כראוי עם DNSSEC."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:125
msgid ""
"Only one CSYNC record should exist per zone (RFC 7477). Multiple records may "
"cause unexpected behavior."
msgstr ""
"רק רשומת CSYNC אחת צריכה להתקיים בכל אזור (RFC 7477). רשומות מרובות עלולות "
"לגרום להתנהגות בלתי צפויה."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:134
msgid ""
"No flags are set in this CSYNC record. The record may not be processed "
"immediately by parental agents."
msgstr ""
"לא הוגדרו דגלים ברשומת CSYNC הזו. ייתכן שהרשומה לא תעובד מיד על ידי סוכני "
"ההורה."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:138
msgid ""
"The \"immediate\" flag (0x0001) is not set. Parental agents may delay "
"processing this record."
msgstr ""
"הדגל \"immediate\" (0x0001) אינו מוגדר. סוכני ההורה עלולים לעכב את עיבוד "
"הרשומה הזו."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:142
msgid ""
"The \"soaminimum\" flag (0x0002) is not set. SOA serial number validation "
"may not be enforced."
msgstr ""
"הדגל \"soaminimum\" (0x0002) אינו מוגדר. ייתכן שאימות המספר הסידורי של SOA "
"לא ייאכף."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:174
msgid ""
"Invalid value for priority field. CSYNC records must have priority value of "
"0."
msgstr ""
"ערך לא חוקי בשדה העדיפות. רשומות CSYNC חייבות להיות בעלות ערך עדיפות 0."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:192
msgid ""
"Invalid SOA Serial in CSYNC record. It must be a 32-bit unsigned integer "
"(0-4294967295)."
msgstr ""
"מספר סידורי SOA לא חוקי ברשומת CSYNC. הוא חייב להיות מספר שלם לא מסומן של 32 "
"סיביות (0-4294967295)."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:197
msgid "Invalid Flags in CSYNC record. Flags must be a numeric value."
msgstr "דגלים לא חוקיים ברשומות CSYNC. דגלים חייבים להיות ערך מספרי."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:204
msgid "Invalid Flags in CSYNC record. Flags must be between 0 and 65535."
msgstr "דגלים לא חוקיים ברשומות CSYNC. דגלים חייבים להיות בין 0 ל-65535."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:213
msgid ""
"Invalid Flags in CSYNC record. Only bits 0-1 are defined (values 0-3). Valid "
"values are 0, 1, 2, or 3."
msgstr ""
"דגלים לא חוקיים ברשומות CSYNC. רק ביטים 0-1 מוגדרים (ערכים 0-3). ערכים "
"חוקיים הם 0, 1, 2 או 3."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:219
msgid ""
"CSYNC record must specify at least one record type in the Type Bit Map field."
msgstr "רשומת CSYNC חייבת לציין לפחות סוג רשומה אחד בשדה Type Bit Map."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:240
msgid "Invalid Type \""
msgstr "סוג לא חוקי \""

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:245
msgid "Type \""
msgstr "סוג \""

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:250
msgid "Duplicate type \""
msgstr "סוג כפול \""

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:258
msgid ""
"NS record synchronization requires careful consideration. Parent zones may "
"have specific NS record policies that can prevent successful synchronization."
msgstr ""
"סנכרון רשומות NS דורש שיקול דעת זהיר. לאזורי ההורה עשויה להיות מדיניות "
"ספציפית לרשומות NS שעלולה למנוע סנכרון מוצלח."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:262
msgid ""
"Note: The true wire format for CSYNC Type Bit Map follows RFC 4034 Section "
"4.1.2 format. Poweradmin uses a simplified representation with space-"
"separated record types."
msgstr ""
"הערה: פורמט החוט האמיתי של CSYNC Type Bit Map עוקב אחר הפורמט של RFC 4034 "
"סעיף 4.1.2. Poweradmin משתמשת בייצוג פשוט עם סוגי רשומות מופרדים ברווחים."

#: lib/Domain/Service/DnsValidation/CSYNCRecordValidator.php:265
msgid ""
"RFC 7477 requires an \"all or nothing\" approach to CSYNC processing. If any "
"type cannot be synchronized, no changes will be made by the parent."
msgstr ""
"RFC 7477 דורש גישה של \"הכול או כלום\" לעיבוד CSYNC. אם לא ניתן לסנכרן סוג "
"כלשהו, לא יבוצעו שינויים על ידי ההורה."

#: lib/Domain/Service/DnsValidation/EUI48RecordValidator.php:200
msgid "Priority must be 0 for EUI48 records."
msgstr "עדיפות צריכה להיות 0 עבור רשומות EUI48."

#: lib/Domain/Service/DnsValidation/EUI48RecordValidator.php:109
msgid ""
"RFC 7043 recommends against publishing EUI-48 addresses in the public DNS "
"due to potential privacy implications."
msgstr ""
"RFC 7043 ממליץ שלא לפרסם כתובות EUI-48 ב-DNS הציבורי בשל השלכות פרטיות "
"אפשריות."

#: lib/Domain/Service/DnsValidation/EUI48RecordValidator.php:132
msgid ""
"EUI48 record uses colon separators (xx:xx:xx:xx:xx:xx) but requires hyphen "
"separators (xx-xx-xx-xx-xx-xx)."
msgstr ""
"רשומת EUI48 משתמשת במפרידי נקודתיים (xx:xx:xx:xx:xx:xx) אך נדרשים מפרידי מקף "
"(xx-xx-xx-xx-xx-xx)."

#: lib/Domain/Service/DnsValidation/EUI48RecordValidator.php:135
msgid ""
"EUI48 record is missing separators. Format must be xx-xx-xx-xx-xx-xx with "
"hyphens between octets."
msgstr ""
"רשומת EUI48 חסרה מפרידים. הפורמט חייב להיות xx-xx-xx-xx-xx-xx עם מקפים בין "
"האוקטטות."

#: lib/Domain/Service/DnsValidation/EUI48RecordValidator.php:138
msgid ""
"EUI48 record appears to be in Cisco format. Format must be xx-xx-xx-xx-xx-xx."
msgstr ""
"רשומת EUI48 נראית בפורמט של Cisco. הפורמט חייב להיות xx-xx-xx-xx-xx-xx."

#: lib/Domain/Service/DnsValidation/EUI48RecordValidator.php:142
msgid ""
"EUI48 record must be a valid MAC address in xx-xx-xx-xx-xx-xx format (where "
"x is a hexadecimal digit)."
msgstr ""
"רשומת EUI48 חייבת להיות כתובת MAC תקפה בפורמט xx-xx-xx-xx-xx-xx (כאשר x הוא "
"ספרה הקסדצימלית)."

#: lib/Domain/Service/DnsValidation/EUI48RecordValidator.php:167
msgid ""
"This is the broadcast address (all-ones), which may not be valid in all "
"contexts."
msgstr "זוהי כתובת השידור (all-ones), שעשויה שלא להיות תקפה בכל ההקשרים."

#: lib/Domain/Service/DnsValidation/PTRRecordValidator.php:145
msgid ""
"The record name does not appear to be a standard reverse DNS zone name "
"(should end with .in-addr.arpa for IPv4 or .ip6.arpa for IPv6)."
msgstr ""
"שם הרשומה אינו נראה כשם תקני של אזור DNS הפוך (אמור להסתיים ב-.in-addr.arpa "
"עבור IPv4 או ב-.ip6.arpa עבור IPv6)."

#: lib/Domain/Service/DnsValidation/PTRRecordValidator.php:158
msgid ""
"Priority field for PTR records should be 0 or empty. The specified value "
"will be ignored."
msgstr ""
"שדה העדיפות עבור רשומות PTR צריך להיות 0 או ריק. המערכת תתעלם מהערך שצוין."

#: lib/Domain/Service/DnsValidation/PTRRecordValidator.php:162
msgid ""
"PTR records should have corresponding forward (A/AAAA) records to avoid "
"problems with services that check reverse DNS."
msgstr ""
"לרשומות PTR צריכות להיות רשומות קדימה (A/AAAA) מתאימות כדי למנוע בעיות עם "
"שירותים הבודקים DNS הפוך."

#: lib/Domain/Service/DnsValidation/PTRRecordValidator.php:163
msgid ""
"Email servers often require properly configured reverse DNS to accept mail "
"from your server."
msgstr ""
"שרתי דואר אלקטרוני דורשים לעתים קרובות DNS הפוך המוגדר כראוי כדי לקבל דואר "
"מהשרת שלך."

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:49
msgid "This is not a valid IPv4 address."
msgstr "זו לא כתובת IPv4 תקפה."

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:89
msgid "This is not a valid IPv6 address."
msgstr "זו לא כתובת IPv6 בתוקף."

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:98
msgid "Invalid IPv4 part in IPv4-mapped IPv6 address."
msgstr "החלק של IPv4 בכתובת IPv6 ממופת-IPv4 לא חוקי."

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:104
msgid "IPv4-compatible IPv6 addresses (::a.b.c.d) are deprecated."
msgstr "כתובות IPv6 תואמות-IPv4 (::a.b.c.d) הוצאו משימוש."

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:109
msgid "Invalid IPv6 address: more than two consecutive colons."
msgstr "כתובת IPv6 לא חוקית: יותר משתי נקודתיים רצופות."

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:118
msgid "Invalid IPv6 address: must have 8 hextets when expanded."
msgstr "כתובת IPv6 לא חוקית: חייבים להיות 8 hextets בעת ההרחבה."

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:123
msgid "Invalid IPv6 address: each hextet must be 4 hexadecimal digits."
msgstr "כתובת IPv6 לא חוקית: כל hextet חייב להיות 4 ספרות hexadecimal."

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:282
msgid "IP address list cannot be empty."
msgstr "רשימת כתובות IP לא יכולה להיות ריקה."

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:302
#, php-format
msgid "Invalid IPv6 address in %s: %s"
msgstr "כתובת IPv6 לא חוקית ב-%s: %s"

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:348
#, php-format
msgid "Invalid port number: %d (must be 1-65535)"
msgstr "מספר פורט לא חוקי: %d (חייב להיות 1-65535)"

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:333
#, php-format
msgid "Invalid server format: %s (expected IP:port or [IPv6]:port)"
msgstr "פורמט שרת לא חוקי: %s (צפוי IP:port או [IPv6]:port)"

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:343
#, php-format
msgid "Invalid IPv4 address in %s: %s"
msgstr "כתובת IPv4 לא חוקית ב-%s: %s"

#: lib/Domain/Service/DnsValidation/IPAddressValidator.php:365
#, php-format
msgid "Invalid IP address: %s"
msgstr "כתובת IP לא חוקית: %s"

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:95
msgid "Priority field for CAA records must be 0 or empty."
msgstr "שדה עדיפות עבור רשומות CAA חייב להיות 0 או ריק."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:119
msgid "CAA record must contain flags, tag, and value separated by spaces."
msgstr "רשומת CAA חייבת להכיל דגלים, תג וערך המופרדים ברווחים."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:126
msgid "CAA flags must be a number between 0 and 255."
msgstr "דגלי CAA חייבים להיות מספר בין 0 ל 255."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:135
msgid "CAA tag must only contain ASCII letters and numbers."
msgstr "תג CAA חייב לכלול רק אותיות ומספרים ASCII."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:158
#, php-format
msgid ""
"Critical flag set for unknown tag \"%s\". This may cause certificate "
"issuance failures."
msgstr ""
"דגל critical הוגדר עבור תג לא ידוע \"%s\". זה עלול לגרום לכשלים בהנפקת "
"תעודות."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:185
msgid "Empty value is not allowed. Use \";\" to disallow all CAs."
msgstr "ערך ריק אינו מותר. השתמש ב- \";\" כדי למנוע מכל ה-CAs."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:197
msgid "Invalid CA domain in issue tag."
msgstr "דומיין CA לא חוקי בתג issue."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:209
msgid "Issue tag parameters must be in key=value format."
msgstr "פרמטרים של תג issue חייבים להיות בפורמט key=value."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:214
msgid "accounturi parameter cannot be empty."
msgstr "פרמטר accounturi לא יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:223
msgid "Empty validation method specified."
msgstr "שיטת אימות ריקה שצוין."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:234
msgid "Invalid CA domain in issuewild tag."
msgstr "דומיין CA לא חוקי בתג issuewild."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:247
#, php-format
msgid "CAA iodef value must be a URL starting with %s, %s, or %s."
msgstr "ערך CAA iodef חייב להיות URL המתחיל ב-%s, %s או %s."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:258
msgid "contactemail value must be a valid email address."
msgstr "ערך contactemail חייב להיות כתובת דואר אלקטרוני תקינה."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:269
msgid ""
"contactphone value must contain only numbers, spaces, and common phone "
"number punctuation."
msgstr ""
"ערך contactphone חייב להכיל רק מספרים, רווחים וסימני פיסוק נפוצים של מספרי "
"טלפון."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:463
msgid "Value must be enclosed in double quotes."
msgstr "הערך חייב להיות מוקף במרכאות כפולות."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:309
msgid "Backslashes must precede all quotes (\") in value content."
msgstr "לוכסנים אחוריים חייבים להקדים את כל המרכאות (\") בתוכן הערך."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:315
msgid "CAA property value exceeds maximum length of 512 characters."
msgstr "ערך הנכס של CAA עולה על אורך מקסימלי של 512 תווים."

#: lib/Domain/Service/DnsValidation/CAARecordValidator.php:321
msgid "CAA property value cannot contain NUL (0) characters."
msgstr "ערך הנכס של CAA אינו יכול להכיל תווים NUL (0)."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:230
msgid "The hostname is too long."
msgstr "השם המארח ארוך מדי."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:78
msgid "Single-label hostnames are not allowed."
msgstr "שמות מארח בעלי תווית יחידה אינם מורשים."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:100
msgid "A hostname can not start or end with a dash."
msgstr "שם מארח לא יכול להתחיל או להסתיים במקף."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:104
msgid "Given hostname or one of the labels is too short or too long."
msgstr "שם המארח שניתן או אחת התוויות קצר מדי או ארוך מדי."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:128
msgid "Multiple slashes in different labels are not allowed in ARPA zones."
msgstr "לוכסנים מרובים בתוויות שונות אינם מותרים באזורי ARPA."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:138
msgid "Invalid RFC 2317 format. Use format: subnet/prefix (e.g., 0/26)."
msgstr "פורמט RFC 2317 לא חוקי. השתמש בפורמט: subnet/prefix (למשל, 0/26)."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:154
msgid "Invalid subnet number in RFC 2317 notation. Must be 0-255 for IPv4."
msgstr "מספר תת-רשת לא חוקי בסימון RFC 2317. חייב להיות 0-255 עבור IPv4."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:159
msgid ""
"Invalid subnet in RFC 2317 notation. Must be hexadecimal (0-9, a-f) for IPv6."
msgstr ""
"תת-רשת לא חוקית בסימון RFC 2317. חייבת להיות hexadecimal (0-9, a-f) עבור "
"IPv6."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:164
msgid "Invalid subnet in RFC 2317 notation. Must be numeric or hexadecimal."
msgstr "תת-רשת לא חוקית בסימון RFC 2317. חייבת להיות מספרית או hexadecimal."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:172
msgid "Invalid prefix length in RFC 2317 notation. Must be numeric."
msgstr "אורך קידומת לא חוקי בסימון RFC 2317. חייב להיות מספרי."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:184
msgid ""
"Invalid IPv4 prefix length for RFC 2317. Typically 24-32 (classless "
"delegation usually 25-31)."
msgstr ""
"אורך קידומת IPv4 לא חוקי עבור RFC 2317. בדרך כלל 24-32 (האצלה חסרת מחלקות "
"בדרך כלל 25-31)."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:193
#, php-format
msgid "Subnet %d is not aligned with prefix /%d. Should be multiple of %d."
msgstr "תת-רשת %d אינה מיושרת עם הקידומת /%d. צריכה להיות כפולה של %d."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:203
msgid "Invalid IPv6 prefix length. Must be 0-128."
msgstr "אורך קידומת IPv6 לא חוקי. חייב להיות 0-128."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:209
msgid "Invalid prefix length. Must be 0-128."
msgstr "אורך קידומת לא חוקי. חייב להיות 0-128."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:217
msgid "Given hostname has too many slashes."
msgstr "לשם המארח שניתן יש יותר מדי לוכסנים."

#: lib/Domain/Service/DnsValidation/HostnameValidator.php:223
msgid "You are using an invalid top level domain."
msgstr "אתה משתמש דומיין ברמה הגבוהה ביותר לא חוקי."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:96
#, php-format
msgid ""
"SOA record name must match the zone apex \"%s\". Leave the name field blank "
"or enter \"@\"."
msgstr ""
"שם רשומת SOA חייב להתאים לקודקוד האזור \"%s\". השאר את שדה השם ריק או הזן "
"\"@\"."

#: lib/Domain/Service/Template/ZoneTemplateRecordService.php:116
msgid "Your content field doesnt have a legit value."
msgstr "לשדה התוכן שלך אין ערך לגיטימי."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:157
msgid "SOA record must have between 1 and 7 fields."
msgstr "רשומת SOA חייבת לכלול בין 1 ל-7 שדות."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:165
#, php-format
msgid ""
"SOA contains the template placeholder %s. Use literal values; placeholders "
"are only expanded when creating a zone from a template."
msgstr ""
"ה-SOA מכיל את מציין המיקום של התבנית %s. השתמש בערכים מילוליים; מצייני מיקום "
"מורחבים רק בעת יצירת אזור מתבנית."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:175
msgid "Invalid primary nameserver in SOA record."
msgstr "שרת שמות ראשי לא חוקי ברשומת SOA."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:195
msgid ""
"Invalid email address in SOA record. Use the form \"hostmaster.example.net\" "
"(the first unescaped dot represents @)."
msgstr ""
"כתובת דואר אלקטרוני לא תקינה ברשומת SOA. השתמש בצורה "
"\"hostmaster.example.net\" (הנקודה הראשונה שאינה מנוטרלת מייצגת @)."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:206
msgid "Serial number must be numeric."
msgstr "מספר סידורי חייב להיות מספריים."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:212
msgid "Serial number must be a 32-bit unsigned integer (0 to 4294967295)."
msgstr ""
"מספר סידורי חייב להיות מספר שלם לא מסומן של 32 סיביות (0 עד 4294967295)."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:225
msgid ""
"Serial number appears to use YYYYMMDDnn format but contains an invalid date. "
"This is allowed but not recommended."
msgstr ""
"נראה שהמספר הסידורי משתמש בפורמט YYYYMMDDnn, אך מכיל תאריך לא חוקי. זה מותר "
"אבל לא מומלץ."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:239
msgid ""
"SOA record must have exactly 7 fields (primary NS, email, serial, refresh, "
"retry, expire, minimum)."
msgstr ""
"רשומת SOA חייבת לכלול בדיוק 7 שדות (primary NS, email, serial, refresh, "
"retry, expire, minimum)."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:259
#, php-format
msgid "SOA %s field must be numeric."
msgstr "שדה SOA %s חייב להיות מספרי."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:265
#, php-format
msgid "SOA %s field must be a positive integer."
msgstr "שדה SOA %s חייב להיות מספר שלם חיובי."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:273
#, php-format
msgid ""
"SOA %s value (%d) is below the RFC 2308 recommended minimum (%d). This is "
"allowed but not recommended."
msgstr ""
"ערך SOA %s (%d) נמוך מהמינימום המומלץ ב-RFC 2308 (%d). זה מותר אבל לא מומלץ."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:282
msgid ""
"SOA retry value should be less than refresh value according to RFC 2308. "
"This is allowed but not recommended."
msgstr ""
"ערך retry של SOA צריך להיות קטן מערך refresh בהתאם ל-RFC 2308. זה מותר אבל "
"לא מומלץ."

#: lib/Domain/Service/DnsValidation/SOARecordValidator.php:290
msgid ""
"SOA minimum (negative caching) value exceeds 24 hours (86400), which may be "
"excessive according to RFC 2308."
msgstr ""
"ערך המינימום של SOA (negative caching) עולה על 24 שעות (86400), אשר עשוי "
"להיות מוגזם על פי RFC 2308."

#: lib/Domain/Service/DnsValidation/RESINFORecordValidator.php:88
msgid "RESINFO record content must not be empty."
msgstr "תוכן רשומת RESINFO אינו יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/RESINFORecordValidator.php:97
msgid ""
"RESINFO record content must be one or more quoted character-strings (each up "
"to 255 bytes)."
msgstr ""
"תוכן רשומת RESINFO חייב להיות מחרוזת תווים אחת או יותר במרכאות (כל אחת עד "
"255 בתים)."

#: lib/Domain/Service/DnsValidation/RESINFORecordValidator.php:111
msgid "Priority must be 0 for RESINFO records."
msgstr "העדיפות חייבת להיות 0 עבור רשומות RESINFO."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:124
msgid ""
"SVCB record must start with a priority and target: <priority> <target> "
"[<params>...]"
msgstr ""
"רשומת SVCB חייבת להתחיל בעדיפות וביעד: <priority> <target> [<params>...]"

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:133
msgid "SVCB priority must be between 0 and 65535."
msgstr "עדיפות SVCB צריכה להיות בין 0 ל 65535."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:140
msgid "SVCB target must be either \".\" or a valid hostname."
msgstr "יעד SVCB חייב להיות \".\" או שם מארח חוקי."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:150
msgid "In Alias Mode (priority = 0), the target cannot be \".\"."
msgstr "במצב Alias (priority = 0), היעד אינו יכול להיות \".\"."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:162
msgid ""
"In Service Mode (priority > 0) with \".\" target, at least one SvcParam is "
"required."
msgstr "במצב שירות (priority > 0) עם יעד \".\", נדרש לפחות SvcParam אחד."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:218
msgid "SVCB parameters must be in key=value format separated by spaces."
msgstr "פרמטרי SVCB חייבים להיות בפורמט key=value המופרדים ברווחים."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:227
#, php-format
msgid "Unknown SVCB parameter key: \"%s\"."
msgstr "מפתח פרמטר SVCB לא ידוע: \"%s\"."

#: lib/Domain/Service/DnsValidation/SVCBRecordValidator.php:234
#, php-format
msgid "Duplicate SVCB parameter key: \"%s\". Each key can only appear once."
msgstr "מפתח פרמטר SVCB כפול: \"%s\". כל מפתח יכול להופיע רק פעם אחת."

#: lib/Domain/Service/DnsValidation/DNSViolationValidator.php:110
msgid ""
"Multiple CNAME records with the same name are not allowed. This would create "
"a DNS violation."
msgstr "מספר רשומות CNAME עם אותו שם אינן מותרות. זה ייצור הפרה של DNS."

#: lib/Domain/Service/DnsValidation/DNSViolationValidator.php:122
#, php-format
msgid ""
"A CNAME record cannot coexist with other record types for the same name. "
"Found existing %s record."
msgstr ""
"רשומת CNAME אינה יכולה להתקיים יחד עם סוגי רשומות אחרים עבור אותו שם. נמצאה "
"רשומת %s קיימת."

#: lib/Domain/Service/DnsValidation/DNSViolationValidator.php:134
msgid ""
"This record conflicts with an existing CNAME record with the same name. A "
"CNAME record cannot coexist with other record types."
msgstr ""
"רשומה זו מתנגשת עם רשומת CNAME קיימת בעלת אותו שם. רשומת CNAME אינה יכולה "
"להתקיים יחד עם סוגי רשומות אחרים."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:112
msgid ""
"The local-part hash in SMIMEA records should be a 64-character SHA-256 hex "
"hash. The format should be: SHA256(local-part)._smimecert.domain.tld"
msgstr ""
"גיבוב החלק המקומי ברשומות SMIMEA צריך להיות גיבוב SHA-256 הקסדצימלי באורך 64 "
"תווים. הפורמט צריך להיות: SHA256(local-part)._smimecert.domain.tld"

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:116
#, php-format
msgid ""
"SMIMEA record name is in the format: SHA256(local-"
"part)._smimecert.domain.tld for email addresses like %s"
msgstr ""
"שם רשומת SMIMEA הוא בפורמט: SHA256(local-part)._smimecert.domain.tld עבור "
"כתובות דוא\"ל כמו %s"

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:126
msgid ""
"This does not use the standard SMIMEA name format. SMIMEA records should "
"typically use: SHA256(local-part)._smimecert.domain.tld"
msgstr ""
"זה אינו משתמש בפורמט השם התקני של SMIMEA. רשומות SMIMEA צריכות בדרך כלל "
"להשתמש ב: SHA256(local-part)._smimecert.domain.tld"

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:150
msgid ""
"Invalid value for priority field. SMIMEA records must have priority value of "
"0."
msgstr ""
"ערך לא חוקי לשדה העדיפות. רשומות SMIMEA חייבות להיות בעלות ערך עדיפות של 0."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:154
msgid ""
"SMIMEA makes email addresses visible in DNS. Consider privacy implications "
"when publishing SMIMEA records."
msgstr ""
"SMIMEA הופכת את כתובות הדואר האלקטרוני גלויות ב- DNS. שקול את ההשלכות "
"הפרטיות בעת פרסום רשומות SMIMEA."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:178
msgid "SMIMEA record content cannot be empty."
msgstr "תוכן רישום SMIMEA לא יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:183
msgid "SMIMEA record contains invalid characters."
msgstr "רשומת SMIMEA מכילה תווים לא חוקיים."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:189
msgid ""
"SMIMEA record must contain usage, selector, matching-type, and certificate-"
"data separated by spaces."
msgstr ""
"רשומת SMIMEA חייבת להכיל usage, selector, matching-type ו-certificate-data "
"המופרדים ברווחים."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:200
msgid "SMIMEA usage field must be a number between 0 and 3."
msgstr "שדה השימוש SMIMEA חייב להיות מספר בין 0 ל 3."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:206
msgid ""
"PKIX-TA usage (0) requires the CA certificate to be in the certificate "
"validation path. Ensure this CA is publicly known and trusted."
msgstr ""
"השימוש PKIX-TA (0) דורש אישור CA להיות במסלול אימות האישור. ודא כי CA זו "
"ידועה ומוסמך בפומבי."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:208
msgid ""
"PKIX-EE usage (1) requires the end entity certificate to be validated using "
"PKIX validation rules. Ensure proper intermediate certificates are available."
msgstr ""
"שימוש PKIX-EE (1) דורש את אישור הישות הסופי להיות מאומת באמצעות חוקי אימות "
"PKIX. ודא אישורי ביניים מתאימים זמינים."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:210
msgid ""
"DANE-TA usage (2) designates this certificate as a trust anchor for "
"validating the end entity certificate. Ensure this certificate is properly "
"secured."
msgstr ""
"השימוש ב- DANE-TA (2) מגדיר תעודה זו כעוגן אמון על אימות תעודת הישות הסופית. "
"ודא כי תעודה זו מובטחת כראוי."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:212
msgid ""
"DANE-EE usage (3) is recommended as it provides the simplest deployment with "
"direct certificate usage without additional validation."
msgstr ""
"השימוש ב-DANE-EE (3) מומלץ מכיוון שהוא מספק את הפריסה הפשוטה ביותר עם שימוש "
"ישיר בתעודה ללא אימות נוסף."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:219
msgid ""
"SMIMEA selector field must be 0 (Full certificate) or 1 "
"(SubjectPublicKeyInfo)."
msgstr ""
"שדה ה-selector של SMIMEA חייב להיות 0 (תעודה מלאה) או 1 "
"(SubjectPublicKeyInfo)."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:225
msgid ""
"Selector 0 (Full certificate) means the entire certificate is matched. Using "
"selector 1 (SubjectPublicKeyInfo) is recommended as it offers more "
"flexibility for certificate renewals."
msgstr ""
"selector 0 (תעודה מלאה) פירושו שהתעודה כולה מותאמת. השימוש ב-selector 1 "
"(SubjectPublicKeyInfo) מומלץ מכיוון שהוא מציע גמישות רבה יותר לחידושי תעודה."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:227
msgid ""
"Selector 1 (SubjectPublicKeyInfo) is recommended as it allows certificate "
"renewal without SMIMEA record updates, as long as the public key stays the "
"same."
msgstr ""
"selector 1 (SubjectPublicKeyInfo) מומלץ מכיוון שהוא מאפשר חידוש תעודה ללא "
"עדכוני רשומות SMIMEA, כל עוד המפתח הציבורי נשאר אותו הדבר."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:235
msgid ""
"SMIMEA matching type field must be 0 (Exact match), 1 (SHA-256), or 2 "
"(SHA-512)."
msgstr ""
"שדה סוג ההתאמה של SMIMEA חייב להיות 0 (התאמה מדויקת), 1 (SHA-256), או 2 "
"(SHA-512)."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:241
msgid ""
"Matching type 0 (Exact match) uses raw certificate data. SHA-256 (type 1) is "
"recommended for better performance and compatibility."
msgstr ""
"סוג התאמה 0 (התאמה מדויקת) משתמש בנתוני תעודה גולמיים. SHA-256 (סוג 1) מומלץ "
"לביצועים טובים יותר ולתאימות."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:243
msgid ""
"Matching type 1 (SHA-256) provides a good balance of security and efficiency."
msgstr "סוג התאמה 1 (SHA-256) מספק איזון טוב של אבטחה ויעילות."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:245
msgid ""
"Matching type 2 (SHA-512) provides the highest security but may have "
"compatibility issues with some implementations."
msgstr ""
"התאמת סוג 2 (SHA-512) מספק את האבטחה הגבוהה ביותר, אך ייתכן שיש בעיות תאימות "
"עם כמה יישום."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:250
msgid "SMIMEA certificate data must be a hexadecimal string."
msgstr "נתוני תעודה SMIMEA חייבים להיות מחרוזת hexadecimal."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:256
msgid "SMIMEA SHA-256 certificate data must be 64 characters long."
msgstr "הנתונים של SMIMEA SHA-256 חייבים להיות 64 תווים ארוכים."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:258
msgid "SMIMEA SHA-512 certificate data must be 128 characters long."
msgstr "הנתונים של SMIMEA SHA-512 חייבים להיות 128 תווים ארוכים."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:263
msgid ""
"Recommended SMIMEA configuration is usage=3 (DANE-EE), selector=1 "
"(SubjectPublicKeyInfo), and matching-type=1 (SHA-256)."
msgstr ""
"תצורת SMIMEA המומלצת היא usage=3 (DANE-EE), selector=1 "
"(SubjectPublicKeyInfo), ו-matching-type=1 (SHA-256)."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:267
msgid ""
"WARNING: SMIMEA (RFC 8162) is currently an EXPERIMENTAL protocol and may not "
"be widely supported."
msgstr ""
"אזהרה: SMIMEA (RFC 8162) הוא כיום פרוטוקול ניסיוני, וייתכן שלא יהיה נתמך "
"באופן נרחב."

#: lib/Domain/Service/DnsValidation/SMIMEARecordValidator.php:270
msgid ""
"CRITICAL: SMIMEA records REQUIRE DNSSEC to provide security. Without DNSSEC, "
"SMIMEA offers NO security benefit."
msgstr ""
"קריטי: רשומות SMIMEA דורשות DNSSEC כדי לספק אבטחה. ללא DNSSEC, SMIMEA אינה "
"מציעה שום תועלת אבטחה."

#: lib/Domain/Service/DnsValidation/L64RecordValidator.php:108
msgid ""
"NOTE: The L64 record type is defined in RFC 6742 as an experimental "
"protocol, not a formal IETF standard."
msgstr ""
"הערה: סוג הרשומה L64 מוגדר ב-RFC 6742 כפרוטוקול ניסיוני, לא כתקן IETF רשמי."

#: lib/Domain/Service/DnsValidation/L64RecordValidator.php:109
msgid ""
"L64 records should only be used with the Identifier-Locator Network Protocol "
"(ILNP)."
msgstr ""
"רשומות L64 צריכות לשמש רק עם Identifier-Locator Network Protocol (ILNP)."

#: lib/Domain/Service/DnsValidation/L64RecordValidator.php:110
msgid ""
"An IP host that is NOT ILNPv6-capable MUST NOT have L64 records in its DNS "
"entries (RFC 6742 Section 3.2)."
msgstr ""
"למארח IP שאינו ILNPv6-capable אסור שיהיו רשומות L64 בערכי ה-DNS שלו (RFC "
"6742 סעיף 3.2)."

#: lib/Domain/Service/DnsValidation/L64RecordValidator.php:115
msgid ""
"RFC 6742 recommends very low TTL values for L64 records of mobile or "
"multihomed nodes, as locator values might change frequently."
msgstr ""
"RFC 6742 ממליץ על ערכי TTL נמוכים מאוד עבור רשומות L64 של צמתים ניידים או "
"מרובי-חיבורים, מכיוון שערכי ה-locator עשויים להשתנות לעתים קרובות."

#: lib/Domain/Service/DnsValidation/L64RecordValidator.php:124
msgid ""
"L64 records for subnetworks (using wildcard DNS entries) are typically used "
"when the named subnetwork is, was, or might become mobile (RFC 6742 Section "
"3.2)."
msgstr ""
"רשומות L64 עבור תת-רשתות (באמצעות רשומות DNS מסוג wildcard) משמשות בדרך כלל "
"כאשר תת-הרשת הנקובה היא, הייתה, או עשויה להיות ניידת (RFC 6742 סעיף 3.2)."

#: lib/Domain/Service/DnsValidation/L64RecordValidator.php:148
msgid "L64 record must contain preference and locator64 separated by space."
msgstr "רשומת L64 חייבת לכלול preference ו-locator64 המופרדים ברווח."

#: lib/Domain/Service/DnsValidation/L64RecordValidator.php:155
msgid "L64 preference must be a number between 0 and 65535."
msgstr "העדפה L64 צריכה להיות מספר בין 0 ל 65535."

#: lib/Domain/Service/DnsValidation/L64RecordValidator.php:160
msgid ""
"L64 locator must be a valid 64-bit hexadecimal IPv6 address segment "
"consisting of exactly 4 groups of hex digits (e.g., 2001:0db8:1140:1000)."
msgstr ""
"ה-locator של L64 חייב להיות מקטע כתובת IPv6 הקסדצימלי תקף של 64 סיביות, "
"המורכב מ-4 קבוצות בדיוק של ספרות hex (למשל, 2001:0db8:1140:1000)."

#: lib/Domain/Service/DnsValidation/L64RecordValidator.php:168
msgid ""
"L64 locator should not use unspecified (0000:0000:0000:0000) or all-ones "
"(ffff:ffff:ffff:ffff) addresses, as they may not be suitable for ILNP "
"locators."
msgstr ""
"ה-locator של L64 לא צריך להשתמש בכתובות לא מוגדרות (0000:0000:0000:0000) או "
"בכתובות של כולן-אחדות (ffff:ffff:ffff:ffff), מכיוון שהן עשויות לא להתאים "
"ל-locators של ILNP."

#: lib/Domain/Service/DnsValidation/L64RecordValidator.php:175
msgid "Each hexadecimal group in L64 locator must be 4 or fewer characters."
msgstr "כל קבוצה hexadecimal ב-locator של L64 חייבת להיות 4 תווים או פחות."

#: lib/Domain/Service/DnsValidation/WALLETRecordValidator.php:93
msgid "WALLET record content must not be empty."
msgstr "תוכן רשומת WALLET אינו יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/WALLETRecordValidator.php:102
msgid ""
"WALLET record content must be one or more quoted character-strings (each up "
"to 255 bytes)."
msgstr ""
"תוכן רשומת WALLET חייב להיות מחרוזת תווים אחת או יותר במרכאות (כל אחת עד 255 "
"בתים)."

#: lib/Domain/Service/DnsValidation/WALLETRecordValidator.php:108
msgid ""
"WALLET records conventionally contain a coin symbol and wallet address "
"separated by whitespace, e.g. \"BTC bc1q...\"."
msgstr ""
"רשומות WALLET מכילות באופן מקובל סמל מטבע וכתובת ארנק המופרדים ברווח, לדוגמה "
"\"BTC bc1q...\"."

#: lib/Domain/Service/DnsValidation/WALLETRecordValidator.php:122
msgid "Priority must be 0 for WALLET records."
msgstr "העדיפות חייבת להיות 0 עבור רשומות WALLET."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:80
msgid ""
"CDNSKEY records are typically published at the zone apex, not in subdomains."
msgstr "רשומות CDNSKEY מפורסמות בדרך כלל בקודקוד האזור, לא בתת-דומיינים."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:115
msgid "Priority field for CDNSKEY records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות CDNSKEY חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:119
msgid ""
"RFC 7344 recommends that if you publish a CDNSKEY record, you should also "
"publish a corresponding CDS record."
msgstr ""
"RFC 7344 ממליץ שאם אתה מפרסם רשומת CDNSKEY, עליך לפרסם גם רשומת CDS מתאימה."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:145
msgid "Invalid characters in CDNSKEY record content."
msgstr "תווים לא חוקיים בתוכן רשומת CDNSKEY."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:159
msgid ""
"Using \"0 3 0 0\" format from RFC 8078 erratum, consider using the standard "
"\"0 3 0 AA==\" format."
msgstr ""
"נעשה שימוש בפורמט \"0 3 0 0\" מתוך ה-erratum של RFC 8078, שקול להשתמש בפורמט "
"הסטנדרטי \"0 3 0 AA==\"."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:166
msgid ""
"CDNSKEY record must contain flags, protocol, algorithm and public-key "
"separated by spaces."
msgstr ""
"רשומת CDNSKEY חייבת להכיל דגלים, פרוטוקול, אלגוריתם ומפתח ציבורי המופרדים "
"ברווחים."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:173
msgid "CDNSKEY flags must be 0, 256, or 257."
msgstr "דגלי CDNSKEY חייבים להיות 0, 256 או 257."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:178
msgid ""
"Flag 257 indicates a Key Signing Key (KSK). Ensure this key is properly "
"managed according to your DNSSEC key rollover policy."
msgstr ""
"דגל 257 מציין מפתח חתימת מפתחות (KSK). ודא שמפתח זה מנוהל כראוי בהתאם "
"למדיניות החלפת מפתחות ה-DNSSEC שלך."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:183
msgid "CDNSKEY protocol must be 3."
msgstr "פרוטוקול CDNSKEY חייב להיות 3."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:189
msgid "CDNSKEY algorithm must be a number between 1 and 16."
msgstr "אלגוריתם CDNSKEY חייב להיות מספר בין 1 ל 16."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:199
msgid ""
"Algorithm 8 (RSASHA256) is being replaced with ECDSAP256SHA256 (13) due to "
"shorter key and signature size, resulting in smaller DNS packets."
msgstr ""
"Algorithm 8 (RSASHA256) מוחלפו עם ECDSAP256SHA256 (13) עקב גודל מפתח וחתימה "
"קצר יותר, וכתוצאה מכך חבילות DNS קטנות יותר."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:202
msgid ""
"Algorithm 10 (RSASHA512) is NOT RECOMMENDED for signing although it must be "
"supported for validation."
msgstr ""
"Algorithm 10 (RSASHA512) אינו מומלץ לחתימה, אם כי הוא חייב להיות נתמך עבור "
"אימות."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:213
msgid ""
"Base64 encoded data should be padded to a multiple of 4 bytes using \"=\" "
"characters."
msgstr "יש לרפד נתונים מקודדי Base64 לכפולה של 4 בתים באמצעות תווי \"=\"."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:229
msgid "CDNSKEY public key must contain only valid base64 characters."
msgstr "מפתח ציבורי CDNSKEY חייב להכיל רק תווי base64 חוקיים."

#: lib/Domain/Service/DnsValidation/CDNSKEYRecordValidator.php:235
msgid "CDNSKEY public key must be valid base64-encoded data."
msgstr "מפתח ציבורי CDNSKEY חייב להיות נתונים מקודדים ב-base64 באופן חוקי."

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:184
msgid "LUA record content cannot be empty."
msgstr "תוכן רשומת LUA לא יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:94
msgid "Invalid characters in LUA record content."
msgstr "תווים לא חוקיים בתוכן רשומת LUA."

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:113
msgid "Priority field for LUA records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות LUA חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:121
msgid ""
"WARNING: This LUA record contains potentially unsafe file or system "
"operations. These may be blocked by PowerDNS security mechanisms."
msgstr ""
"אזהרה: רשומת LUA זו מכילה פעולות קובץ או מערכת שעלולות להיות לא בטוחות. אלה "
"עשויות להיחסם על ידי מנגנוני האבטחה של PowerDNS."

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:135
msgid ""
"This LUA record uses explicit return mode (starts with semicolon). Ensure "
"your Lua script explicitly returns the appropriate value."
msgstr ""
"רשומת LUA זו משתמשת במצב החזרה מפורש (מתחילה בנקודה-פסיק). ודא שסקריפט Lua "
"שלך מחזיר במפורש את הערך המתאים."

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:149
msgid ""
"This LUA record doesn't appear to use common PowerDNS Lua functions. Make "
"sure it returns an appropriate value for the record type."
msgstr ""
"נראה שרשומת LUA זו אינה משתמשת בפונקציות Lua נפוצות של PowerDNS. ודא שהיא "
"מחזירה ערך מתאים לסוג הרשומה."

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:157
msgid ""
"WARNING: This LUA record appears to have unbalanced quotes, which may cause "
"syntax errors."
msgstr ""
"אזהרה: נראה שרשומת LUA זו מכילה מרכאות לא מאוזנות, מה שעלול לגרום לשגיאות "
"תחביר."

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:191
msgid "LUA record has mismatched parentheses. Check your syntax."
msgstr "רשומת LUA מכילה סוגריים לא תואמים. בדוק את התחביר שלך."

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:198
msgid "LUA record has mismatched braces. Check your syntax."
msgstr "רשומת LUA מכילה סוגריים מסולסלים לא תואמים. בדוק את התחביר שלך."

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:215
msgid ""
"LUA record in explicit return mode (starts with semicolon) must contain at "
"least one \"return\" statement."
msgstr ""
"רשומת LUA במצב החזרה מפורש (מתחילה בנקודה-פסיק) חייבת לכלול לפחות הצהרת "
"\"return\" אחת."

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:244
msgid ""
"LUA record in implicit return mode should be a valid function call or "
"function definition with \"function\" and \"end\" keywords."
msgstr ""
"רשומת LUA במצב החזרה משתמע צריכה להיות קריאה לפונקציה או הגדרת פונקציה חוקית "
"עם מילות המפתח \"function\" ו-\"end\"."

#: lib/Domain/Service/DnsValidation/LUARecordValidator.php:250
msgid ""
"LUA record contains potentially dangerous system access functions. These are "
"likely to be blocked by PowerDNS security restrictions."
msgstr ""
"רישום LUA מכיל פונקציות גישה למערכת מסוכנת. אלה עשויים להיות חסומים על ידי "
"הגבלות אבטחה של PowerDNS."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:120
msgid "Priority field for SSHFP records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות SSHFP חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:124
msgid ""
"SSHFP records can be generated with \"ssh-keygen -r hostname\" command on "
"systems with OpenSSH."
msgstr ""
"ניתן ליצור רשומות SSHFP באמצעות הפקודה \"ssh-keygen -r hostname\" במערכות עם "
"OpenSSH."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:127
msgid ""
"For maximum security, publish both SHA-1 and SHA-256 fingerprints for "
"compatibility, but prefer SHA-256 in clients."
msgstr ""
"עבור אבטחה מקסימלית, לפרסם הן SHA-1 ו- SHA-256 טביעות אצבע עבור תאימות, אבל "
"מעדיף SHA-256 לקוחות."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:165
msgid ""
"SSHFP record must contain algorithm, fingerprint-type and fingerprint "
"separated by spaces."
msgstr ""
"רשומת SSHFP חייבת להכיל אלגוריתם, סוג טביעת אצבע וטביעת אצבע מופרדים ברווחים."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:173
msgid ""
"SSHFP algorithm must be 1 (RSA), 2 (DSA), 3 (ECDSA), 4 (Ed25519), or 6 "
"(Ed448)."
msgstr ""
"אלגוריתם SSHFP חייב להיות 1 (RSA), 2 (DSA), 3 (ECDSA), 4 (Ed25519), או 6 "
"(Ed448)."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:181
msgid ""
"DSA keys are considered weak and are deprecated in many SSH implementations. "
"Consider using RSA, Ed25519, or Ed448 instead."
msgstr ""
"מפתחות DSA נחשבים חלשים והוצאו משימוש במימושי SSH רבים. שקול להשתמש ב-RSA, "
"Ed25519 או Ed448 במקום."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:183
msgid ""
"Ed25519 keys are recommended for good security and performance with modern "
"SSH implementations."
msgstr "Ed25519 מפתחות מומלץ עבור אבטחה טובה וביצועים עם יישום SSH מודרני."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:185
msgid ""
"Ed448 keys offer very high security but may not be supported by all SSH "
"implementations."
msgstr ""
"Ed448 מפתחות מציעים אבטחה גבוהה מאוד, אך לא ניתן לתמוך על ידי כל יישום SSH."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:190
msgid "SSHFP fingerprint type must be 1 (SHA-1) or 2 (SHA-256)."
msgstr "סוג טביעת אצבע SSHFP חייב להיות 1 (SHA-1) או 2 (SHA-256)."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:196
msgid ""
"SHA-1 fingerprints are deprecated. RFC 6594 recommends using SHA-256 "
"fingerprints (type 2) for better security."
msgstr ""
"טביעות אצבע של SHA-1 הוצאו משימוש. RFC 6594 ממליץ להשתמש בטביעות אצבע "
"SHA-256 (סוג 2) לקבלת אבטחה טובה יותר."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:198
msgid ""
"SHA-256 fingerprints are recommended by RFC 6594 and provide better security "
"than SHA-1."
msgstr ""
"טביעות אצבע של SHA-256 מומלץ על ידי RFC 6594 ולספק אבטחה טובה יותר מאשר "
"SHA-1."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:203
msgid "SSHFP fingerprint must be a hexadecimal string."
msgstr "טביעת אצבע SSHFP חייבת להיות מחרוזת הקסדצימלית."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:209
msgid "SSHFP SHA-1 fingerprint must be 40 characters long."
msgstr "טביעת אצבע SSHFP SHA-1 חייבת להיות באורך 40 תווים."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:211
msgid "SSHFP SHA-256 fingerprint must be 64 characters long."
msgstr "טביעת אצבע SSHFP SHA-256 חייבת להיות באורך 64 תווים."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:215
msgid ""
"CRITICAL: SSHFP records REQUIRE DNSSEC validation to provide any security "
"benefits. Without DNSSEC, they offer no protection against man-in-the-middle "
"attacks."
msgstr ""
"קריטי: רשומות SSHFP דורשות אימות DNSSEC כדי לספק יתרונות אבטחה כלשהם. ללא "
"DNSSEC, הן אינן מציעות הגנה מפני התקפות אדם-באמצע."

#: lib/Domain/Service/DnsValidation/SSHFPRecordValidator.php:218
msgid ""
"Configure SSH clients with \"VerifyHostKeyDNS yes\" to utilize SSHFP records "
"for server verification."
msgstr ""
"הגדר לקוחות SSH עם \"VerifyHostKeyDNS yes\" כדי לנצל רשומות SSHFP לאימות "
"השרת."

#: lib/Domain/Service/DnsValidation/MRRecordValidator.php:87
msgid "MR record name (old mailbox) cannot be empty."
msgstr "שם רשומת MR (תיבת הדואר הישנה) אינו יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/MRRecordValidator.php:93
msgid "MR record name must be a valid domain name."
msgstr "שם רישום MR חייב להיות שם דומיין חוקי."

#: lib/Domain/Service/DnsValidation/MRRecordValidator.php:102
msgid "MR record content (new mailbox) cannot be empty."
msgstr "תוכן רשומת MR (תיבת הדואר החדשה) אינו יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/MRRecordValidator.php:108
msgid "MR record content must be a valid domain name."
msgstr "תוכן רישום MR חייב להיות שם דומיין חוקי."

#: lib/Domain/Service/DnsValidation/MRRecordValidator.php:117
msgid ""
"MR record content (new mailbox) should be a fully qualified domain name (end "
"with a dot)."
msgstr ""
"תוכן רשומת MR (תיבת הדואר החדשה) צריך להיות שם דומיין מוסמך לחלוטין (מסתיים "
"בנקודה)."

#: lib/Domain/Service/DnsValidation/MRRecordValidator.php:125
msgid ""
"The new mailbox is the same as the old mailbox. MR records are intended for "
"redirecting to a different mailbox."
msgstr ""
"תיבת הדואר החדשה דומה לתיבת הדואר הישנה. רשומות MR נועדו להפניה לתיבת דואר "
"שונה."

#: lib/Domain/Service/DnsValidation/MRRecordValidator.php:138
msgid "Priority field for MR records must be 0 or empty."
msgstr "שדה עדיפות עבור רשומות MR חייב להיות 0 או ריק."

#: lib/Domain/Service/DnsValidation/MRRecordValidator.php:142
msgid ""
"MR records were marked as EXPERIMENTAL in RFC 1035 and are rarely used in "
"modern mail systems."
msgstr ""
"רשומות MR סומנו כניסיוניות (EXPERIMENTAL) ב-RFC 1035 והן משמשות לעתים רחוקות "
"במערכות דואר מודרניות."

#: lib/Domain/Service/DnsValidation/MRRecordValidator.php:143
msgid ""
"Consider using standard mail forwarding mechanisms instead of MR records."
msgstr "שקול להשתמש במנגנוני העברת דואר סטנדרטיים במקום רשומות MR."

#: lib/Domain/Service/DnsValidation/MRRecordValidator.php:144
msgid ""
"The MR record indicates that the mail user has moved from the old mailbox to "
"the new mailbox."
msgstr ""
"רשומות MR מראות כי המשתמש בדואר עבר מתיבת הדואר הישנה לתיבת הדואר החדשה."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:118
msgid "Priority field for KEY records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות KEY חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:123
msgid ""
"KEY records have been obsoleted by RFC 4034. For DNSSEC, use DNSKEY records "
"instead."
msgstr ""
"רשומות KEY הוצאו משימוש על ידי RFC 4034. עבור DNSSEC, השתמש ברשומות DNSKEY "
"במקום."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:124
msgid "KEY records may not be supported by all DNS servers and resolvers."
msgstr "רשומות KEY עשויות לא להיות נתמכות על ידי כל שרתי ה-DNS וה-resolvers."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:135
msgid ""
"Algorithm 1 (RSA/MD5) is considered cryptographically weak and should not be "
"used."
msgstr "אלגוריתם 1 (RSA/MD5) נחשב חלש מבחינה קריפטוגרפית ואין להשתמש בו."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:140
msgid ""
"For DNSSEC zone keys (flags=257, protocol=3), DNSKEY records should be used "
"instead of KEY records."
msgstr ""
"עבור מפתחות אזור DNSSEC (flags=257, protocol=3), יש להשתמש ברשומות DNSKEY "
"במקום רשומות KEY."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:169
msgid "Invalid characters in KEY record content."
msgstr "תווים לא חוקיים בתוכן רשומת KEY."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:175
msgid "KEY record must contain flags, protocol, algorithm, and public key."
msgstr "רשומת KEY חייבת להכיל דגלים, פרוטוקול, אלגוריתם ומפתח ציבורי."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:184
msgid "KEY flags must be a number between 0 and 65535."
msgstr "דגלי KEY חייבים להיות מספר בין 0 ל-65535."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:191
msgid ""
"Unusual flag value. Common values are 0 (authentication prohibited), 256 "
"(user key), or 257 (zone key)."
msgstr ""
"ערך דגל חריג. ערכים נפוצים הם 0 (אימות אסור), 256 (מפתח משתמש), או 257 (מפתח "
"אזור)."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:196
msgid "KEY protocol must be a number between 0 and 255."
msgstr "פרוטוקול KEY חייב להיות מספר בין 0 ל-255."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:202
msgid ""
"Unusual protocol value. Protocol 3 (DNSSEC) is most common for KEY records."
msgstr ""
"ערך פרוטוקול חריג. פרוטוקול 3 (DNSSEC) הוא הנפוץ ביותר עבור רשומות KEY."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:207
msgid "KEY algorithm must be a number between 0 and 255."
msgstr "אלגוריתם KEY חייב להיות מספר בין 0 ל 255."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:213
msgid ""
"Unusual algorithm value. Common values are 1 (RSA/MD5), 2 (DH), 3 (DSA), 5 "
"(RSA/SHA-1), 8 (RSA/SHA-256)."
msgstr ""
"ערך אלגוריתם חריג. ערכים נפוצים הם 1 (RSA/MD5), 2 (DH), 3 (DSA), 5 (RSA/"
"SHA-1), 8 (RSA/SHA-256)."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:218
msgid "KEY public key is required."
msgstr "נדרש מפתח ציבורי של KEY."

#: lib/Domain/Service/DnsValidation/KEYRecordValidator.php:225
msgid "KEY public key must be properly Base64 encoded."
msgstr "המפתח הציבורי של KEY חייב להיות מקודד כראוי ב-Base64."

#: lib/Domain/Service/DnsValidation/BRIDRecordValidator.php:54
msgid "BRID record content must be a non-empty base64-encoded blob."
msgstr "תוכן רשומת BRID חייב להיות בלוב מקודד base64 שאינו ריק."

#: lib/Domain/Service/DnsValidation/BRIDRecordValidator.php:68
msgid "Priority must be 0 for BRID records."
msgstr "העדיפות חייבת להיות 0 עבור רשומות BRID."

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:74
msgid "DMARC records must be placed at _dmarc.<domain>."
msgstr "רשומות DMARC חייבות להיות ממוקמות ב-_dmarc.<domain>."

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:143
msgid ""
"Invalid value for priority field. DMARC records must have a priority value "
"of 0."
msgstr ""
"ערך לא חוקי עבור שדה העדיפות. רשומות DMARC חייבות להיות בעלות ערך עדיפות של "
"0."

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:156
msgid "DMARC record must start with \"v=DMARC1\""
msgstr "רשומת DMARC חייבת להתחיל ב-\"v=DMARC1\""

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:161
msgid ""
"DMARC record exceeds 255 character limit. For complex policies, consider "
"simplifying or using URI references."
msgstr ""
"רשומת DMARC חורגת ממגבלת 255 התווים. למדיניות מורכבת, שקול לפשט או להשתמש "
"בהפניות URI."

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:181
msgid "DMARC version tag (v) must be DMARC1"
msgstr "DMARC גירסה תג (v) חייב להיות DMARC1"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:189
msgid "DMARC policy tag (p) must be one of: none, quarantine, reject"
msgstr "תג מדיניות DMARC (p) חייב להיות אחד מ: none, quarantine, reject"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:194
msgid ""
"Using \"p=none\" provides visibility into email authentication without "
"affecting delivery. Consider a stricter policy once you've reviewed the "
"reports."
msgstr ""
"שימוש ב- \"p=none\" מספק חשיפה לאימות דואר אלקטרוני מבלי להשפיע על המשלוח. "
"שקול מדיניות קפדנית יותר לאחר שבדקת את הדוחות."

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:202
msgid ""
"DMARC subdomain policy tag (sp) must be one of: none, quarantine, reject"
msgstr ""
"תג מדיניות תת-דומיין של DMARC (sp) חייב להיות אחד מ: none, quarantine, reject"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:209
msgid "DMARC DKIM alignment tag (adkim) must be r (relaxed) or s (strict)"
msgstr "תג יישור DKIM של DMARC (adkim) חייב להיות r (relaxed) או s (strict)"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:216
msgid "DMARC SPF alignment tag (aspf) must be r (relaxed) or s (strict)"
msgstr "תג יישור SPF של DMARC (aspf) חייב להיות r (relaxed) או s (strict)"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:223
msgid "DMARC percentage tag (pct) must be between 0 and 100"
msgstr "תג אחוז של DMARC (pct) חייב להיות בין 0 ל-100"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:228
#, php-format
msgid ""
"DMARC policy is applied to only %d%% of messages. This should only be used "
"during policy rollout."
msgstr ""
"מדיניות DMARC מוחלת רק על %d%% מההודעות. יש להשתמש בכך רק במהלך הטמעת "
"המדיניות."

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:235
msgid "DMARC reporting interval tag (ri) must be a positive integer"
msgstr "תג מרווח הדיווח של DMARC (ri) חייב להיות מספר שלם חיובי"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:242
msgid ""
"DMARC failure reporting options tag (fo) must contain only 0, 1, d, s, or "
"colon-separated combinations"
msgstr ""
"תג אפשרויות דיווח הכשלים של DMARC (fo) חייב להכיל רק 0, 1, d, s, או שילובים "
"מופרדים בנקודתיים"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:252
#, php-format
msgid "DMARC %s tag must contain valid mailto: or https: URIs"
msgstr "תג DMARC %s חייב להכיל כתובות URI חוקיות של mailto: או https:"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:263
#, php-format
msgid "Invalid email address in DMARC %s tag: %s"
msgstr "כתובת דואר אלקטרוני לא חוקית בתג DMARC %s: %s"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:273
msgid "DMARC report format tag (rf) must be afrf or iodef"
msgstr "תג פורמט הדיווח של DMARC (rf) חייב להיות afrf או iodef"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:279
#, php-format
msgid "Unknown DMARC tag: %s"
msgstr "תג DMARC לא ידוע: %s"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:287
#, php-format
msgid "Required DMARC tag missing: %s"
msgstr "חסר תג DMARC נדרש: %s"

#: lib/Domain/Service/DnsValidation/DMARCRecordValidator.php:293
msgid ""
"DMARC record does not specify any reporting URIs (rua or ruf). This may "
"limit your ability to monitor authentication results."
msgstr ""
"רשומת DMARC אינה מציינת כתובות URI כלשהן לדיווח (rua או ruf). הדבר עלול "
"להגביל את יכולתך לנטר תוצאות אימות."

#: lib/Domain/Service/DnsValidation/TXTRecordValidator.php:105
msgid ""
"This is a DMARC record being processed through TXT record type. DMARC "
"records should use TXT record type with content starting with \"v=DMARC1\"."
msgstr ""
"זוהי רשומת DMARC המעובדת באמצעות סוג הרשומה TXT. רשומות DMARC צריכות להשתמש "
"בסוג הרשומה TXT עם תוכן שמתחיל ב-\"v=DMARC1\"."

#: lib/Domain/Service/DnsValidation/TXTRecordValidator.php:177
msgid "TXT record content must be enclosed in quotes."
msgstr "תוכן רשומת TXT חייב להיות מוקף במרכאות."

#: lib/Domain/Service/DnsValidation/StringValidator.php:80
msgid "Backslashes must precede all quotes (\") in TXT content"
msgstr "לוכסנים הפוכים חייבים להקדים את כל המרכאות (\") בתוכן TXT"

#: lib/Domain/Service/DnsValidation/TXTRecordValidator.php:193
#, php-format
msgid ""
"TXT record content exceeds maximum length of %d bytes. Please reduce the "
"content size."
msgstr ""
"תוכן רשומת TXT חורג מהאורך המרבי של %d בייטים. נא להקטין את גודל התוכן."

#: lib/Domain/Service/DnsValidation/TXTRecordValidator.php:214
msgid ""
"Each TXT record string must be 255 bytes or less. Split long content into "
"multiple strings."
msgstr ""
"כל מחרוזת ברשומת TXT חייבת להיות 255 בייטים או פחות. פצל תוכן ארוך למספר "
"מחרוזות."

#: lib/Domain/Service/DnsValidation/TXTRecordValidator.php:223
#, php-format
msgid ""
"Total TXT record content exceeds maximum length of %d bytes. Please reduce "
"the content size."
msgstr ""
"סך תוכן רשומת TXT חורג מהאורך המרבי של %d בייטים. נא להקטין את גודל התוכן."

#: lib/Domain/Service/DnsValidation/TXTRecordValidator.php:282
msgid ""
"Invalid value for priority field. TXT records must have priority value of 0."
msgstr ""
"ערך לא חוקי עבור שדה העדיפות. רשומות TXT חייבות להיות בעלות ערך עדיפות של 0."

#: lib/Domain/Service/DnsValidation/ARecordValidator.php:74
msgid "Invalid IPv4 address format."
msgstr "פורמט כתובת IPv4 לא חוקי."

#: lib/Domain/Service/DnsValidation/ARecordValidator.php:132
msgid ""
"Invalid value for priority field. A records must have priority value of 0."
msgstr ""
"ערך לא חוקי עבור שדה העדיפות. רשומות A חייבות להיות בעלות ערך עדיפות של 0."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:89
msgid ""
"CDS records should only be placed at the zone apex, not on subdomains, as "
"required by RFC 7344."
msgstr ""
"רשומות CDS צריך רק להיות ממוקם באזור apex, לא על subdomains, כפי שנדרש על "
"ידי RFC 7344."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:113
msgid "Priority field for CDS records must be 0 or empty"
msgstr "שדה עדיפות עבור רשומות CDS חייב להיות 0 או ריק"

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:117
msgid ""
"According to RFC 8078, CDS records should be stable for some time before "
"parent zones accept them."
msgstr ""
"על פי RFC 8078, רשומות CDS צריכות להיות יציבות למשך זמן מה לפני שאזורי ההורה "
"יקבלו אותן."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:141
msgid "Invalid characters in CDS record content."
msgstr "תווים לא חוקיים בתוכן רשומת CDS."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:148
msgid ""
"This is a CDS deletion record as defined in RFC 8078. It signals that the "
"corresponding DS records should be removed from the parent."
msgstr ""
"זוהי רשומת מחיקה של CDS כפי שמוגדר ב-RFC 8078. היא מסמנת שיש להסיר את רשומות "
"ה-DS המתאימות מההורה."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:155
msgid ""
"CDS record must contain key-tag, algorithm, digest-type and digest separated "
"by spaces."
msgstr ""
"רשומת CDS חייבת להכיל key-tag, אלגוריתם, digest-type ו-digest מופרדים "
"ברווחים."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:163
msgid "CDS key tag must be a number between 0 and 65535."
msgstr "תג מפתח CDS חייב להיות מספר בין 0 ל 65535."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:169
msgid "CDS algorithm must be a number between 1 and 16."
msgstr "אלגוריתם CDS חייב להיות מספר בין 1 ל 16."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:205
msgid "CDS digest type must be 1 (SHA-1), 2 (SHA-256), or 4 (SHA-384)."
msgstr "סוג ה-digest של CDS חייב להיות 1 (SHA-1), 2 (SHA-256), או 4 (SHA-384)."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:210
msgid ""
"SHA-1 (digest type 1) is deprecated for security reasons. Consider using "
"SHA-256 (digest type 2) or SHA-384 (digest type 4) instead."
msgstr ""
"SHA-1 (digest type 1) הוצא משימוש מטעמי אבטחה. מומלץ להשתמש ב-SHA-256 "
"(digest type 2) או SHA-384 (digest type 4) במקום זאת."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:231
#, php-format
msgid ""
"CDS digest must be a valid hex string of length %d for the selected digest "
"type."
msgstr ""
"ה-digest של CDS חייב להיות מחרוזת hex חוקית באורך %d עבור סוג ה-digest שנבחר."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:235
msgid ""
"CDS records must be accompanied by matching CDNSKEY records as recommended "
"by RFC 7344."
msgstr ""
"רשומות CDS חייב להיות מלווה על ידי התאמת רשומות CDNSKEY כפי מומלץ על ידי RFC "
"7344."

#: lib/Domain/Service/DnsValidation/CDSRecordValidator.php:236
msgid "CDS records should only be placed at the zone apex (not on subdomains)."
msgstr "רשומות CDS צריך רק להיות ממוקם באזור apex (לא על subdomains)."

#: lib/Domain/Service/DnsValidation/L32RecordValidator.php:108
msgid ""
"NOTE: The L32 record type is defined in RFC 6742 as an experimental "
"protocol, not a formal IETF standard."
msgstr ""
"הערה: סוג הרשומה L32 מוגדר ב-RFC 6742 כפרוטוקול ניסיוני, לא כתקן IETF רשמי."

#: lib/Domain/Service/DnsValidation/L32RecordValidator.php:109
msgid ""
"L32 records should only be used with the Identifier-Locator Network Protocol "
"(ILNP)."
msgstr "יש להשתמש ברשומות L32 רק עם פרוטוקול הרשת Identifier-Locator (ILNP)."

#: lib/Domain/Service/DnsValidation/L32RecordValidator.php:122
msgid ""
"Using private IP addresses (RFC 1918) as L32 locators may limit reachability "
"in ILNP deployments."
msgstr ""
"באמצעות כתובות IP פרטיות (RFC 1918) כאתרי L32 עשויים להגביל את יכולת ההגעה "
"בפריסות ILNP."

#: lib/Domain/Service/DnsValidation/L32RecordValidator.php:127
msgid ""
"RFC 6742 recommends very low TTL values for L32 records of mobile or "
"multihomed nodes, as locator values might change frequently."
msgstr ""
"RFC 6742 ממליץ על ערכי TTL נמוכים מאוד עבור רשומות L32 של צמתים ניידים או "
"רבודה, כפי שערכי איתור עשויים להשתנות לעתים קרובות."

#: lib/Domain/Service/DnsValidation/L32RecordValidator.php:151
msgid "L32 record must contain preference and locator separated by space."
msgstr "רשומת L32 חייבת להכיל העדפה ומאתר (locator) מופרדים ברווח."

#: lib/Domain/Service/DnsValidation/L32RecordValidator.php:158
msgid "L32 preference must be a number between 0 and 65535."
msgstr "העדפה L32 צריכה להיות מספר בין 0 ל 65535."

#: lib/Domain/Service/DnsValidation/L32RecordValidator.php:164
msgid "L32 locator must be a valid IPv4 address."
msgstr "מאתר ה-L32 חייב להיות כתובת IPv4 חוקית."

#: lib/Domain/Service/DnsValidation/L32RecordValidator.php:170
msgid "L32 locator must be a fully specified IPv4 address."
msgstr "מאתר ה-L32 חייב להיות כתובת IPv4 מפורטת במלואה."

#: lib/Domain/Service/DnsValidation/L32RecordValidator.php:176
msgid ""
"L32 locator cannot use broadcast or unspecified addresses (0.0.0.0 or "
"255.255.255.255)."
msgstr ""
"מאתר ה-L32 אינו יכול להשתמש בכתובות broadcast או בכתובות לא מוגדרות (0.0.0.0 "
"או 255.255.255.255)."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:114
msgid ""
"Priority 0 is valid but unusual. Typically SRV records start at priority 10 "
"or higher."
msgstr ""
"עדיפות 0 היא חוקית אך יוצאת דופן. בדרך כלל רשומות SRV מתחילות בעדיפות 10 "
"ומעלה."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:238
msgid "SRV record name must be in format _service._protocol.domain"
msgstr "שם רשומת SRV חייב להיות בפורמט _service._protocol.domain"

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:247
msgid ""
"Invalid service value in SRV record. Service name must start with an "
"underscore followed by alphanumeric characters."
msgstr ""
"ערך שירות לא חוקי ברשומת SRV. שם השירות חייב להתחיל בקו תחתון ואחריו תווים "
"אלפאנומריים."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:252
msgid ""
"Invalid protocol value in SRV record. Protocol must start with an underscore "
"followed by alphanumeric characters."
msgstr ""
"ערך פרוטוקול לא חוקי ברשומת SRV. הפרוטוקול חייב להתחיל בקו תחתון ואחריו "
"תווים אלפאנומריים."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:261
#, php-format
msgid ""
"Service name \"%s\" is not in the list of well-known services. This is "
"allowed but unusual."
msgstr "שם השירות \"%s\" אינו ברשימת השירותים הידועים. זה מותר אבל יוצא דופן."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:269
#, php-format
msgid ""
"Protocol \"%s\" is not in the list of well-known protocols. Common protocols "
"are _tcp and _udp."
msgstr ""
"הפרוטוקול \"%s\" אינו ברשימת הפרוטוקולים המוכרים. פרוטוקולים נפוצים הם _tcp "
"ו-_udp."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:277
msgid "Invalid domain name in SRV record."
msgstr "שם דומיין לא חוקי ברשומת SRV."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:302
msgid ""
"SRV record content must have weight, port and target (3 fields). Priority "
"should be in the priority field."
msgstr ""
"תוכן רשומת SRV חייב לכלול משקל, פורט ויעד (3 שדות). העדיפות צריכה להיות בשדה "
"העדיפות."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:324
msgid "Invalid value for the weight field of the SRV record. Must be 0-65535."
msgstr "ערך לא חוקי עבור שדה המשקל של רשומות SRV. צריך להיות 0-65535"

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:330
msgid "Invalid value for the port field of the SRV record. Must be 0-65535."
msgstr "ערך לא חוקי עבור שדה הפורט של רשומות SRV. צריך להיות 0-65535."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:339
#, php-format
msgid ""
"Port %d differs from the standard port %d for %s service. This is allowed "
"but unusual."
msgstr "פורט %d שונה מהפורט הסטנדרטי %d עבור שירות %s. זה מותר אבל יוצא דופן."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:349
msgid "SRV target cannot be empty."
msgstr "המטרה של SRV לא יכולה להיות ריקה."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:368
msgid "When target is \".\" (no service), port and weight should both be 0."
msgstr "כאשר היעד הוא \".\" (ללא שירות), הפורט והמשקל צריכים להיות שניהם 0."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:393
msgid "Invalid SRV target."
msgstr "יעד SRV לא חוקי."

#: lib/Domain/Service/DnsValidation/SRVRecordValidator.php:416
msgid "Invalid value for the priority field of the SRV record."
msgstr "ערך לא חוקי עבור שדה העדיפות של רשומת SRV."

#: lib/Domain/Service/DnsValidation/AAAARecordValidator.php:81
msgid ""
"Unspecified (::) or loopback (::1) IPv6 addresses should not be used in AAAA "
"records."
msgstr ""
"אין להשתמש בכתובות IPv6 לא מוגדרות (::) או כתובות loopback (::1) ברשומות "
"AAAA."

#: lib/Domain/Service/DnsValidation/AAAARecordValidator.php:86
msgid ""
"Site-local IPv6 addresses (fec0::/10) are deprecated and should not be used."
msgstr "כתובות IPv6 מקומיות-אתר (fec0::/10) הוצאו משימוש ואין להשתמש בהן."

#: lib/Domain/Service/DnsValidation/AAAARecordValidator.php:143
msgid ""
"Invalid value for priority field. AAAA records must have priority value of 0."
msgstr ""
"ערך לא חוקי לשדה העדיפות. רשומות AAAA חייבות להיות בעלות ערך עדיפות של 0."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:97
msgid ""
"NSEC3 record owner names should typically be a Base32hex encoded hash "
"followed by the zone name (e.g., "
"\"B4Q3JBMLEL2C7EMPGKUDAMPIP4DI4C2L.example.com\")."
msgstr ""
"שמות הבעלים של רשומות NSEC3 צריכים בדרך כלל להיות גיבוב מקודד ב-Base32hex "
"ואחריו שם האזור (למשל, \"B4Q3JBMLEL2C7EMPGKUDAMPIP4DI4C2L.example.com\")."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:102
msgid "NSEC3 record content cannot be empty."
msgstr "תוכן רשומת NSEC3 אינו יכול להיות ריק."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:107
msgid "NSEC3 record contains invalid characters."
msgstr "רשומת NSEC3 מכילה תווים לא חוקיים."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:136
msgid ""
"According to RFC 5155 and RFC 9077, NSEC3 records should have the same TTL "
"as the SOA minimum TTL field."
msgstr ""
"על פי RFC 5155 ו RFC 9077, רשומות NSEC3 צריכות להיות אותו TTL כמו שדה TTL "
"מינימלי SOA."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:139
msgid ""
"NSEC3 records are part of DNSSEC and should only be managed alongside other "
"DNSSEC records (DNSKEY, RRSIG, etc.)."
msgstr ""
"רשומות NSEC3 הן חלק מ-DNSSEC ויש לנהל רק לצד רשומות DNSSEC אחרות (DNSKEY, "
"RRSIG וכו ')."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:140
msgid ""
"Manually editing NSEC3 records is not recommended as they are typically "
"generated automatically by DNSSEC-aware nameservers."
msgstr ""
"עריכה ידנית של רשומות NSEC3 אינה מומלצת מכיוון שהן נוצרות בדרך כלל באופן "
"אוטומטי על ידי שרתי שמות מודעי DNSSEC."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:141
msgid ""
"NSEC3 records require a corresponding NSEC3PARAM record at the zone apex to "
"indicate the NSEC3 parameters in use."
msgstr ""
"רשומות NSEC3 דורשות רשומת NSEC3PARAM מתאימה ב-apex של האזור כדי לציין את "
"פרמטרי ה-NSEC3 שבשימוש."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:201
msgid ""
"NSEC3 record must contain at least hash algorithm, flags, iterations, salt, "
"and next hashed owner name."
msgstr ""
"רשומת NSEC3 חייבת להכיל לפחות אלגוריתם גיבוב, דגלים, איטרציות, salt, ושם "
"הבעלים המגובב הבא."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:207
msgid "NSEC3 hash algorithm must be 1 (SHA-1)."
msgstr "אלגוריתם הגיבוב של NSEC3 חייב להיות 1 (SHA-1)."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:213
msgid "NSEC3 flags must be 0 or 1."
msgstr "דגלי NSEC3 חייבים להיות 0 או 1."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:225
msgid "NSEC3 iterations must be between 0 and 2500."
msgstr "מספר האיטרציות של NSEC3 חייב להיות בין 0 ל-2500."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:242
msgid "NSEC3 salt must be - (for empty) or a hexadecimal value."
msgstr "ה-salt של NSEC3 חייב להיות - (עבור ריק) או ערך הקסדצימלי."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:258
msgid ""
"NSEC3 next hashed owner name must be a valid Base32hex encoded value (using "
"characters 0-9 and A-V)."
msgstr ""
"שם הבעלים המגובב הבא של NSEC3 חייב להיות ערך תקין המקודד ב-Base32hex "
"(באמצעות התווים 0-9 ו-A-V)."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:275
msgid ""
"Type bit maps should be present to indicate which RR types exist at the "
"original owner name."
msgstr ""
"מפות הסיביות של הסוגים צריכות להיות נוכחות כדי לציין אילו סוגי RR קיימים בשם "
"הבעלים המקורי."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:349
#, php-format
msgid "NSEC3 record contains an invalid record type: %s"
msgstr "רשומת NSEC3 מכילה סוג רשומה לא חוקי: %s"

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:355
msgid ""
"RRSIG type should typically be present in NSEC3 type bit maps for DNSSEC-"
"signed zones."
msgstr ""
"סוג RRSIG צריך בדרך כלל להיות נוכח במפות הסיביות של הסוגים ב-NSEC3 עבור "
"אזורים חתומים ב-DNSSEC."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:360
msgid ""
"This NSEC3 record contains both SOA and NS types, indicating it might be for "
"a zone apex."
msgstr ""
"רשומת NSEC3 זו מכילה גם סוג SOA וגם סוג NS, מה שמצביע על כך שהיא עשויה להיות "
"עבור apex של אזור."

#: lib/Domain/Service/DnsValidation/NSEC3RecordValidator.php:363
msgid ""
"For a zone apex using NSEC3, the NSEC3PARAM type should typically be present "
"along with DNSKEY."
msgstr ""
"עבור apex אזור באמצעות NSEC3, סוג NSEC3PARAM צריך בדרך כלל להיות נוכח יחד עם "
"DNSKEY."

#: lib/Domain/Service/DnsValidation/StringValidator.php:41
msgid "Invalid characters have been used in this record."
msgstr "נעשה שימוש בתווים לא חוקיים ברשומה זו."

#: lib/Domain/Service/DnsValidation/StringValidator.php:55
msgid "You cannot use html tags for this type of record."
msgstr "אינך יכול להשתמש בתגי html עבור סוג זה של רשומה."

#: lib/Domain/Service/DnsValidation/StringValidator.php:100
msgid "Add quotes around TXT record content."
msgstr "הוסף מרכאות סביב תוכן רשומת TXT."

#: lib/Domain/Service/DnsValidation/StringValidator.php:151
msgid "Invalid domain name format."
msgstr "פורמט שם דומיין לא חוקי."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:109
msgid ""
"This appears to be an ENUM domain. NAPTR records should use E2U service "
"field and follow RFC 6116."
msgstr ""
"זה נראה כמו תחום ENUM. רשומות NAPTR צריכות להשתמש בשדה שירות E2U ולפעול לפי "
"RFC 6116."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:141
msgid ""
"Complex regexp patterns in NAPTR records can be difficult to debug and "
"maintain."
msgstr ""
"דפוסי regexp מורכבים ברשומות NAPTR יכולים להיות קשים לניפוי שגיאות ולתחזוקה."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:145
msgid ""
"This record follows RFC 3403. Be aware that some DNS servers may not fully "
"support all NAPTR features."
msgstr ""
"רשומה זו פועלת לפי RFC 3403. שים לב ששרתי DNS מסוימים עשויים שלא לתמוך באופן "
"מלא בכל תכונות NAPTR."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:176
msgid ""
"Invalid value for priority field. NAPTR records have priority within the "
"content field and must have a priority value of 0."
msgstr ""
"ערך לא חוקי לשדה העדיפות. לרשומות NAPTR יש עדיפות בתוך שדה התוכן והן חייבות "
"להיות בעלות ערך עדיפות של 0."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:195
msgid ""
"NAPTR record must contain order, preference, flags, service, regexp, and "
"replacement values."
msgstr ""
"רשומת NAPTR חייבת להכיל ערכי order, preference, flags, service, regexp "
"ו-replacement."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:202
msgid "NAPTR record order must be a number between 0 and 65535."
msgstr "ערך ה-order של רשומת NAPTR חייב להיות מספר בין 0 ל-65535."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:207
msgid "NAPTR record preference must be a number between 0 and 65535."
msgstr "העדפה לרישום NAPTR חייבת להיות מספר בין 0 ל-65535."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:213
msgid "NAPTR record flags must be a quoted string."
msgstr "דגלי רשומת NAPTR חייבים להיות מחרוזת במרכאות."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:219
msgid "NAPTR record flags must contain only A, P, S, or U."
msgstr "דגלי רשומת NAPTR חייבים להכיל רק A, P, S או U."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:231
msgid "NAPTR record service must be a quoted string."
msgstr "שירות רישום NAPTR חייב להיות מחרוזת צוטט."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:250
msgid "NAPTR record regexp must be a quoted string."
msgstr "ה-regexp של רשומת NAPTR חייב להיות מחרוזת במרכאות."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:270
msgid ""
"NAPTR record replacement must be either \".\" or a valid fully-qualified "
"domain name."
msgstr "ה-replacement של רשומת NAPTR חייב להיות \".\" או שם דומיין מלא ותקין."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:279
msgid "NAPTR record with a regexp must have \".\" as the replacement."
msgstr "רשומת NAPTR עם regexp חייבת לכלול \".\" בתור ה-replacement."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:327
msgid ""
"NAPTR service must follow the format: [protocol][+rs][+rs]... where protocol "
"and rs are separated by plus signs, each start with a letter and contain "
"only letters, digits, hyphens or colons (max 32 chars each)."
msgstr ""
"שירות NAPTR חייב לעקוב אחר הפורמט: [protocol][+rs][+rs]... שבו protocol ו-rs "
"מופרדים בסימני פלוס, כל אחד מתחיל באות ומכיל רק אותיות, ספרות, מקפים או "
"נקודתיים (מקסימום 32 תווים כל אחד)."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:358
msgid ""
"Terminal flags \"S\", \"A\", \"U\", and \"P\" should not be combined with "
"other flags."
msgstr ""
"דגלי טרמינל \"S\", \"A\", \"U\" ו-\"P\" לא צריכים להיות משולבים עם דגלים "
"אחרים."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:380
msgid "NAPTR regexp must start with a delimiter character."
msgstr "NAPTR regexp חייב להתחיל בתו מפריד (delimiter)."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:386
msgid ""
"NAPTR regexp must have the format "
"delimiter+pattern+delimiter+replacement+delimiter+flags."
msgstr ""
"NAPTR regexp חייב להיות בפורמט "
"delimiter+pattern+delimiter+replacement+delimiter+flags."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:393
msgid ""
"NAPTR regexp flags (after third delimiter) should only contain \"i\" or be "
"empty."
msgstr ""
"דגלי NAPTR regexp (לאחר השלישי דלמיטר) צריכים להכיל רק \"i\" או להיות ריקים."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:411
msgid ""
"This appears to be an ENUM NAPTR record (RFC 6116). Ensure the domain is "
"under e164.arpa or a private ENUM tree."
msgstr ""
"נראה שזוהי רשומת ENUM NAPTR (RFC 6116). ודא שהדומיין נמצא תחת e164.arpa או "
"תחת עץ ENUM פרטי."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:412
msgid "ENUM records should have the \"U\" flag to indicate URI output."
msgstr "רשומות ENUM צריך להיות דגל \"U\" כדי לציין את הפלט URI."

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:439
msgid "NAPTR regexp contains potentially dangerous pattern: "
msgstr "NAPTR regexp מכיל דפוס מסוכן פוטנציאלי: "

#: lib/Domain/Service/DnsValidation/NAPTRRecordValidator.php:446
msgid "NAPTR regexp is too long. Maximum length is 1000 characters."
msgstr "NAPTR regexp ארוך מדי. האורך המקסימלי הוא 1000 תווים."

#: lib/Domain/Service/DnsValidation/DNSKEYRecordValidator.php:92
msgid ""
"DNSKEY records are typically placed at the zone apex. This record does not "
"appear to be at a zone apex, which is unusual for DNSSEC deployments."
msgstr ""
"רשומות DNSKEY ממוקמות בדרך כלל ב-apex של האזור. נראה שרשומה זו אינה נמצאת "
"ב-apex של אזור, וזה יוצא דופן עבור פריסות DNSSEC."

#: lib/Domain/Service/DnsValidation/DNSKEYRecordValidator.php:116
msgid "Priority field for DNSKEY records must be 0 or empty."
msgstr "שדה עדיפות עבור רשומות DNSKEY חייב להיות 0 או ריק."

#: lib/Domain/Service/DnsValidation/DNSKEYRecordValidator.php:141
msgid ""
"DNSKEY record must contain flags, protocol, algorithm and public-key "
"separated by spaces."
msgstr ""
"רשומת DNSKEY חייבת להכיל דגלים, פרוטוקול, אלגוריתם ומפתח ציבורי מופרדים "
"ברווחים."

#: lib/Domain/Service/DnsValidation/DNSKEYRecordValidator.php:148
msgid "DNSKEY flags must be 0, 256, or 257."
msgstr "דגלי DNSKEY חייבים להיות 0, 256 או 257."

#: lib/Domain/Service/DnsValidation/DNSKEYRecordValidator.php:154
msgid ""
"Flag value 0 indicates this key is NOT intended for use as a zone key in "
"DNSSEC. Make sure this is intentional."
msgstr ""
"ערך הדגל 0 מציין כי מפתח זה אינו מיועד לשימוש כמפתח אזורי ב-DNSSEC. ודא שזה "
"בכוונה."

#: lib/Domain/Service/DnsValidation/DNSKEYRecordValidator.php:156
msgid ""
"Flag value 256 indicates this is a Zone Signing Key (ZSK) with Zone Key bit "
"set and SEP bit unset."
msgstr ""
"ערך הדגל 256 מציין שזהו Zone Signing Key (ZSK) כאשר סיבית Zone Key מוגדרת "
"וסיבית SEP אינה מוגדרת."

#: lib/Domain/Service/DnsValidation/DNSKEYRecordValidator.php:158
msgid ""
"Flag value 257 indicates this is a Key Signing Key (KSK) with both Zone Key "
"and SEP bits set."
msgstr ""
"ערך הדגל 257 מציין שזהו Key Signing Key (KSK) כאשר גם סיבית Zone Key וגם "
"סיבית SEP מוגדרות."

#: lib/Domain/Service/DnsValidation/DNSKEYRecordValidator.php:163
msgid "DNSKEY protocol must be 3."
msgstr "פרוטוקול DNSKEY חייב להיות 3."

#: lib/Domain/Service/DnsValidation/DNSKEYRecordValidator.php:169
msgid "DNSKEY algorithm must be a number between 1 and 16."
