msgstr "Databasens navn (vil blive brugt til Poweradmin tabeller)."

#: install/templates/step4.html.twig:170
msgid "Full path to SQLite database file"
msgstr "Fuld sti til SQLite databasefil"

#: install/templates/step4.html.twig:173
