#: install/templates/step5.html.twig:12
msgid "Now we will gather all details for the configuration itself."
msgstr "Nu vil vi samle alle detaljer til selve konfigurationen."

#: install/templates/step5.html.twig:52
msgid "Database User"
msgstr "Databasebruger"

#: install/templates/step5.html.twig:57
msgid ""
"Poweradmin keeps its own tables (users, permissions, zone metadata) in the "
"configured database even when the PowerDNS API backend is selected. These "
"credentials are for that database, not for PowerDNS."
msgstr ""
"Poweradmin opbevarer sine egne tabeller (brugere, tilladelser, zonemetadata) "
"i den konfigurerede database, selv når PowerDNS API-backend er valgt. Disse "
"loginoplysninger er til den database, ikke til PowerDNS."

#: install/templates/step5.html.twig:67
msgid ""
"Poweradmin database username with restricted access. Not for web UI login."
msgstr ""
"Poweradmin database brugernavn med begrænset adgang. Ikke for web UI login."

#: install/templates/step5.html.twig:81
msgid "The password for this username."
msgstr "Kodeordet for dette brugernavn."

#: install/templates/step5.html.twig:91
msgid "DNS Settings"
msgstr "DNS-indstillinger"

#: install/templates/step5.html.twig:95
msgid "Hostmaster"
msgstr "Hostmaster"

#: install/templates/step5.html.twig:99
msgid "Provide the DNS hostmaster"
msgstr "Angiv DNS-hostmaster"

#: install/templates/step5.html.twig:102
msgid "Default hostmaster for SOA records."
msgstr "Standard hostmaster for SOA-poster."

#: install/templates/step5.html.twig:107
msgid "Primary nameserver"
msgstr "Primær navneserver"

#: install/templates/step5.html.twig:111
msgid "Provide the primary nameserver"
msgstr "Angiv den primære navneserver"

#: install/templates/step5.html.twig:114
msgid "Primary nameserver for new zones."
msgstr "Primær navneserver for nye zoner."

#: install/templates/step5.html.twig:119
msgid "Secondary nameserver"
msgstr "Sekundær navneserver"

#: install/templates/step5.html.twig:123
msgid "Provide the secondary nameserver"
msgstr "Angiv den sekundære navneserver"

#: install/templates/step5.html.twig:126
msgid "Secondary nameserver for new zones."
msgstr "Sekundær navneserver for nye zoner."

#: install/templates/step5.html.twig:132
msgid "Tertiary Nameserver"
msgstr "Tertiær navneserver"

#: install/templates/step5.html.twig:139
msgid "Optional tertiary nameserver for new zones."
msgstr "Valgfri tertiær navneserver for nye zoner."

#: install/templates/step5.html.twig:145
msgid "Quaternary Nameserver"
msgstr "Kvaternær navneserver"

#: install/templates/step5.html.twig:152
msgid "Optional quaternary nameserver for new zones."
msgstr "Valgfri kvaternær navneserver for nye zoner."

#: install/templates/step8.html.twig:3 install/templates/step8.html.twig:8
msgid "Installation complete"
msgstr "Installation komplet"

#: install/templates/step8.html.twig:12
msgid "Installation Complete!"
msgstr "Installation færdig!"

#: install/templates/step8.html.twig:12
msgid "Congratulations! Your Poweradmin installation is now configured."
msgstr "Tillykke! Din Poweradmin installation er nu konfigureret."

#: install/templates/step8.html.twig:16
msgid "Important Security Notice:"
msgstr "Vigtig sikkerhedsmeddelelse:"

#: install/templates/step8.html.twig:16
msgid ""
"You must remove the \"install/\" directory from the Poweradmin root "
"directory."
msgstr "Du skal fjerne mappen \"install/\" fra Poweradmin-rodmappen."

#: install/templates/step8.html.twig:17
msgid ""
"Poweradmin will not function if the install directory exists, as a security "
"measure."
msgstr ""
"Poweradmin vil ikke fungere, hvis installationsmappen eksisterer, som en "
"sikkerhedsforanstaltning."

#: install/templates/step8.html.twig:22
msgid "Next Steps"
msgstr "Næste skridt"

#: install/templates/step8.html.twig:26
msgid "Remove the \"install/\" directory from your server"
msgstr "Fjern mappen \"install/\" fra din server"

#: install/templates/step8.html.twig:27
msgid ""
"Login to <a href=\"../index.php\">Poweradmin</a> using the username "
"\"admin\" and the password you set in step 4"
msgstr ""
"Log ind på <a href=\"../index.php\">Poweradmin</a> med brugernavnet "
"\"admin\" og den adgangskode, du angav i trin 4"

#: install/templates/step8.html.twig:28
msgid "Begin configuring your DNS zones and records"
msgstr "Begynd at konfigurere dine DNS-zoner og DNS-poster"

#: install/templates/step3.html.twig:3 install/templates/step3.html.twig:8
msgid "Getting Ready"
msgstr "Gør klar"

#: install/templates/step3.html.twig:13
msgid "Prerequisites"
msgstr "Forudsætninger"

#: install/templates/step3.html.twig:16
msgid "Before proceeding, ensure you have:"
msgstr "Før du går videre, skal du sikre dig, at du har:"

#: install/templates/step3.html.twig:18
msgid ""
"PowerDNS installed with database tables created (or API access configured)"
msgstr ""
"PowerDNS installeret med database tabeller oprettet (eller API adgang "
"konfigureret)"

#: install/templates/step3.html.twig:19
msgid "Database credentials (hostname, username, password)"
msgstr "Loginoplysninger til databasen (værtsnavn, brugernavn, adgangskode)"

#: install/templates/step3.html.twig:20
msgid "Permission to create tables for Poweradmin"
msgstr "Tilladelse til at oprette tabeller for Poweradmin"

#: install/templates/step3.html.twig:27
msgid "Next:"
msgstr "Næste:"

#: install/templates/step3.html.twig:27
msgid ""
"Configure database connection, create admin account, and generate "
"configuration file."
msgstr ""
"Indstil databaseforbindelse, opret admin-konto og opret konfigurationsfil."

#: install/templates/step3.html.twig:28
msgid ""
"Note: PostgreSQL and SQLite must use the same database for both PowerDNS and "
"Poweradmin."
msgstr ""
"Bemærk: PostgreSQL og SQLite skal bruge den samme database til både PowerDNS "
"og Poweradmin."

#: install/helpers/InstallStepHandler.php:194
msgid "Missing PowerDNS tables:"
msgstr "Manglende PowerDNS tabeller:"

#: install/helpers/InstallStepHandler.php:195
msgid "Poweradmin requires these PowerDNS tables to function properly."
msgstr "Poweradmin kræver disse PowerDNS-tabeller for at fungere korrekt."

#: install/helpers/InstallStepHandler.php:203
msgid "Updating database... done!"
msgstr "Opdatering af database... færdig!"

#: install/helpers/InstallStepHandler.php:225
msgid "Foreign Key Constraint Issues:"
msgstr "Problemer med fremmednøglebegrænsninger:"

#: install/helpers/InstallStepHandler.php:227
msgid ""
"The installer could not remove existing tables due to foreign key constraints"
msgstr ""
"Installationsprogrammet kunne ikke fjerne eksisterende tabeller på grund af "
"fremmednøglebegrænsninger"

#: install/helpers/InstallStepHandler.php:228
msgid ""
"This can happen during reinstallation if you have custom constraints or if "
"tables are referenced by other tables"
msgstr ""
"Dette kan ske under geninstallation, hvis du har brugerdefinerede "
"begrænsninger, eller hvis tabeller er refereret af andre tabeller"

#: install/helpers/InstallStepHandler.php:229
msgid ""
"You can try manually disabling foreign key checks before running the "
"installer:"
msgstr ""
"Du kan prøve manuelt at deaktivere fremmednøglekontrol, før du kører "
"installationsprogrammet:"

#: install/helpers/InstallStepHandler.php:242
msgid "Suggestions:"
msgstr "Forslag:"

#: install/helpers/InstallStepHandler.php:236
msgid "Make sure the SQLite database file exists"
msgstr "Sørg for at SQLite databasefilen eksisterer"

#: install/helpers/InstallStepHandler.php:237
msgid ""
"Check that the web server has read and write permissions for the database "
"file"
msgstr ""
"Kontrollér, at webserveren har læse- og skriverettigheder til databasefilen"

#: install/helpers/InstallStepHandler.php:238
msgid "Verify the full path to the database file is correct and accessible"
msgstr ""
"Kontrollér, at den fulde sti til databasefilen er korrekt og tilgængelig"

#: install/helpers/InstallStepHandler.php:244
msgid "Verify database credentials are correct"
msgstr "Kontrollér, at databaseoplysningerne er korrekte"

#: install/helpers/InstallStepHandler.php:245
msgid "Check that the database user has sufficient privileges"
msgstr "Kontroller, at databasebrugeren har tilstrækkelige privilegier"

#: install/helpers/InstallStepHandler.php:246
msgid "Ensure the database server is running and accessible"
msgstr "Sørg for at databaseserveren kører og er tilgængelig"

#: install/helpers/InstallStepHandler.php:251
msgid "Database Error"
msgstr "Databasefejl"

#: install/helpers/DatabaseHelper.php:170
#, php-format
msgid ""
"The SQLite database file %s does not exist. Please create the database file "
"before proceeding."
msgstr ""
"SQLite-databasefilen %s findes ikke. Opret databasefilen, før du går videre."

#: install/helpers/DatabaseHelper.php:178
#, php-format
msgid ""
"The SQLite database file %s is not readable. Please check file permissions."
msgstr "SQLite databasefil %s kan ikke læses. Tjek venligst filrettigheder."

#: install/helpers/DatabaseHelper.php:186
#, php-format
msgid ""
"The SQLite database file %s is not writable. Please check file permissions."
msgstr "SQLite databasefil %s er ikke skrivbar. Tjek venligst filrettigheder."

#: install/helpers/DatabaseHelper.php:198
#, php-format
msgid "Could not access the SQLite database file %s: %s"
msgstr "Kunne ikke få adgang til SQLite databasefil %s: %s"

#: install/helpers/Validators/ConfiguringDatabaseValidator.php:72
msgid "PowerDNS API URL is required when using API backend."
msgstr "PowerDNS API URL er påkrævet, når du bruger API-backend."

#: install/helpers/Validators/ConfiguringDatabaseValidator.php:75
msgid "PowerDNS API key is required when using API backend."
msgstr "PowerDNS API-nøgle er påkrævet, når du bruger API-backend."

#: install/helpers/Validators/CreateConfigurationFileValidator.php:54
msgid ""
"No configuration file found. Please create the config/settings.php file "
"before proceeding."
msgstr ""
"Ingen konfigurationsfil fundet. Opret venligst filen config/settings.php, "
"før du går videre."

#: install/helpers/Validators/PdnsDatabaseValidationTrait.php:52
msgid ""
"Separate PowerDNS databases are only supported with MySQL. For PostgreSQL "
"and SQLite, please use the same database."
msgstr ""
"Separate PowerDNS databaser er kun understøttet med MySQL. Til PostgreSQL og "
"SQLite, brug den samme database."

#: install/helpers/Validators/PdnsDatabaseValidationTrait.php:80
#, php-format
msgid ""
"Missing PowerDNS tables in database \"%s\": %s. Please ensure PowerDNS is "
"properly installed in this database."
msgstr ""
"Manglende PowerDNS-tabeller i databasen \"%s\": %s. Sørg for, at PowerDNS er "
"korrekt installeret i denne database."

#: install/helpers/Validators/PdnsDatabaseValidationTrait.php:87
#, php-format
msgid "Cannot connect to PowerDNS database \"%s\": %s"
msgstr "Kan ikke forbinde til PowerDNS-databasen \"%s\": %s"

#: install/helpers/LocaleHandler.php:92
msgid ""
"Failed to set locale. Selected locale may be unsupported on this system. "
"Please contact your administrator."
msgstr ""
"Kunne ikke angive sprogindstilling. Den valgte sprogindstilling understøttes "
"muligvis ikke på dette system. Kontakt din administrator."

