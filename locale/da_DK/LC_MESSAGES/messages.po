msgid "Before proceeding, ensure you have:"
msgstr "Før du går videre, skal du sikre dig, at du har:"

#: install/templates/step3.html.twig:18
msgid ""
"PowerDNS installed with database tables created (or API access configured)"
msgstr ""
"PowerDNS installeret med database tabeller oprettet (eller API adgang "
"konfigureret)"

#: install/templates/step3.html.twig:19
msgid "Database credentials (hostname, username, password)"
msgstr "Loginoplysninger til databasen (værtsnavn, brugernavn, adgangskode)"

#: install/templates/step3.html.twig:20
msgid "Permission to create tables for Poweradmin"
msgstr "Tilladelse til at oprette tabeller for Poweradmin"

#: install/templates/step3.html.twig:27
msgid "Next:"
msgstr "Næste:"

#: install/templates/step3.html.twig:27
msgid ""
"Configure database connection, create admin account, and generate "
"configuration file."
msgstr ""
"Indstil databaseforbindelse, opret admin-konto og opret konfigurationsfil."

#: install/templates/step3.html.twig:28
msgid ""
"Note: PostgreSQL and SQLite must use the same database for both PowerDNS and "
"Poweradmin."
msgstr ""
"Bemærk: PostgreSQL og SQLite skal bruge den samme database til både PowerDNS "
"og Poweradmin."

