msgstr "Vælg almindelige mekanismer til at tillade e-mail-afsendelse"

#: lib/Module/DnsWizard/Service/SPFWizard.php:63
msgid "MX Records"
msgstr "MX-poster"

#: lib/Module/DnsWizard/Service/SPFWizard.php:66
