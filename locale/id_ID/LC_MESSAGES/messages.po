msgstr "Gagal menghapus rekaman dari backend DNS."

#: lib/Domain/Service/Dns/DomainRecordCreator.php:77
#, php-format
msgid "There is no managed zone for domain: %s."
msgstr "Tidak ada zona yang dikelola untuk domain: %s."

#: lib/Domain/Service/Dns/DomainRecordCreator.php:95
msgid "Adding IPv6 domain records from reverse zones is not supported yet."
