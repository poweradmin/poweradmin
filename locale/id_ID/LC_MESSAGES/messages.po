#: lib/Domain/Service/Dns/RecordManager.php:272
msgid "A record with this hostname, type, and content already exists."
msgstr "Rekaman dengan nama host, tipe, dan konten ini sudah ada."

#: lib/Domain/Service/Dns/RecordManager.php:290
msgid "Failed to add record to DNS backend."
msgstr "Gagal menambahkan rekaman ke backend DNS."

#: lib/Domain/Service/Dns/RecordManager.php:448
msgid "Failed to update record in DNS backend."
msgstr "Gagal memperbarui rekaman di backend DNS."

#: lib/Domain/Service/Dns/RecordManager.php:507
