msgstr "Zona tidak ditemukan."

#: lib/Application/Controller/Record/BatchPtrRecordController.php:109
msgid "You do not have permission to add records to this zone."
msgstr "Anda tidak memiliki izin untuk menambahkan rekaman ke zona ini."

#: lib/Module/DnsWizard/Controller/DnsWizardFormController.php:79
msgid "Invalid wizard type."
msgstr "Jenis wizard tidak valid."

#: lib/Module/DnsWizard/Controller/DnsWizardFormController.php:166
msgid "Validation failed:"
msgstr "Validasi gagal:"

#: lib/Module/DnsWizard/Controller/DnsWizardFormController.php:188
msgid "Failed to generate record:"
msgstr "Gagal menghasilkan rekaman:"

#: lib/Application/Service/Record/RecordAddMessages.php:57
msgid "The record was successfully added."
msgstr "Rekaman berhasil ditambahkan."

#: lib/Module/DnsWizard/Controller/Api/DnsWizardApiController.php:353
msgid "Record created successfully"
msgstr "Rekaman berhasil dibuat"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:37
msgid "TLSA Record"
msgstr "Rekaman TLSA"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:38
msgid "TLS certificate/key authentication (DANE)"
msgstr "Autentikasi sertifikat/kunci TLS (DANE)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:49
msgid "DNSSEC Requirement"
msgstr "Persyaratan DNSSEC"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:51
msgid ""
"TLSA records require DNSSEC to be enabled for this zone. TLSA records "
"without DNSSEC will not provide security benefits and may be ignored by "
"clients."
msgstr ""
"Rekaman TLSA memerlukan DNSSEC diaktifkan untuk zona ini. Rekaman TLSA tanpa "
"DNSSEC tidak akan memberikan manfaat keamanan dan mungkin diabaikan oleh "
"klien."

#: lib/Module/DnsWizard/Service/SRVWizard.php:85
msgid "Service Configuration"
msgstr "Konfigurasi Layanan"

#: lib/Module/DnsWizard/Service/SRVWizard.php:142
msgid "Port Number"
msgstr "Nomor Port"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:64
msgid ""
"TCP/UDP port number (443 for HTTPS, 25 for SMTP, 853 for DNS-over-TLS, etc.)"
msgstr ""
"Nomor port TCP/UDP (443 untuk HTTPS, 25 untuk SMTP, 853 untuk DNS-over-TLS, "
"dll.)"

#: lib/Module/DnsWizard/Service/SRVWizard.php:107
msgid "Protocol"
msgstr "Protokol"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:73
msgid "Transmission Control Protocol - most common for HTTPS/TLS"
msgstr "Transmission Control Protocol - paling umum untuk HTTPS/TLS"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:74
msgid "User Datagram Protocol - for DTLS connections"
msgstr "User Datagram Protocol - untuk koneksi DTLS"

#: lib/Module/DnsWizard/Service/SRVWizard.php:115
msgid "Stream Control Transmission Protocol"
msgstr "Stream Control Transmission Protocol"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:77
msgid "Transport protocol for the TLS connection"
msgstr "Protokol transport untuk koneksi TLS"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:81
#: install/templates/step4.html.twig:140
msgid "Hostname"
msgstr "Nama Host"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:85
msgid ""
"Hostname for the service (leave empty for zone apex @). Record will be "
"created at _port._protocol.hostname"
msgstr ""
"Nama host untuk layanan (biarkan kosong untuk apex zona @). Rekaman akan "
"dibuat di _port._protocol.hostname"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:90
msgid "Certificate Usage"
msgstr "Penggunaan Sertifikat"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:94
msgid "Usage"
msgstr "Penggunaan"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:99
msgid "0 - CA Constraint"
msgstr "0 - Batasan CA"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:99
msgid "Certificate must chain to specified CA (PKIX-TA)"
msgstr "Sertifikat harus terhubung ke CA yang ditentukan (PKIX-TA)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:100
msgid "1 - Service Certificate"
msgstr "1 - Sertifikat Layanan"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:100
msgid "Certificate must match exactly (PKIX-EE)"
msgstr "Sertifikat harus cocok persis (PKIX-EE)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:101
msgid "2 - Trust Anchor Assertion"
msgstr "2 - Pernyataan Trust Anchor"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:101
msgid "Certificate must chain to specified anchor (DANE-TA)"
msgstr "Sertifikat harus terhubung ke anchor yang ditentukan (DANE-TA)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:102
msgid "3 - Domain-Issued Certificate"
msgstr "3 - Sertifikat Diterbitkan Domain"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:102
msgid "Certificate must match exactly, bypassing PKI (DANE-EE)"
msgstr "Sertifikat harus cocok persis, melewati PKI (DANE-EE)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:104
msgid ""
"How the certificate should be validated. Type 3 is most common for self-"
"signed or custom CAs."
msgstr ""
"Bagaimana sertifikat harus divalidasi. Tipe 3 paling umum untuk sertifikat "
"self-signed atau CA kustom."

#: lib/Module/DnsWizard/Service/DKIMWizard.php:63
msgid "Selector"
msgstr "Selektor"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:118
msgid "0 - Full Certificate"
msgstr "0 - Sertifikat Lengkap"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:118
msgid "Use the entire certificate"
msgstr "Gunakan seluruh sertifikat"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:119
msgid "1 - Public Key"
msgstr "1 - Kunci Publik"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:119
msgid "Use only the Subject Public Key Info (SPKI)"
msgstr "Gunakan hanya Subject Public Key Info (SPKI)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:121
msgid ""
"What part of the certificate to match. Type 1 (public key) survives "
"certificate renewal."
msgstr ""
"Bagian mana dari sertifikat yang dicocokkan. Tipe 1 (kunci publik) bertahan "
"saat perpanjangan sertifikat."

#: lib/Module/DnsWizard/Service/TLSAWizard.php:130
msgid "Matching Type"
msgstr "Tipe Pencocokan"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:135
msgid "0 - Exact Match"
msgstr "0 - Pencocokan Persis"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:135
msgid "Full certificate/key data (very long record)"
msgstr "Data sertifikat/kunci lengkap (rekaman sangat panjang)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:136
msgid "1 - SHA-256 Hash"
msgstr "1 - Hash SHA-256"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:136
msgid "SHA-256 hash of certificate/key"
msgstr "Hash SHA-256 dari sertifikat/kunci"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:137
msgid "2 - SHA-512 Hash"
msgstr "2 - Hash SHA-512"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:137
msgid "SHA-512 hash of certificate/key (more secure but longer)"
msgstr "Hash SHA-512 dari sertifikat/kunci (lebih aman tetapi lebih panjang)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:139
msgid ""
"How to encode the certificate data. SHA-256 (type 1) provides good balance "
"of security and length."
msgstr ""
"Cara mengenkode data sertifikat. SHA-256 (tipe 1) memberikan keseimbangan "
"baik antara keamanan dan panjang."

#: lib/Module/DnsWizard/Service/TLSAWizard.php:144
msgid "Certificate Data"
msgstr "Data Sertifikat"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:148
msgid "Certificate Association Data"
msgstr "Data Asosiasi Sertifikat"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:153
msgid ""
"Hexadecimal hash or full certificate data (depending on matching type). For "
"SHA-256: use \"openssl x509 -in cert.pem -pubkey -noout | openssl pkey "
"-pubin -outform DER | openssl dgst -sha256\""
msgstr ""
"Hash heksadesimal atau data sertifikat lengkap (tergantung tipe pencocokan). "
"Untuk SHA-256: gunakan \"openssl x509 -in cert.pem -pubkey -noout | openssl "
"pkey -pubin -outform DER | openssl dgst -sha256\""

#: lib/Module/DnsWizard/Service/SRVWizard.php:178
msgid "Record Settings"
msgstr "Pengaturan Rekaman"

#: lib/Module/DnsWizard/Service/SRVWizard.php:182
msgid "TTL (seconds)"
msgstr "TTL (detik)"

#: lib/Module/DnsWizard/Service/SRVWizard.php:187
msgid "Time to live - how long DNS resolvers should cache this record"
msgstr "Time to live - berapa lama resolver DNS harus meng-cache rekaman ini"

#: lib/Module/DnsWizard/Service/SRVWizard.php:283
msgid "Port must be between 1 and 65535"
msgstr "Port harus antara 1 dan 65535"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:225
msgid "Usage must be 0, 1, 2, or 3"
msgstr "Penggunaan harus 0, 1, 2, atau 3"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:230
msgid "Selector must be 0 or 1"
msgstr "Selector harus 0 atau 1"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:235
msgid "Matching type must be 0, 1, or 2"
msgstr "Tipe pencocokan harus 0, 1, atau 2"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:240
msgid "Certificate association data is required"
msgstr "Data asosiasi sertifikat diperlukan"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:245
msgid "Certificate data must be hexadecimal (0-9, a-f)"
msgstr "Data sertifikat harus berupa heksadesimal (0-9, a-f)"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:251
#, php-format
msgid ""
"SHA-256 hash should be 64 hexadecimal characters, got %d. Verify the hash is "
"correct."
msgstr ""
"Hash SHA-256 harus 64 karakter heksadesimal, ditemukan %d. Verifikasi hash "
"sudah benar."

#: lib/Module/DnsWizard/Service/TLSAWizard.php:255
#, php-format
msgid ""
"SHA-512 hash should be 128 hexadecimal characters, got %d. Verify the hash "
"is correct."
msgstr ""
"Hash SHA-512 harus 128 karakter heksadesimal, ditemukan %d. Verifikasi hash "
"sudah benar."

#: lib/Module/DnsWizard/Service/TLSAWizard.php:259
msgid ""
"Full certificate data seems too short. Ensure you provided the complete "
"certificate."
msgstr ""
"Data sertifikat lengkap tampaknya terlalu pendek. Pastikan Anda memberikan "
"sertifikat lengkap."

#: lib/Module/DnsWizard/Service/TLSAWizard.php:266
#: templates/default/edit.html:85 templates/default/edit.html:773
msgid "Invalid hostname format"
msgstr "Format nama host tidak valid"

#: lib/Module/DnsWizard/Service/TLSAWizard.php:270
msgid ""
"CRITICAL: TLSA records require DNSSEC to be enabled on this zone. Without "
"DNSSEC, TLSA records provide NO security benefit."
msgstr ""
"KRITIS: Rekaman TLSA memerlukan DNSSEC diaktifkan pada zona ini. Tanpa "
"DNSSEC, rekaman TLSA TIDAK memberikan manfaat keamanan."

#: lib/Module/DnsWizard/Service/DMARCWizard.php:38
msgid "DMARC Record"
msgstr "Rekaman DMARC"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:39
msgid "Email authentication policy and reporting configuration"
msgstr "Kebijakan autentikasi email dan konfigurasi pelaporan"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:50
msgid "Policy Settings"
msgstr "Pengaturan Kebijakan"

#: lib/Module/DnsWizard/Service/SPFWizard.php:127
msgid "Policy"
msgstr "Kebijakan"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:59
msgid "None (monitor only)"
msgstr "Tidak ada (hanya pemantauan)"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:59
msgid "No action taken, just collect reports for analysis"
msgstr ""
"Tidak ada tindakan yang diambil, hanya mengumpulkan laporan untuk analisis"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:74
msgid "Quarantine"
msgstr "Karantina"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:60
msgid "Treat suspicious emails as spam/junk"
msgstr "Perlakukan email mencurigakan sebagai spam/sampah"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:75
#: templates/default/change_request.html:168
msgid "Reject"
msgstr "Tolak"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:61
msgid "Block delivery of suspicious emails entirely"
msgstr "Blokir pengiriman email mencurigakan sepenuhnya"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:63
msgid "Start with \"none\" to collect data before enforcing a stricter policy."
msgstr ""
"Mulai dengan \"none\" untuk mengumpulkan data sebelum menerapkan kebijakan "
"yang lebih ketat."

#: lib/Module/DnsWizard/Service/DMARCWizard.php:67
msgid "Subdomain Policy"
msgstr "Kebijakan Subdomain"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:72
msgid "Same as domain policy"
msgstr "Sama dengan kebijakan domain"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:72
msgid "Use the same policy as the main domain"
msgstr "Gunakan kebijakan yang sama dengan domain utama"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:73
msgid "None"
msgstr "Tidak ada"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:73
msgid "Monitor only for subdomains"
msgstr "Hanya pemantauan untuk subdomain"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:74
msgid "Quarantine suspicious subdomain emails"
msgstr "Karantina email subdomain yang mencurigakan"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:75
msgid "Reject suspicious subdomain emails"
msgstr "Tolak email subdomain yang mencurigakan"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:77
msgid "Policy for emails from subdomains (e.g., mail.example.com)"
msgstr "Kebijakan untuk email dari subdomain (mis., mail.example.com)"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:81
msgid "Policy Application Percentage"
msgstr "Persentase Penerapan Kebijakan"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:87
msgid ""
"Percentage of messages to which the policy should apply (100 = all "
"messages). Use lower values during policy rollout."
msgstr ""
"Persentase pesan yang harus diterapkan kebijakan (100 = semua pesan). "
"Gunakan nilai lebih rendah selama peluncuran kebijakan."

#: lib/Module/DnsWizard/Service/DMARCWizard.php:92
msgid "Reporting Settings"
msgstr "Pengaturan Pelaporan"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:96
msgid "Aggregate Report Email"
msgstr "Email Laporan Agregat"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:100
msgid "Email address to receive daily aggregate reports"
msgstr "Alamat email untuk menerima laporan agregat harian"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:104
msgid "Forensic Report Email"
msgstr "Email Laporan Forensik"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:108
msgid ""
"Email address to receive detailed failure reports (optional, can be high "
"volume)"
msgstr ""
"Alamat email untuk menerima laporan kegagalan terperinci (opsional, bisa "
"bervolume tinggi)"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:112
msgid "Forensic Reporting Options"
msgstr "Opsi Pelaporan Forensik"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:116
msgid "Generate reports if all authentication mechanisms fail"
msgstr "Buat laporan jika semua mekanisme autentikasi gagal"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:117
msgid "Generate reports if any authentication mechanism fails"
msgstr "Buat laporan jika ada mekanisme autentikasi yang gagal"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:118
msgid "Generate reports if DKIM check fails"
msgstr "Buat laporan jika pemeriksaan DKIM gagal"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:119
msgid "Generate reports if SPF check fails"
msgstr "Buat laporan jika pemeriksaan SPF gagal"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:121
msgid ""
"When to generate forensic reports (only applies if forensic email is set)"
msgstr ""
"Kapan membuat laporan forensik (hanya berlaku jika email forensik diatur)"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:126
msgid "Alignment Settings"
msgstr "Pengaturan Alignment"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:127
msgid "Advanced settings for SPF and DKIM alignment modes"
msgstr "Pengaturan lanjutan untuk mode alignment SPF dan DKIM"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:131
msgid "DKIM Alignment Mode"
msgstr "Mode Alignment DKIM"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:147
msgid "Relaxed"
msgstr "Longgar"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:136
msgid "DKIM domain can be subdomain of From: domain"
msgstr "Domain DKIM bisa menjadi subdomain dari domain From:"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:148
msgid "Strict"
msgstr "Ketat"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:137
msgid "DKIM domain must exactly match From: domain"
msgstr "Domain DKIM harus persis cocok dengan domain From:"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:142
msgid "SPF Alignment Mode"
msgstr "Mode Alignment SPF"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:147
msgid "SPF domain can be subdomain of From: domain"
msgstr "Domain SPF bisa menjadi subdomain dari domain From:"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:148
msgid "SPF domain must exactly match From: domain"
msgstr "Domain SPF harus persis cocok dengan domain From:"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:252
msgid "Policy is required"
msgstr "Kebijakan diperlukan"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:254
msgid "Invalid policy value"
msgstr "Nilai kebijakan tidak valid"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:259
msgid "Invalid subdomain policy value"
msgstr "Nilai kebijakan subdomain tidak valid"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:266
msgid "Percentage must be between 0 and 100"
msgstr "Persentase harus antara 0 dan 100"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:268
#, php-format
msgid ""
"Policy will only apply to %d%% of messages. Use 100%% once testing is "
"complete."
msgstr ""
"Kebijakan hanya akan diterapkan pada %d%% pesan. Gunakan 100%% setelah "
"pengujian selesai."

#: lib/Module/DnsWizard/Service/DMARCWizard.php:274
msgid "Invalid aggregate report email address"
msgstr "Alamat email laporan agregat tidak valid"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:278
msgid "Invalid forensic report email address"
msgstr "Alamat email laporan forensik tidak valid"

#: lib/Module/DnsWizard/Service/DMARCWizard.php:283
msgid ""
"No reporting email addresses configured. You will not receive DMARC reports."
msgstr ""
"Tidak ada alamat email pelaporan yang dikonfigurasi. Anda tidak akan "
"menerima laporan DMARC."

#: lib/Module/DnsWizard/Service/DMARCWizard.php:296
msgid ""
"Using \"p=none\" provides monitoring only. Consider stricter policy "
"(quarantine/reject) once you've reviewed reports."
msgstr ""
"Menggunakan \"p=none\" hanya menyediakan pemantauan. Pertimbangkan kebijakan "
"yang lebih ketat (quarantine/reject) setelah Anda meninjau laporan."

#: lib/Module/DnsWizard/Service/SPFWizard.php:38
msgid "SPF Record"
msgstr "Rekaman SPF"

#: lib/Module/DnsWizard/Service/SPFWizard.php:39
msgid "Authorized mail server configuration"
msgstr "Konfigurasi server email yang diotorisasi"

#: lib/Module/DnsWizard/Service/SPFWizard.php:50
msgid "Basic Mechanisms"
msgstr "Mekanisme Dasar"

#: lib/Module/DnsWizard/Service/SPFWizard.php:51
msgid "Select common mechanisms to authorize email sending"
msgstr "Pilih mekanisme umum untuk mengotorisasi pengiriman email"

#: lib/Module/DnsWizard/Service/SPFWizard.php:55
msgid "MX Records"
msgstr "Rekaman MX"

#: lib/Module/DnsWizard/Service/SPFWizard.php:58
msgid "Authorize all servers listed in MX records for this domain"
msgstr ""
"Otorisasi semua server yang terdaftar dalam rekaman MX untuk domain ini"

#: lib/Module/DnsWizard/Service/SPFWizard.php:62
msgid "A/AAAA Records"
msgstr "Rekaman A/AAAA"

#: lib/Module/DnsWizard/Service/SPFWizard.php:65
msgid "Authorize the domain's A and AAAA records"
msgstr "Otorisasi rekaman A dan AAAA domain"

#: lib/Module/DnsWizard/Service/SPFWizard.php:70
msgid "IP Addresses"
msgstr "Alamat IP"

#: lib/Module/DnsWizard/Service/SPFWizard.php:71
msgid "Authorized IP addresses and networks (CIDR notation supported)"
msgstr "Alamat IP dan jaringan yang diotorisasi (notasi CIDR didukung)"

#: lib/Module/DnsWizard/Service/SPFWizard.php:75
msgid "IPv4 Addresses"
msgstr "Alamat IPv4"

#: lib/Module/DnsWizard/Service/SPFWizard.php:79
msgid "One IP address or network per line (e.g., 192.0.2.1 or 192.0.2.0/24)"
msgstr ""
"Satu alamat IP atau jaringan per baris (mis., 192.0.2.1 atau 192.0.2.0/24)"

#: lib/Module/DnsWizard/Service/SPFWizard.php:83
msgid "IPv6 Addresses"
msgstr "Alamat IPv6"

#: lib/Module/DnsWizard/Service/SPFWizard.php:87
msgid "One IPv6 address or network per line"
msgstr "Satu alamat IPv6 atau jaringan per baris"

#: lib/Module/DnsWizard/Service/SPFWizard.php:92
msgid "Include Mechanisms"
msgstr "Mekanisme Include"

#: lib/Module/DnsWizard/Service/SPFWizard.php:93
msgid "Include SPF records from other domains"
msgstr "Sertakan rekaman SPF dari domain lain"

#: lib/Module/DnsWizard/Service/SPFWizard.php:97
msgid "Include Domains"
msgstr "Domain Include"

#: lib/Module/DnsWizard/Service/SPFWizard.php:101
msgid ""
"Domains whose SPF records should be included (one per line). Common: "
"_spf.google.com, spf.protection.outlook.com"
msgstr ""
"Domain yang rekaman SPF-nya harus disertakan (satu per baris). Umum: "
"_spf.google.com, spf.protection.outlook.com"

#: lib/Module/DnsWizard/Service/SPFWizard.php:106
msgid "Additional Mechanisms"
msgstr "Mekanisme Tambahan"

#: lib/Module/DnsWizard/Service/SPFWizard.php:110
msgid "Additional A/AAAA Hosts"
msgstr "Host A/AAAA Tambahan"

#: lib/Module/DnsWizard/Service/SPFWizard.php:114
msgid "Authorize specific hostnames' A/AAAA records (one per line)"
msgstr "Otorisasi rekaman A/AAAA nama host tertentu (satu per baris)"

#: lib/Module/DnsWizard/Service/SPFWizard.php:118
msgid "Additional MX Hosts"
