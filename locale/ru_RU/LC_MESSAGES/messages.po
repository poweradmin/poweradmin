msgid "Error adding zone template record: "
msgstr "Ошибка при добавлении записи шаблона зоны: "

#: lib/Domain/Service/Template/ZoneTemplateRecordService.php:227
msgid "The record does not belong to this zone template."
msgstr "Запись не принадлежит этому шаблону зоны."

#: lib/Domain/Service/Template/ZoneTemplateRecordService.php:206
msgid "Error updating zone template record: "
msgstr "Ошибка обновления записи шаблона зоны: "

#: lib/Domain/Service/Template/ZoneTemplateRecordService.php:232
