#, php-format
msgid "The connected PowerDNS version cannot load %s records."
msgstr "Подключённая версия PowerDNS не может загрузить записи %s."

#: lib/Domain/Service/Template/ZoneTemplateWriteService.php:128
msgid "Zone template not found."
msgstr "Шаблон зоны не найден."

#: lib/Domain/Service/Template/ZoneTemplateWriteService.php:131
msgid "Only global zone templates can be set as the default."
msgstr "По умолчанию можно установить только глобальные шаблоны зон."

#: lib/Domain/Service/Template/ZoneTemplateWriteService.php:138
msgid "Error setting default zone template: "
msgstr "Ошибка при установке шаблона зоны по умолчанию: "

#: lib/Domain/Service/Template/ZoneTemplateWriteService.php:151
msgid "Error clearing default zone template: "
msgstr "Ошибка при очистке шаблона зоны по умолчанию: "

#: lib/Domain/Service/Template/ZoneTemplateWriteService.php:298
msgid "Error creating zone template: "
msgstr "Ошибка создания шаблона зоны: "

#: lib/Domain/Service/Template/ZoneTemplateWriteService.php:197
msgid "You do not have the permission to edit a zone template."
msgstr "У вас нет разрешения для редактирования шаблона зоны."

#: lib/Domain/Service/Template/ZoneTemplateWriteService.php:229
msgid "Error deleting zone template: "
msgstr "Ошибка удаления шаблона зоны: "

#: lib/Domain/Service/Template/ZoneTemplateWriteService.php:290
