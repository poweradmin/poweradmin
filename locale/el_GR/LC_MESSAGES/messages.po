msgid "The following warnings were found:"
msgstr "Βρέθηκαν οι ακόλουθες προειδοποιήσεις:"

#: lib/Domain/Service/BulkRecordParser.php:36
msgid "Empty line."
msgstr "Άδεια γραμμή."

#: lib/Domain/Service/BulkRecordParser.php:44
msgid "Invalid format. Expected at least: name,type,content"
msgstr "Μη έγκυρη μορφή. Αναμένεται τουλάχιστον: name,type,content"

#: lib/Domain/Service/BulkRecordParser.php:91
msgid ""
"Invalid SRV format. Use: name,SRV,\"weight port target\",priority,ttl or "
"name,SRV,target,weight,port,ttl"
msgstr ""
"Μη έγκυρη μορφή SRV. Χρήση: name,SRV,\"weight port target\",priority,ttl ή "
"name,SRV,target,weight,port,ttl"

#: lib/Domain/Service/DatabaseSchemaService.php:55
