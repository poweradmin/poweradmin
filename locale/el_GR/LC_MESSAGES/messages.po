#, php-format
msgid "Failed to create %s record for zone."
msgstr "Αποτυχία δημιουργίας εγγραφής %s για τη ζώνη."

#: lib/Domain/Service/Dns/DomainManager.php:444
#, php-format
msgid "Invalid argument(s) given to function %s"
msgstr "Μη έγκυρο(-α) όρισμα(-τα) δόθηκαν στη συνάρτηση %s"

#: lib/Domain/Service/Dns/DomainManager.php:565
msgid "Failed to delete zone from DNS backend."
msgstr "Αποτυχία διαγραφής ζώνης από το σύστημα υποστήριξης DNS."

